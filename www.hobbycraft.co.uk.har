\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"callback\", \"activationCode\": /**\n * Sample Activation Function\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-callback\n * @param {Function} activate - Call this function when you want to activate the page.\n * @param {Object} options - An object containing Page information.\n */\n\n// This is when the search bar is opened and input is started\nfunction trigger(activate, options) {\n\tconst utils = window.optimizely.get(\"utils\");\n\n\tutils.waitForElement(\"body\").then(function (body) {\n\t\tconst observer = new MutationObserver(function () {\n\t\t\tif (document.querySelector(\".b-dialog.m-search_suggestions.m-opened\")) {\n\t\t\t\tobserver.disconnect();\n\t\t\t\tactivate();\n\t\t\t}\n\t\t});\n\n\t\tobserver.observe(body, { childList: true, subtree: true, attributes: true });\n\t});\n}\n}, {\"id\": \"6156174777647104\", \"category\": \"other\", \"apiName\": \"25251511284_cc_overall_cvr\", \"name\": \"[C&C] Overall CVR\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/order-confirmation/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": function pollingFn() {\n\n  // Check if the element exists with the specific aria-label and aria-selected attributes\n  const isElementSelected = document.querySelector(\".b-order_details [aria-label='Collection Summary']\") !== null;\n\n  // Return true if all conditions are met\n  return isElementSelected;\n}\n}, {\"id\": \"6168505423233024\", \"category\": \"other\", \"apiName\": \"25251511284_plp_kids\", \"name\": \"[PLP] Main Kids Page\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/kids/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"6279181936361472\", \"category\": \"other\", \"apiName\": \"25251511284_staging_home_delivery_basket_page_view__referrer_che\", \"name\": \"[Staging] [Home Delivery] Basket Page View - Referrer Checkout\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://stg-sfcc.hobbycraft.co.uk/cart/\"}], [\"or\", {\"type\": \"custom_code\", \"value\": /**\n * Sample JavaScript Condition\n * This function is called after the page is triggered.\n * It should return true when the page is ready to activate.\n *\n * Editor now supports ES6 compliant code. Note that adding ES6\n * specific code to an experiment will break for users running\n * ES5-only browsers as code entered is not transpiled down to ES5.\n */\n\nfunction jsCondition() {\n  return document.referrer === \"https://www.hobbycraft.co.uk/checkout/?step=shipping\";\n}\n}], [\"or\", {\"type\": \"element_present\", \"value\": \"[aria-label=\\\"Home Delivery\\\"][aria-selected=\\\"true\\\"]\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"6281320028962816\", \"category\": \"other\", \"apiName\": \"25251511284_dev_homepage\", \"name\": \"[Dev] Homepage\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://dev-sfcc.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"6339782813417472\", \"category\": \"other\", \"apiName\": \"25251511284_hc087_basket__logged_in_user_with_rewards__staging_a\", \"name\": \"[HC-087] Basket - Logged in user with Rewards - Prod\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/cart/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"t