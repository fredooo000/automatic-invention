rases}}\n<div class=\"b-wrap\">\n<a\ndata-widget=\"gtmDataLayer\"\nrole=\"option\"\naria-label=\"Completion selected: Do you mean '{{value}}'\"\nid=\"result-item-{{posinset}}\"\nclass=\"b-suggestions-option\"\nhref=\"/search/?q={{value}}\"\ndata-ref=\"result-item-{{posinset}}\"\ndata-suggestion-value=\"{{value}}\"\ndata-tau=\"search_suggestions_guess\"\ndata-event-click=\"searchSuggestionClick\"\ndata-gtm-event-sublabel=\"{{value}}\"\ndata-gtm-event-label=\"{{key}}\"\n>\n<svg width=\"18\" height=\"17\" viewBox=\"0 0 18 17\">\n    <use href=\"#search\"></use>\n</svg>\n\n<span>{{{highlightedValue}}}</span>\n</a>\n</div>\n{{/phrases}}\n</div>\n</div>\n{{/phrases.length}}\n{{#products.length}}\n<div class=\"b-suggestions-section m-products {{^ideas.length}}m-one_type{{/ideas.length}}\" role=\"none\" data-tau=\"search_suggestions_products\">\n<div role=\"none\" class=\"b-suggestions-title\">\nProducts\n</div>\n<div class=\"b-suggestions-products\">\n{{#products}}\n<a\n    role=\"option\"\n    aria-label=\"Completion selected: Product Suggestions '{{productName}}'\"\n    id=\"result-item-{{posinset}}\"\n    class=\"b-suggestions-option b-suggestions_product\"\n    href=\"{{url}}\"\n    data-ref=\"result-item-{{posinset}}\"\n    data-suggestion-value=\"{{name}}\"\n    data-tau-product-id=\"{{id}}\"\n    data-event-click=\"onProductLinkClick\"\n    data-gtm-event-label=\"{{key}}\"\n    data-gtm-event-sublabel=\"{{productName}}\"\n    data-list=\"suggestions\"\n    data-analytics=\"{{#stringifyJSON}}{{gtmInfo}}{{/stringifyJSON}}\"\n>\n    {{#image}}\n        <div class=\"b-suggestions_product-picture_wrap\">\n            <picture class=\"b-suggestions_product-picture\">\n                <img\n                    src=\"{{image.url}}\"\n                    alt=\"{{image.title}}\"\n                    width=\"{{image.width}}\"\n                    height=\"{{image.height}}\"\n                    loading=\"lazy\"\n                />\n            </picture>\n        </div>\n    {{/image}}\n\n    <div class=\"b-suggestions_product-info\">\n        <h3 class=\"b-suggestions_product-title\">{{productName}}</h3>\n        <div class=\"b-price b-suggestions_product-price\">\n            {{#salesPrice}}\n                <span class=\"b-price-item\">{{{salesPrice}}}</span>\n                <span class=\"b-price-item b-suggestions_product-price_item\">\n                    {{{listPrice}}}\n                </span>\n            {{/salesPrice}}\n\n            {{^salesPrice}}\n                <span class=\"b-price-item\">{{listPrice}}</span>\n            {{/salesPrice}}\n        </div>\n\n        <svg class=\"b-rating-icon\" width=\"90\" height=\"16\" focusable=\"false\">\n    {{#ratings}}\n        {{#isFull}}\n            <use class=\"b-rating-filled\" href=\"#star\" y=\"0\" x=\"{{position}}\"/>\n        {{/isFull}}\n        {{#isHalf}}\n            <use href=\"#star-half\" y=\"0\" x=\"{{position}}\"/>\n        {{/isHalf}}\n        {{#isEmpty}}\n            <use class=\"b-rating-empty\" href=\"#star-empty\" y=\"0\" x=\"{{position}}\"/>\n        {{/isEmpty}}\n    {{/ratings}}\n</svg>\n<span class=\"b-rating-number\">\n    {{#isWishlistItem}}\n        ({{reviewsCount}})\n    {{/isWishlistItem}}\n    {{^isWishlistItem}}\n        ({{reviewsCount}})\n    {{/isWishlistItem}}\n</span>\n\n    </div>\n</a>\n\n{{/products}}\n</div>\n<a\nhref=\"{{viewAllProductsLink}}\"\nid=\"result-item-{{posinsetAllProductsLink}}\"\ndata-ref=\"result-item-{{posinsetAllProductsLink}}\"\nclass=\"b-button\"\n>\nView All Products\n</a>\n</div>\n{{/products.length}}\n{{#ideas.length}}\n<div class=\"b-suggestions-section m-ideas {{^products.length}}m-one_type{{/products.length}}\" role=\"none\" data-tau=\"search_suggestions_ideas\">\n<div role=\"none\" class=\"b-suggestions-title\">\nIdeas\n</div>\n<div class=\"b-suggestions-products\">\n{{#ideas}}\n<a\n    role=\"option\"\n    aria-label=\"Completion selected: Product Suggestions '{{productName}}'\"\n    id=\"result-item-{{posinset}}\"\n    class=\"b-suggestions-option b-suggestions_product m-col_3\"\n    href=\"{{url}}\"\n    data-ref=\"result-item-{{posinset}}\"\n    data-suggestion-value=\"{{name}}\"\n    data-tau-product-id=\"{{id}}\"\n    data-event-click=\"onProductLinkClick\"\n    data-gtm-event-label=\"{{key}}\"\n    data-gtm-event-sublabel=\"{{productName}}\"\n    data-list=\"suggestions\"\n    data-analytics=\"{{#stringifyJSON}}{{gtmInfo}}{{/stringifyJSON}}\"\n>\n    {{#image}}\n        <div class=\"b-suggestions_product-picture_wrap\">\n            <picture class=\"b-suggestions_product-picture\">\n                <img\n                    src=\"{{image.url}}\"\n                    alt=\"{{image.title}}\"\n                    width=\"{{image.width}}\"\n                    height=\"{{image.height}}\"\n                    loading=\"lazy\"\n                />\n            </picture>\n        </div>\n    {{/image}}\n\n    <div class=\"b-suggestions_product-info\">\n        <h3 class=\"b-suggestions_product-title\">{{productName}}</h3>\n    </div>\n</a>\n\n{{/ideas}}\n</div>\n<a\nhref=\"{{viewAllIdeasLink}}\"\nid=\"result-item-{{posinsetAllIdeasLink}}\"\ndata-ref=\"result-item-{{posinsetAllIdeasLink}}\"\nclass=\"b-button\"\n>\nView All Ideas\n</a>\n</div>\n{{/ideas.length}}\n</div>\n</div>\n</script>\n<script data-ref=\"templateError\" type=\"template/mustache\">\n<div\nrole=\"alert\"\nclass=\"b-suggestions-inner m-empty\"\ndata-ref=\"listboxInner\"\n>\nSorry, but suggestions currently unavailable\n</div>\n</script>\n\n</div>\n</div>\n</div>\n\n</div>\n\n<div\n    data-widget=\"globalModal\"\n    data-disable-rendering=\"false\"\n    data-close-opened-modal=\"true\"\n>\n    <div\n        class=\"b-dialog\"\n        data-ref=\"container\"\n        hidden\n    >\n    </div>\n    <script type=\"template/mustache\" data-ref=\"template\">\n        <div\n            class=\"b-dialog {{#wrapperClasses}}{{wrapperClasses}}{{/wrapperClasses}}\"\n            data-ref=\"container\"\n            data-event-scroll.passive=\"onScroll\"\n        >\n            <div\n                class=\"b-dialog-window {{#windowClasses}}{{windowClasses}}{{/windowClasses}}\"\n                role=\"dialog\"\n                data-ref=\"dialog\"\n                aria-modal=\"true\"\n                {{#ariaLabel}}\n                aria-label=\"{{ariaLabel}}\"\n                {{/ariaLabel}}\n            >\n                <div class=\"b-dialog-header {{#headerClasses}}{{headerClasses}}{{/headerClasses}}\">\n                    {{#headerText}}\n                    <h2 class=\"b-dialog-title\">\n                        {{headerText}}\n                    </h2>\n                    {{/headerText}}\n                    \n\n\n<button\n    class=\"b-dialog-close\"\n    title=\"Close\"\n    aria-label=\"Close\"\n    type=\"button\"\n    data-dismiss=\"modal\"\n    data-event-click.prevent=\"cancel\"\n    data-ref=\"firstFocusElement\"\n    data-tau=\"dialog_close\"\n>\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" class=\"b-icon_close\">\n    <use href=\"#close\"></use>\n</svg>\n\n</button>\n\n\n\n                </div>\n                <div class=\"b-dialog-body {{#bodyClasses}}{{bodyClasses}}{{/bodyClasses}}{{^bodyClasses}}b-user_content{{/bodyClasses}}\">\n                    {{& content }}\n                </div>\n                {{#showActions}}\n                <div class=\"b-dialog-footer m-actions\">\n                    {{#actions}}\n                        <button\n                            type=\"button\"\n                            class=\"b-button {{#classes}}{{classes}}{{/classes}}\"\n                            {{#handler}}\n                            data-event-click.prevent=\"{{handler}}\"\n                            {{/handler}}\n                            data-dismiss=\"modal\"\n                            {{#lastFocusElement}}\n                            data-ref=\"lastFocusElement\"\n                            {{/lastFocusElement}}\n                        >\n                            {{text}}\n                        </button>\n                    {{/actions}}\n                </div>\n                {{/showActions}}\n            </div>\n        </div>\n    </script>\n</div>\n\n\n<div data-context=\"header\">\n<div\n    class=\"b-minicart_panel\"\n    data-widget=\"minicartDialog\"\n    data-disable-rendering=\"true\"\n    data-classes-loading=\"m-loading_long\"\n    data-action-url=\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Cart-MiniCartShow\"\n    data-accessibility-alerts='{\n        \"quantitychanged\": \"Quantity changed\",\n        \"productremoved\": \"Product removed\",\n        \"movedtowishlist\": \"Product added to Wish list\"\n    }'\n    data-action-movetowishlist=\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Wishlist-AddProduct\"\n>\n    <div\n        class=\"b-minicart_panel-container\"\n        data-ref=\"container\"\n    >\n        <div\n            class=\"b-minicart\"\n            role=\"dialog\"\n            aria-modal=\"true\"\n            data-ref=\"dialog\"\n        >\n            <div class=\"b-minicart-inner\">\n                <div class=\"b-minicart-header\">\n                    <div data-tau=\"minicart_close\" id=\"minicart-dialog-close\">\n                        \n\n\n<button\n    class=\"b-dialog-close\"\n    title=\"Close\"\n    aria-label=\"Close\"\n    type=\"button\"\n    data-dismiss=\"modal\"\n    data-event-click.prevent=\"cancel\"\n    data-ref=\"firstFocusElement\"\n    data-tau=\"dialog_close\"\n>\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" class=\"b-icon_close\">\n    <use href=\"#close\"></use>\n</svg>\n\n</button>\n\n\n\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n<div\n    data-widget=\"confirmDialog\"\n    data-id=\"confirmDialog\"\n    data-widget-event-confirm=\"confirmedRemoveProduct\"\n    data-widget-event-cancel=\"cancelProductRemoving\"\n    data-widget-event-alternativeconfirm=\"moveProductToWishlist\"\n>\n    <div\n        class=\"b-dialog\"\n        data-ref=\"container\"\n        hidden=\"hidden\"\n    >\n        <div\n            class=\"b-dialog-window\"\n            role=\"dialog\"\n            data-ref=\"dialog\"\n            aria-modal=\"true\"\n            aria-busy=\"true\"\n            aria-label=\"Remove item\"\n        ></div>\n    </div>\n    <script type=\"template/mustache\" data-ref=\"template\">\n        <div\n            class=\"b-dialog b-remove_product\"\n            data-ref=\"container\"\n        >\n            <div\n                class=\"b-dialog-window b-dialog-bg\"\n                role=\"dialog\"\n                data-ref=\"dialog\"\n                aria-modal=\"true\"\n                aria-busy=\"false\"\n                aria-label=\"Remove item\"\n                aria-describedby=\"remove-product-confirmation-body\"\n            >\n                <div class=\"b-dialog-header b-remove_product-header\">\n                    <h2 class=\"b-dialog-title\">\n                        Remove item\n                    </h2>\n                    \n\n\n<button\n    class=\"b-dialog-close\"\n    title=\"Close\"\n    aria-label=\"Close\"\n    type=\"button\"\n    data-dismiss=\"modal\"\n    data-event-click.prevent=\"cancel\"\n    data-ref=\"firstFocusElement\"\n    data-tau=\"dialog_close\"\n>\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" class=\"b-icon_close\">\n    <use href=\"#close\"></use>\n</svg>\n\n</button>\n\n\n\n                </div>\n                <div\n                    id=\"remove-product-confirmation-body\"\n                    class=\"b-dialog-body b-user_content\"\n                >\n                    Are you sure you want to remove <br/>this item from your basket?\n                    <p class=\"b-dialog-subtitle\">{{productName}}</p>\n                    <div class=\"b-dialog-price\">\n                        <p class=\"b-prices\">\n                            {{#attributes.showCrossedPrice}}\n                                <span class=\"b-price-to b-sr_only\">\n                                    Is\n                                </span>\n                                <span class=\"b-price-item m-new\">\n                                    {{attributes.priceSales}}\n                                </span>\n                                <span class=\"b-price-to b-sr_only\">\n                                    , was\n                                </span>\n                                <span class=\"b-price-item m-old\">\n                                    {{attributes.priceList}}\n                                </span>\n                            {{/attributes.showCrossedPrice}}\n                            {{^attributes.showCrossedPrice}}\n                                <span class=\"b-price-item m-new\">\n                                    {{attributes.priceSales}}\n                                </span>\n                            {{/attributes.showCrossedPrice}}\n                        </p>\n                    </div>\n                </div>\n                <div class=\"b-dialog-footer m-actions b-remove_product-footer\">\n                    \n                        <button\n                            type=\"button\"\n                            class=\"b-button m-outline b-remove_product-btn\"\n                            data-event-click.prevent=\"alternativeConfirm\"\n                            data-dismiss=\"modal\"\n                            data-tau=\"remove_item_confirmation_moveToWishList\"\n                        >\n                            Move to Wishlist\n                        </button>\n                    \n                    <button\n                        type=\"button\"\n                        class=\"b-button b-remove_product-btn\"\n                        data-dismiss=\"modal\"\n                        data-event-click.prevent=\"confirm\"\n                        data-ref=\"lastFocusElement\"\n                        data-tau=\"remove_item_confirmation_confirm\"\n                    >\n                        Remove item\n                    </button>\n                </div>\n            </div>\n        </div>\n    </script>\n</div>\n\n\n\n    <div\n    data-widget=\"modal\"\n    data-id=\"editProductModal\"\n    data-ref-first-focus-element=\"closeEditPopup\"\n>\n    <div data-ref=\"container\"></div>\n\n    <script type=\"template/mustache\" data-ref=\"template\">\n        <div\n            class=\"b-dialog b-quick_view m-quick_view\"\n            id=\"editProductModal\"\n            data-ref=\"container\"\n            data-event-click.self=\"closeModal\"\n        >\n            <div\n                class=\"b-dialog-window b-quick_view-window\"\n                role=\"dialog\"\n                data-ref=\"dialog\"\n                aria-modal=\"true\"\n                aria-labelledby=\"editProductModalTitle\"\n            >\n                <div class=\"b-dialog-header b-quick_view-header\">\n                    <button\n                        class=\"b-dialog-close\"\n                        title=\"Close\"\n                        aria-label=\"Close\"\n                        type=\"button\"\n                        data-dismiss=\"modal\"\n                        data-ref=\"closeEditPopup\"\n                        data-event-click.prevent=\"cancel\"\n                        data-tau=\"edit_product_dialog_close\"\n                    >\n                        <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" class=\"b-icon_close\">\n    <use href=\"#close\"></use>\n</svg>\n\n                    </button>\n                </div>\n                {{#body}}\n                    <div class=\"b-dialog-body b-quick_view-body\">\n                        {{&body}}\n                    </div>\n                {{/body}}\n\n                {{#footer}}\n                    <div class=\"b-dialog-footer\">\n                        {{&footer}}\n                    </div>\n                {{/footer}}\n            </div>\n        </div>\n    </script>\n</div>\n\n</div>\n</div>\n\n<div\n    data-widget=\"justAddedToCartModal\"\n    data-id=\"justAddedToCartModal\"\n    data-ref-first-focus-element=\"closeEditPopup\"\n    data-cart-view-content-link=\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Cart-JustAddedToCartView\"\n    data-slot-content-link=\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Cart-JustAddedToCartSlot\"\n    data-accessibility-alerts='{\n        \"quantitychanged\": \"Quantity changed\",\n        \"productupdated\": \"Shopping cart updated\",\n        \"productremoved\": \"Product removed\",\n        \"promocodeadded\": \"Promo code added, but not applied\",\n        \"promocodeapplied\": \"Promo code applied\",\n        \"promocoderemoved\": \"Promo code removed\",\n        \"movedtowishlist\": \"Product added to Wish list\"\n    }'\n>\n    <div data-ref=\"container\"></div>\n\n    <script type=\"template/mustache\" data-ref=\"template\">\n        <div\n            class=\"b-dialog m-cart\"\n            data-ref=\"container\"\n            data-event-click.self=\"closeModal\"\n            data-event-scroll.passive=\"onScroll\"\n        >\n            <div\n                class=\"b-dialog-window\"\n                role=\"dialog\"\n                data-ref=\"dialog\"\n                aria-modal=\"true\"\n                aria-labelledby=\"justAddedToCartModalTitle\"\n            >\n                <div class=\"b-dialog-header\">\n                    <button\n                        class=\"b-dialog-close\"\n                        title=\"Close\"\n                        aria-label=\"Close\"\n                        type=\"button\"\n                        data-dismiss=\"modal\"\n                        data-ref=\"closeEditPopup\"\n                        data-event-click.prevent=\"cancel\"\n                        data-tau=\"edit_product_dialog_close\"\n             