s reduced\n      offsetOpacity = 2000,\n      //duration of the top scrolling animation (in ms)\n      scrollTopDuration = 700,\n      //grab the \"back to top\" link\n      $backToTop = $('.cd-top');\n\n    //hide or show the \"back to top\" link\n    $(window).scroll(function () {\n      if ($(this).scrollTop() > offset) {\n        $backToTop.addClass('cd-is-visible');\n      } else {\n        $backToTop.removeClass('cd-is-visible cd-fade-out');\n      }\n      if ($(this).scrollTop() > offsetOpacity) {\n        $backToTop.addClass('cd-fade-out');\n      }\n    });\n\n    //smooth scroll to top\n    $backToTop.on('click', function (event) {\n      event.preventDefault();\n      $('body,html').animate({\n        scrollTop: 0\n      }, scrollTopDuration);\n    });\n    $backToTop.on('touchstart', function () {\n      $(this).children('.up-arrow').addClass('backtotop-hover');\n      $(this).children('.up-arrow').removeClass('backtotop-hoveroff');\n    });\n    $backToTop.on('touchend', function () {\n      $(this).children('.up-arrow').removeClass('backtotop-hover');\n      $(this).children('.up-arrow').addClass('backtotop-hoveroff');\n    });\n    function isIE(version, comparison) {\n      var cc = 'IE',\n        b = document.createElement('B'),\n        docElem = document.documentElement,\n        isInternetExplorer;\n      if (version) {\n        cc += ' ' + version;\n        if (comparison) {\n          cc = comparison + ' ' + cc;\n        }\n      }\n      b.innerHTML = '<!--[if ' + cc + ']><b id=\"iecctest\"></b><![endif]-->';\n      docElem.appendChild(b);\n      isInternetExplorer = !!document.getElementById('iecctest');\n      docElem.removeChild(b);\n      return isInternetExplorer;\n    }\n    if (isIE(10, 'lte')) {\n      $(window).scroll(function () {\n        if ($(this).scrollTop() > offset) {\n          $backToTop.fadeTo('fast', 1, function () {});\n        } else {\n          $backToTop.removeClass('cd-is-visible');\n        }\n        if ($(this).s