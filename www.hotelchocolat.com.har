components;\n    for (var i = 0; i < components.length; i++) {\n      if (components[i].pid === pid) {\n        qty = parseInt(components[i].quantity, 10);\n      }\n    }\n  }\n  return qty;\n}\n\n/**\n * @description Update the current hamper on the page.  Details such as the\n * hamper price and number of items will be updated here.\n */\nfunction showCurrentHamperStatus(showStatus) {\n  if (showStatus === false) {\n    $('.current-hamper-status').hide();\n  } else {\n    $('.current-hamper-status').show();\n  }\n}\n\n/**\n * @description Update the current hamper on the page.  Details such as the\n * hamper price and number of items will be updated here.\n */\nfunction updateCurrentHamperDetails(data) {\n  $('#currentHamperImage').attr('src', data.container.image);\n  $('#currentHamperImage').attr('alt', data.container.name);\n  $('#currentHamperName').text(data.container.name);\n  var hamperVolume = calculateHamperVolume(data);\n  $('#currentHamperVolume').val(hamperVolume);\n  var percentage = hamperVolume / parseInt(data.container.capacity, 10);\n  percentage = parseInt(percentage * 100, 10);\n  $('#currentHamperPercentage').text(percentage);\n  util.drawProgressWheel(percentage / 100, 'currentHamperGraph');\n  var itemCount = calculateItemCount(data);\n  var $hampersYourItems = $('#hampers-your-items');\n  $hampersYourItems.find('.count').text(itemCount);\n  if (itemCount > 0) {\n    $hampersYourItems.removeClass('disabled-ref');\n  } else {\n    $hampersYourItems.addClass('disabled-ref');\n  }\n  if (itemCount === 1) {\n    $('#currentHamperItemCount').text(itemCount + ' ' + Resources.ITEM);\n  } else {\n    $('#currentHamperItemCount').text(itemCount + ' ' + Resources.ITEMS);\n  }\n  $('#currentHamperItemCount').data('item-count', itemCount);\n  $('#currentHamperUnitPrice').text(data.unitPrice);\n  $('#currentHamperQuantity').text(data.container.quantity);\n  $('#currentHamperTotalPrice').text(data.totalPrice);\n  if (data.container.components.length > 0) {\n    $('.view-items').prop('disabled', false);\n    $('.current-hamper-save').prop('disabled', false);\n    $('.current-hamper-cart').prop('disabled', false);\n  } else {\n    $minicartElement.removeClass('show');\n    $('.view-items').prop('disabled', true);\n    $('.current-hamper-save').prop('disabled', true);\n    $('.current-hamper-cart').prop('disabled', true);\n  }\n  // Update tag manager hamper details\n  if (data.tagManagerData && $('input[name=currentHamper]').length > 0) {\n    $('input[name=currentHamper]').val(JSON.stringify(data.tagManagerData));\n  }\n  showCurrentHamperStatus(true);\n  updateTileButtons();\n}\nfunction pageUpdateAfterRemove(callback) {\n  var currentHref = $('#hampers-your-items').data('current-href');\n  var uri = null;\n  if (typeof currentHref !== 'undefined' && typeof window.history.pushState === 'function') {\n    uri = util.getUri(currentHref);\n    search.updateProductListing(uri.query.substring(1), false, callback);\n  } else {\n    //@TODO If no history interface in window object currenlty its only run callback\n    callback();\n  }\n}\n/**\n * @description Update the minicart that shows the items in the\n * current hamper.\n */\nfunction updateCurrentHamperMinicart() {\n  ajax.load({\n    url: Urls.hamperMinicart,\n    target: $('.show-minicart'),\n    callback: function callback() {\n      $minicartElement.addClass('hover');\n      addHamperToCartCTA($minicartElement.find('.currentHamperCheckoutForm'));\n      hamperMiniCartLayer();\n      $('.hamper-occupancy').addClass('hover');\n      $('.remove-component').on('click', function (event) {\n        var $form = $(this).closest('form');\n        var formUrl = $form.attr('action');\n        var formData = util.serializeJSON($form);\n        sendAjaxMessage(formUrl, formData, function () {\n          pageUpdateAfterRemove(updateCurrentHamperMinicart);\n        });\n        event.preventDefault();\n      });\n    }\n  });\n}\n/**\n *\n * @param thisElement - either add-to-hamper button or qty field after enter pressed\n * @param e {object} -event object need stop default actions\n */\nfunction qvFormSubmission(thisElement, e) {\n  e.preventDefault();\n  var $form = $(thisElement).closest('.pdpComponentForm');\n  var productId = $form.find('input[name=\"pid\"]').val();\n  var $qtyInput = $form.find('.input-group-qty');\n  var formUrl = $form.attr('action');\n  var formData = util.serializeJSON($form);\n  var updateTileQuantity = function updateTileQuantity() {\n    $.each($('.tileComponentForm'), function () {\n      var $form = $(this);\n      var pid = $form.find('input[name=\"pid\"]').first().val();\n      if (pid === productId) {\n        $form.find('input[name=\"Quantity\"]').first().val($qtyInput.val());\n        return false;\n      }\n    });\n  };\n  sendAjaxMessage(formUrl, formData, updateTileQuantity);\n}\n\n/**\n * @description Initialize the quickview so it adds components\n * to the current hamper.\n */\nfunction initializeQuickview() {\n  var $form = $('.quickview-dialog .pdpComponentForm'),\n    $submitButtons = $form.find('.select-component, .update-component'),\n    $qtyInput = $form.find('.input-group-qty');\n\n  //handlers for qv add-to-hamper submit clicked\n  $submitButtons.on('click', function (e) {\n    qvFormSubmission(this, e);\n  });\n\n  //handlers for qv add-to-hamper enter pressed\n  $qtyInput.keypress(function (e) {\n    if (e.which === 13) {\n      qvFormSubmission(this, e);\n    }\n  });\n\n  //update once qv loaded and assign same handler if qty change\n  updateTileButtons();\n  $qtyInput.on('change', function () {\n    updateTileButtons();\n  });\n}\n\n/**\n * @description Update the buttons to show warnings and disable/enable buttons\n * for the select, update, etc.\n */\nfunction updateTileButtons() {\n  var currentHamperVolume = parseInt($('#currentHamperVolume').val(), 10);\n  $.each($('.tileComponentForm'), function () {\n    var $form = $(this);\n    var pid = $form.find('input[name=\"pid\"]').first().val();\n    var qtyElement = $form.find('input[name=\"Quantity\"]').first();\n    var qty = parseInt(qtyElement.val(), 10);\n    var isValid = true;\n    // If the value isn't a number or is negative, go back to the original value.\n    if (isNaN(qty) || qty < 0) {\n      isValid = false;\n      setTimeout(function () {\n        var newQty = parseInt(qtyElement.val(), 10);\n        if (isNaN(newQty) || newQty < 0) {\n          if ($form.data('type') === 'container') {\n            if (typeof currentHamper !== 'undefined' && currentHamper !== null) {\n              qty = currentHamper.container.quantity;\n            } else {\n              qty = 1;\n            }\n          } else if ($form.data('type') === 'component') {\n            qty = getProductQtyInCurrentHamper(pid);\n            if (qty === 0) {\n              qty = 1;\n            }\n          }\n          qtyElement.val(qty);\n          hamperTileValidate($form, qty, pid, currentHamperVolume);\n        }\n      }, 2000);\n      // If the qunatity value is different, replace it with the parsed value.\n    } else if (qtyElement.val() !== String(qty)) {\n      qtyElement.val(qty);\n    }\n    if (isValid) {\n      hamperTileValidate($form, qty, pid, currentHamperVolume);\n    }\n  });\n}\nfunction hamperTileValidate($form, qty, pid, currentHamperVolume) {\n  var $warningElement = null,\n    $selectButton = null,\n    $updateButton = null,\n    $removeButton = null,\n    hamperVolumeScore = null,\n    currentComponentQty = null,\n    components = null;\n  if (typeof currentHamper !== 'undefined' && currentHamper !== null) {\n    // only define components if the current hamper exists\n    components = currentHamper.container.components;\n  }\n  if ($form.data('type') === 'container') {\n    // check to see if this product tile is for a hamper container\n    $warningElement = $form.find('.warning-container').first();\n    $selectButton = $form.find('.select-container').first();\n    $updateButton = $form.find('.update-container').first();\n    if (typeof currentHamper === 'undefined' || currentHamper === null) {\n      // disable the update button if there is no current hamper\n      $selectButton.removeClass('hidden');\n      $updateButton.addClass('hidden');\n    } else if (currentHamper.container.pid === pid) {\n      // disable the select button if it is the current hamper container\n      $selectButton.addClass('hidden');\n      $updateButton.removeClass('hidden');\n      if (currentHamper.container.quantity === qty) {\n        $updateButton.prop('disabled', true);\n      } else {\n        $updateButton.prop('disabled', false);\n      }\n    } else {\n      // otherwise enable the select button only\n      $selectButton.removeClass('hidden');\n      $updateButton.addClass('hidden');\n    }\n    if ($warningElement.data('hamper-capacity') < currentHamperVolume) {\n      // show the warning if the current hamper is bigger than this one's capacity\n      $selectButton.addClass('hidden');\n      $updateButton.addClass('hidden');\n      $warningElement.show();\n    } else {\n      //  hide the warning if this is not above the hamper capacity\n      $warningElement.hide();\n    }\n  } else if ($form.data('type') === 'component') {\n    // check to see if this product tile is for a hamper component\n    $warningElement = $form.find('.warning-component').first();\n    $selectButton = $form.find('.select-component').first();\n    $updateButton = $form.find('.update-component').first();\n    $removeButton = $form.find('.remove-component').first();\n    $selectButton.removeClass('hidden');\n    $updateButton.addClass('hidden');\n    $form.closest('.grid-tile').removeClass('error');\n\n    //check components array of the given hamper\n    if (components !== null) {\n      //show update and hide select buttons of already chosen components of given hamper\n      for (var i = 0; i < components.length; i++) {\n        if (components[i].pid === pid) {\n          $selectButton.addClass('hidden');\n          $updateButton.removeClass('hidden');\n        }\n      }\n    } else {\n      window.location = Urls.hamperLanding;\n      return;\n    }\n    hamperVolumeScore = parseInt($selectButton.data('hamper-volume-score'), 10);\n    currentComponentQty = getProductQtyInCurrentHamper(pid);\n    if (hamperErrors) {\n      for (var j = 0; j < hamperErrors.componentProducts.length; j++) {\n        if (hamperErrors.componentProducts[j].pid === pid && hamperErrors.componentProducts[j].availablequantity) {\n          qty = hamperErrors.componentProducts[j].availablequantity;\n          // TODO: mark the tile with an error class that is designed to match the comps\n          $form.closest('.grid-tile').addClass('error');\n          $form.find('input[name=\"Quantity\"]').first().val(qty);\n          break;\n        }\n      }\n    }\n\n    //disable user action if qty the same\n    if (qty === currentComponentQty) {\n      $selectButton.prop('disabled', true);\n      $updateButton.prop('disabled', true);\n    } else {\n      $selectButton.prop('disabled', false);\n      $updateButton.prop('disabled', false);\n    }\n\n    //hamper capacity verification\n    if (hamperVolumeScore * (qty - currentComponentQty) + currentHamperVolume > currentHamper.container.capacity) {\n      // disable select and update if this current qty would push it over capacity\n      $selectButton.prop('disabled', true);\n      $updateButton.addClass('hidden');\n      $warningElement.text(Resources.TOO_LARGE);\n      $warningElement.show();\n    } else {\n      // hide the warning if this qty will not exceed the hamper capacity\n      $warningElement.hide();\n    }\n    if (currentComponentQty > 0) {\n      $removeButton.removeClass('disabled');\n    } else {\n      $removeButton.addClass('disabled');\n    }\n  }\n}\n/**\n * @description Update the buttons to show warnings and disable/enable buttons\n * for the select, update, etc.\n */\nfunction markTileInvalidQuantity(productID, quantity) {\n  $.each($('.tileComponentForm'), function () {\n    var $form = $(this);\n    var pid = $form.find('input[name=\"pid\"]').first().val();\n    if (pid === productID) {\n      $form.find('input[name=\"Quantity\"]').first().val(quantity);\n      // TODO: mark the tile with an error class that is designed to match the comps\n      $form.closest('.grid-tile').addClass('error');\n      return true;\n    }\n  });\n}\n\n/**\n * @description Sends a message to the specified URL with a product ID and\n * a quantity.  If the response is not an error, the current hamper details on\n * the page will be updated.  If there is an error, the error code will be used\n * to display an error message.\n */\nfunction sendAjaxMessage(formUrl, formData, _callback) {\n  ajax.getJson({\n    url: formUrl,\n    data: formData,\n    callback: function callback(data) {\n      var notificationUrl = null;\n      if (!data) {\n        window.alert(Resources.SERVER_ERROR);\n        return false;\n      } else if (data.success === false) {\n        if (data.code === 'itemunavailable' || data.code === null) {\n          var pids = new Array(formData.pid);\n          var buttonFunction = function buttonFunction() {\n            dialog.close();\n          };\n          itemUnavailableDialog(pids, buttonFunction);\n          return false;\n        } else {\n          notificationUrl = util.appendParamsToUrl(Urls.hamperNotification, {\n            pid: formData.pid,\n            errorcode: data.code\n          });\n        }\n        dialog.open({\n          url: notificationUrl,\n          options: {\n            dialogClass: 'no-title',\n            open: function open() {\n              $('.close-dialog').on('click', function () {\n                dialog.close();\n              });\n            }\n          }\n        });\n        return false;\n      } else {\n        currentHamper = data;\n        ajax.getJson({\n          url: Urls.getHamperErrors,\n          data: {\n            id: data.id\n          },\n          callback: function callback(errorData) {\n            hamperErrors = errorData;\n            updateCurrentHamperDetails(data);\n            hamperErrors = null;\n            if (typeof _callback === 'function') {\n              _callback.call();\n            }\n          }\n        });\n        return true;\n      }\n    }\n  });\n}\n/**\n * @description check if it's mobile onload and hide all refinements\n * assign event handler to the filter button to toggle active state, which\n * means all refinements activated\n */\nfunction initMobileFilterButton() {\n  var $filterBtn = $('.hamper_mb_filter'),\n    $refinements = $('.refinements .refinement').not('.reset');\n  if (util.viewport.isSmall()) {\n    $refinements.removeClass('active');\n  }\n  $filterBtn.on('touchstart click', function (e) {\n    e.preventDefault();\n    $(this).toggleClass('active');\n    if ($(this).hasClass('active')) {\n      $refinements.addClass('active').show();\n    } else {\n      $refinements.removeClass('active').hide();\n    }\n  });\n}\n/**\n * @description Initialize hampers tabs.\n */\nfunction initializeDom() {\n  return new TPromise(function (resolve) {\n    ajax.getJson({\n      url: Urls.getCurrentHamper,\n      callback: function callback(data) {\n        if (!data) {\n          resolve();\n        } else if (data.success === false) {\n          updateTileButtons();\n          resolve();\n          //return false;\n        } else {\n          currentHamper = data;\n          // set the quantities on the product tiles\n          $.each($('.tileComponentForm'), function () {\n            var $form = $(this);\n            var pid = null;\n            var qty = null;\n            if ($form.data('type') === 'component') {\n              pid = $form.find('input[name=\"pid\"]').first().val();\n              qty = getProductQtyInCurrentHamper(pid);\n              if (qty > 0) {\n                // set the quantity if the number in the hamper is over zero\n                $form.find('input[name=\"Quantity\"]').first().val(qty);\n              }\n            } else if ($form.data('type') === 'container') {\n              qty = currentHamper.container.quantity;\n              if (qty > 0) {\n                // set the quantity if the number of hampers is over zero\n                $form.find('input[name=\"Quantity\"]').first().val(qty);\n              }\n            }\n          });\n          ajax.getJson({\n            url: Urls.getHamperErrors,\n            data: {\n              id: data.id\n            },\n            callback: function callback(errorData) {\n              hamperErrors = errorData;\n              updateCurrentHamperDetails(data);\n              hamperErrors = null;\n            }\n          });\n          // Save hamper container JSON data\n          var containerDetails = JSON.stringify(data.container);\n          $('input[name=\"hamperContainerDetails\"]').val(containerDetails);\n          $minicartElement = $('.show-minicart');\n          resolve();\n        }\n      }\n    });\n  });\n}\n\n/**\n * @description Initialize event handlers on hampers pages\n */\nfunction initializeEvents() {\n  $('#hampers-tabs-mobile ul.tabs-menu').on('click', 'li > a', function (e) {\n    e.preventDefault();\n    var $tab = $(this).parent('li');\n    // $tab.siblings().removeClass('active-tab');\n    $tab.toggleClass('active-tab');\n  });\n  $('.tab-target-desktop').tabs();\n  // Toggles tab content on click\n  $('.descSection3 h3').on('click touchstart', function (e) {\n    $(this).toggleClass('active');\n    e.preventDefault();\n  });\n\n  // Toggles mobile hamper status accordion on click\n  $('.mobile-status-header').off().on('click touchstart', function (e) {\n    e.stopPropagation();\n    e.preventDefault();\n    $('.hamper-status-container').toggleClass('show');\n    $(this).toggleClass('on');\n  });\n  $('#secondary .refinement a').on('click', function (e) {\n    // GTM Linchpin analytics\n    if (SitePreferences.GTM_ENABLED) {\n      linchpin.hamperFiltersEvent(e);\n    }\n  });\n  $('div .sort-by').on('change', function (e) {\n    // GTM Linchpin analytics\n    if (SitePreferences.GTM_ENABLED) {\n      linchpin.hamperSortEvent(e);\n    }\n  });\n\n  // classes for adding or updating component quantity\n  $('.search-result-content').on('click', '.select-component, .update-component', function (e) {\n    var $form = $(this).closest('form');\n    var formUrl = $form.attr('action');\n    var formData = util.serializeJSON($form);\n    var callback = function callback() {\n      // GTM Linchpin analytics\n      linchpin.addItemToHamperEvent(e, formData);\n    };\n    sendAjaxMessage(formUrl, formData, callback);\n\n    // GTM Linchpin analytics\n    if (SitePreferences.GTM_ENABLED) {\n      linchpin.hamperSelectEvent(e);\n    }\n    e.preventDefault();\n  });\n\n  // class for removing a component from the current hamper\n  $('.search-result-items').on('click', '.remove-component', function (e) {\n    var $form = $(this).closest('form'),\n      formUrl = $form.attr('action'),\n      formData = util.serializeJSON($form);\n    // GTM Linchpin analytics\n    if (SitePreferences.GTM_ENABLED) {\n      linchpin.removeItemFromHamperEvent(e, formData);\n    }\n    sendAjaxMessage(formUrl, formData, function () {\n      pageUpdateAfterRemove();\n    });\n  });\n\n  // these classes are container changes and premade hampers\n  $('.select-container, .select-hamper, .update-container').on('click', function (e) {\n    var $form = $(this).closest('form');\n    updateSelection($form);\n    e.preventDefault();\n  });\n\n  // submit the form on pressing the enter key\n  $('.search-result-items').keypress('.input-group-qty', function (e) {\n    var key = e.which;\n    var enterKeyCode = 13;\n    if (key === enterKeyCode) {\n      var $form = $(this).closest('form');\n      updateSelection($form);\n      e.preventDefault();\n    }\n  });\n  quantity.init(updateTileButtons);\n\n  //View hamper minicart\n  $('.view-items').on('click', function (e) {\n    // GTM Linchpin analytics\n    if (SitePreferences.GTM_ENABLED) {\n      linchpin.viewHamperItemsEvent(e);\n    }\n    if ($('.show-minicart').hasClass('hover')) {\n      $('.show-minicart').removeClass('hover');\n      $('.uiLayerIndicator').remove();\n    } else {\n      updateCurrentHamperMinicart();\n      e.preventDefault();\n    }\n  });\n\n  //Hamper minicart close icon\n  $('.show-minicart ').on('click touchstart', '.close', function (e) {\n    e.preventDefault();\n    $('.show-minicart').removeClass('hover');\n    $('.uiLayerIndicator').remove();\n  });\n\n  // save the current hamper to the wishlist\n  $('.currentHamperSaveForm').on('click', ':button', function (e) {\n    e.preventDefault();\n    dialog.open({\n      url: Urls.hamperSaveDialog,\n      options: {\n        title: Resources.SAVE_HAMPER_DIALOG_TITLE,\n        dialogClass: 'save-hamper-dialog',\n        open: function open() {\n          validator.init();\n        },\n        buttons: []\n      }\n    });\n  });\n  addHamperToCartCTA($('.currentHamperCheckoutForm'));\n  initMobileFilterButton();\n}\nvar addHamperToBagDialog = function addHamperToBagDialog() {\n  validator.init();\n  var $addHamperToBagForm = $('#addCurrentHamperForm');\n  $addHamperToBagForm.find('input[name=\"name\"]').val(currentHamper.name);\n  $addHamperToBagForm.on('click', ':button', function () {\n    if (!$addHamperToBagForm.valid()) {\n      return;\n    }\n    $(this).addClass('clicked');\n  });\n  $addHamperToBagForm.submit(function (event) {\n    event.preventDefault();\n    if (!$addHamperToBagForm.valid()) {\n      return;\n    }\n    var params = $addHamperToBagForm.serialize(),\n      $clickedButton = $addHamperToBagForm.find('button.clicked');\n    // Add the value of the clicked button to the parameters\n    params = params + '&type=' + encodeURIComponent($clickedButton.val());\n    $.ajax({\n      url: $addHamperToBagForm.attr('action'),\n