mes/\"\n                                title=\"Hobbies &amp; Games\"\n                                data-gtm-event-sublabel=\"Hobbies &amp; Games\"\n                                >\n                                \n                                    <img class=\"b-category_item-img\" src=\"/on/demandware.static/-/Sites-uk-navigation-catalog/default/dw2cc78dc6/images/slot/home_page/Crafts and Hobbies Category.svg\" width=\"38\" height=\"38\" alt=\"Hobbies &amp; Games\" loading=\"lazy\"/>\n                                \n                                <p class=\"b-category_item-title\">\n                                    Hobbies &amp; Games\n                                </p>\n                            </a>\n                        </div>\n                    \n                        <div class=\"b-carousel-item\" data-tau=\"carousel_tile\">\n                            <a\n                                class=\"b-category_item\"\n                                href=\"/art-supplies/\"\n                                title=\"Art Supplies\"\n                                data-gtm-event-sublabel=\"Art Supplies\"\n                                >\n                                \n                                    <img class=\"b-category_item-img\" src=\"/on/demandware.static/-/Sites-uk-navigation-catalog/default/dw7a040ffb/images/slot/home_page/Art Category.svg\" width=\"38\" height=\"38\" alt=\"Art Supplies\" loading=\"lazy\"/>\n                                \n                                <p class=\"b-category_item-title\">\n                                    Art Supplies\n                                </p>\n                            </a>\n                        </div>\n                    \n                        <div class=\"b-carousel-item\" data-tau=\"carousel_tile\">\n                            <a\n                                class=\"b-category_item\"\n                                href=\"/sewing/\"\n                                title=\"Sewing\"\n                                data-gtm-event-sublabel=\"Sewing\"\n                                >\n                                \n                                    <img class=\"b-category_item-img\" src=\"/on/demandware.static/-/Sites-uk-navigation-catalog/default/dw715cd38a/images/slot/home_page/Sewing Category.svg\" width=\"38\" height=\"38\" alt=\"Sewing\" loading=\"lazy\"/>\n                                \n                                <p class=\"b-category_item-title\">\n                                    Sewing\n                                </p>\n                            </a>\n                        </div>\n                    \n                        <div class=\"b-carousel-item\" data-tau=\"carousel_tile\">\n                            <a\n                                class=\"b-category_item\"\n                                href=\"/craft-essentials/\"\n                                title=\"Craft Essentials\"\n                                data-gtm-event-sublabel=\"Craft Essentials\"\n                                >\n                                \n                                    <img class=\"b-category_item-img\" src=\"/on/demandware.static/-/Sites-uk-navigation-catalog/default/dw0c5953b0/images/slot/home_page/Craft Essentials Category.svg\" width=\"38\" height=\"38\" alt=\"Craft Essentials\" loading=\"lazy\"/>\n                                \n                                <p class=\"b-category_item-title\">\n                                    Craft Essentials\n                                </p>\n                            </a>\n                        </div>\n                    \n                        <div class=\"b-carousel-item\" data-tau=\"carousel_tile\">\n                            <a\n                                class=\"b-category_item\"\n                                href=\"/digital-crafting/\"\n                                title=\"Digital Crafting\"\n                                data-gtm-event-sublabel=\"Digital Crafting\"\n                                >\n                                \n                                    <img class=\"b-category_item-img\" src=\"/on/demandware.static/-/Sites-uk-navigation-catalog/default/dw0b084d12/images/slot/home_page/Digital Cutting Category.svg\" width=\"38\" height=\"38\" alt=\"Digital Crafting\" loading=\"lazy\"/>\n                                \n                                <p class=\"b-category_item-title\">\n                                    Digital Crafting\n                                </p>\n                            </a>\n                        </div>\n                    \n                        <div class=\"b-carousel-item\" data-tau=\"carousel_tile\">\n                            <a\n                                class=\"b-category_item\"\n                                href=\"/papercraft/\"\n                                title=\"Papercraft\"\n                                data-gtm-event-sublabel=\"Papercraft\"\n                                >\n                                \n                                    <img class=\"b-category_item-img\" src=\"/on/demandware.static/-/Sites-uk-navigation-catalog/default/dw0c2b34b6/images/slot/home_page/Papercraft Category.svg\" width=\"38\" height=\"38\" alt=\"Papercraft\" loading=\"lazy\"/>\n                                \n                                <p class=\"b-category_item-title\">\n                                    Papercraft\n                                </p>\n                            </a>\n                        </div>\n                    \n                        <div class=\"b-carousel-item\" data-tau=\"carousel_tile\">\n                            <a\n                                class=\"b-category_item\"\n                                href=\"/baking-kitchen/\"\n                                title=\"Baking &amp; Kitchen\"\n                                data-gtm-event-sublabel=\"Baking &amp; Kitchen\"\n                                >\n                                \n                                    <img class=\"b-category_item-img\" src=\"/on/demandware.static/-/Sites-uk-navigation-catalog/default/dwe2e0fcc9/images/slot/home_page/Baking Category.svg\" width=\"38\" height=\"38\" alt=\"Baking &amp; Kitchen\" loading=\"lazy\"/>\n                                \n                                <p class=\"b-category_item-title\">\n                                    Baking &amp; Kitchen\n                                </p>\n                            </a>\n                        </div>\n                    \n                        <div class=\"b-carousel-item\" data-tau=\"carousel_tile\">\n                            <a\n                                class=\"b-category_item\"\n                                href=\"/home-storage/\"\n                                title=\"Home &amp; Storage\"\n                                data-gtm-event-sublabel=\"Home &amp; Storage\"\n                                >\n                                \n                                    <img class=\"b-category_item-img\" src=\"/on/demandware.static/-/Sites-uk-navigation-catalog/default/dw55f31000/images/slot/home_page/Decor and Frames.svg\" width=\"38\" height=\"38\" alt=\"Home &amp; Storage\" loading=\"lazy\"/>\n                                \n                                <p class=\"b-category_item-title\">\n                                    Home &amp; Storage\n                                </p>\n                            </a>\n                        </div>\n                    \n                        <div class=\"b-carousel-item\" data-tau=\"carousel_tile\">\n                            <a\n                                class=\"b-category_item\"\n                                href=\"/party-occasions/\"\n                                title=\"Party &amp; Occasions\"\n                                data-gtm-even