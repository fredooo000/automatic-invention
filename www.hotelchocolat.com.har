ributes\n */\nfunction getOrdersData() {\n  var $options = $addressSelect.find('option');\n  var ordersCount = 0;\n  $options.each(function () {\n    var $option = $(this);\n    var order = $option.data('order-json');\n    if (!order) {\n      return;\n    }\n    $option.attr('value', order.addressLine).text(order.title);\n    orders[order.addressLine] = order;\n    ordersCount++;\n  });\n  if (ordersCount === 0) {\n    $('.address-select .js-no-orders').show();\n  }\n\n  // console.log(orders);\n}\nfunction initSelectAddress() {\n  $addressSelect.on('change', function (e) {\n    var $this = $(this);\n    var order = getSelectedOrderData();\n    var giftProducts = JSON.stringify(order.products);\n    var url = util.appendParamToURL(Urls.giftGuruGetProducts, 'products', giftProducts);\n    var $shipmentContainer = $('#gift-container');\n    $('.address-select .js-recipient-address').html($this.val()).show();\n    $('.address-select .js-gift-guru-edit-address').show();\n\n    // GTM Linchpin analytics\n    if (SitePreferences.GTM_ENABLED) {\n      linchpin.giftGuruEvent(e);\n    }\n    ajax.load({\n      url: url,\n      target: $shipmentContainer,\n      callback: function callback() {\n        $('.order-history').show();\n        initHistoryItems();\n      }\n    });\n  });\n}\n\n/**\n * Add product to cart\n */\nfunction initAddToCartEvent() {\n  $(document).on('submit', '.js-gift-guru-gift-form', function (e) {\n    e.preventDefault();\n    var $form = $(this);\n    var address = getSelectedOrderData().address;\n    var url = util.appendParamsToUrl(Urls.giftGuruStartSession, {\n      format: 'ajax',\n      title: address.firstName\n    });\n\n    // Make request to create a GiftGuru session\n    $.ajax({\n      url: url,\n      data: {\n        address: JSON.stringify(address)\n      },\n      method: 'POST',\n      success: function success(response) {\n        if (!response.success) {\n          return;\n        }\n\n        // Add product to cart\n        var u