ass=\"b-footer_nav-item\"><a class=\"b-footer_nav-link\" data-event-click=\"footerLinkClick\" data-gtm-event-sublabel=\"Information &gt; Safety Data Sheets\" data-tau=\"footer_navigation_item\" href=\"https://www.hobbycraft.co.uk/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Datasheets-SearchForm?cid=datasheets\">Safety Data Sheets</a></li>\r\n</ul>\r\n</div>\r\n</section>\r\n</div>\n    <!-- END_dwmarker -->\n\n\n            \n\n            <div class=\"b-footer-sidebar\">\n                <div\n                    class=\"b-footer-newsletters\"\n                    data-tau=\"footer_newsletters\"\n                >\n                    \n\n\n\n<form\n    class=\"b-newsletters\"\n    aria-label=\"Sign up for email\"\n    name=\"subscribe-form\"\n    action=\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/EmailSubscribe-Subscribe\"\n    method=\"POST\"\n    data-signup-email=\"dwfrm_emailsubscribe_email\"\n    data-accessibility-announcement-msg=\"Subscribed for newsletters\"\n    data-widget=\"emailSubscribe\"\n    data-event-submit.prevent=\"handleSubmit\"\n>\n    <div class=\"b-newsletters-logo\">\n        <img src=\"https://www.hobbycraft.co.uk/on/demandware.static/Sites-hobbycraft-uk-Site/-/default/dw734df48b/images/ma/hobbycraft-club-logo.png\" width=\"108\" alt=\"Hobbycraft Club\" loading=\"lazy\" />\n    </div>\n    <div\n        class=\"b-newsletters-group\"\n        data-ref=\"formContent\"\n        data-tau=\"newsletters_group\"\n    >\n        <div class=\"b-newsletters-caption\">\n            \n\n\n    \n    \n\n    <!-- dwMarker=\"content\" dwContentID=\"68678ca98b2894cd01f228eae9\" -->\n    <div class=\"b-newsletter_headline\">\r\n  <h2 class=\"b-newsletters-title\" id=\"footer-signup-title\">Get 15% off your next purchase</h2>\r\n  <p class=\"b-newsletters-copy\">Sign up for emails to get exclusive vouchers and rewards sent straight to you.</p>\r\n</div>\n    <!-- END_dwmarker -->\n\n\n        </div>\n        <div class=\"b-newsletters-form\">\n            <div\n    data-widget=\"inputEmail\"\n    data-widget-event-input='onEmailInput'\n    class=\"b-form_section m-required \"\n    \n        data-id=\"dwfrm_emailsubscribe_email\"\n    \n    data-validation-config=\"{&quot;patterns&quot;:{&quot;parse&quot;:&quot;^([a-zA-Z0-9!#$%&amp;'*+/=?^_`{|}~-]+\\\\.)*[a-zA-Z0-9!#$%&amp;'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$&quot;},&quot;errors&quot;:{&quot;required&quot;:&quot;This field is required.&quot;,&quot;minLength&quot;:&quot;The field Sign up for news should be at least {minlength} characters in length&quot;,&quot;maxLength&quot;:&quot;The field Sign up for news should be no more than 50 characters in length&quot;,&quot;parse&quot;:&quot;Please enter a valid email address&quot;},&quot;mandatory&quot;:true,&quot;maxLength&quot;:50}\"\n>\n\n    \n        \n\n\n<input\ndata-ref=\"field\"\n\nid=\"dwfrm_emailsubscribe_email\"\ntype=\"email\"\nclass=\"b-input b-newsletters-input\"\nplaceholder=\"Enter your email\"\naria-describedby=\"dwfrm_emailsubscribe_email-error\"\n\naria-label=\"Sign up for news\"\n\n\npattern=\"^([a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+\\.)*[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$\"\n\nname='dwfrm_emailsubscribe_email' value required maxLength='50' autocomplete='email' data-event-input='onInput' data-tau='newsletters_email'\n\n/>\n<div\n    role=\"alert\"\n    class=\"b-form_section-message\"\n    data-ref=\"errorFeedback\"\n    id=\"dwfrm_emailsubscribe_email-error\"\n    hidden=\"hidden\"\n></div>\n\n\n\n\n    \n\n</div>\n            <div class=\"b-newsletters-privacy\" data-ref=\"agreeToPrivacy\" hidden=\"hidden\">\n                <div\n    data-widget=\"inputCheckbox\"\n    data-id='agreeToPrivacy'\n    class=\"b-form_section m-required \"\n    \n    data-validation-config=\"{&quot;patterns&quot;:{},&quot;errors&quot;:{&quot;required&quot;:&quot;You must accept Privacy and Cookie Policies before subscription&quot;},&quot;mandatory&quot;:true}\"\n>\n\n    \n        \n<div class=\"b-checkbox\">\n<input\ntype=\"checkbox\"\ndata-ref=\"field\"\n\nclass=\"b-checkbox-input \"\nid=\"dwfrm_emailsubscribe_agreeToPrivacy\"\n\nname='dwfrm_emailsubscribe_agreeToPrivacy' value='true' required data-event-change='validate' data-tau='newsletters_agreeToPrivacy' data-ref='field'\n\ndata-event-blur=\"validate\"\n\naria-describedby=\"dwfrm_emailsubscribe_agreeToPrivacy-error\"\n/>\n<svg class=\"b-checkbox-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 14 14\">\n    <path class=\"b-checkbox-icon_check\" d=\"M5.911 10a.686.686 0 01-.28-.058.725.725 0 01-.236-.168L3.214 7.441a.787.787 0 01-.158-.253.828.828 0 01.158-.851.73.73 0 01.237-.17.689.689 0 01.795.17l1.621 1.742L9.72 3.272a.712.712 0 01.496-.27.683.683 0 01.53.185.772.772 0 01.175.238.819.819 0 01-.095.858L6.463 9.728a.735.735 0 01-.248.2.688.688 0 01-.304.072z\" fill=\"currentColor\"/>\n</svg>\n\n\n    <label\n        class=\"b-form_section-label\"\n        for=\"dwfrm_emailsubscribe_agreeToPrivacy\"\n    >\n        By signing up, you agree to <a class=\"b-form_section-link\" href=\"/help-centre/further-info/privacy-policy.html\" data-widget=\"emitBusEvent\" data-bus-event-type=\"dialogshow\" data-event-click.prevent=\"emitBusEvent\" data-url=\"/help-centre/further-info/privacy-policy.html\" data-modal-config='{\"ariaLabel\": \"Privacy and Cookie Policies\"}' target=\"_blank\">Privacy and Cookie Policies</a>\n    </label>\n\n\n</div>\n<div\n    role=\"alert\"\n    class=\"b-form_section-message\"\n    data-ref=\"errorFeedback\"\n    id=\"dwfrm_emailsubscribe_agreeToPrivacy-error\"\n    hidden=\"hidden\"\n></div>\n\n\n\n\n    \n\n</div>\n            </div>\n            <button\n                type=\"submit\"\n                class=\"b-newsletters-submit b-button\"\n                data-widget=\"button\"\n                data-widget-event-click=\"handleSubmit\"\n                data-event-click.prevent=\"handleClick\"\n                data-id=\"submitButton\"\n                data-tau=\"newsletters_submit\"\n            >\n                Email Me\n            </button>\n        </div>\n    </div>\n\n    <div\n        class=\"b-newsletters-title b-newsletters-message_success\"\n        data-ref=\"successMessage\"\n        hidden=\"hidden\"\n        data-tau=\"newsletters_message_success\"\n    >\n    </div>\n    <div\n        class=\"b-newsletters-text_success\"\n        data-ref=\"subscribeText\"\n    >\n        Just click the link in the email we've sent you to unlock your 15% off and more.&nbsp;​\n    </div>\n</form>\n\n                </div>\n                <div class=\"b-footer-app\">\r\n                    <div class=\"b-footer-app_banners\">\r\n                        <div class=\"b-footer-app_banner\">\r\n                            <a href=\"https://hobbycraft.onelink.me/Xtpv?&af_web_dp=https://www.hobbycraft.co.uk/app/&af_xp=Custom&pid=Website&af_dp=com.hobbycraft.app.hobbycraft://home&c=HobbycraftApp&is_retargeting=true&af_base_params_forward=false&utm_source=website&utm_medium=applandingpage\">\r\n                                <img class=\"b-footer-app_image\" src=\"https://www.hobbycraft.co.uk/on/demandware.static/-/Library-Sites-hobbycraft-uk-content/default/dw1d57109f/images/footer/app-store-logo.png\" width=\"120\" height=\"36\" alt=\"App store\" loading=\"lazy\">\r\n                            </a>\r\n                        </div>\r\n                        <div class=\"b-footer-app_banner\">\r\n                            <a href=\"https://hobbycraft.onelink.me/Xtpv?&af_web_dp=https://www.hobbycraft.co.uk/app/&af_xp=Custom&pid=Website&af_dp=com.hobbycraft.app.hobbycraft://home&c=HobbycraftApp&is_retargeting=true&af_base_params_forward=false&utm_source=website&utm_medium=applandingpage\">\r\n                                <img class=\"b-footer-app_image\" src=\"https://www.hobbycraft.co.