            "mimeType": "application/x-javascript",
            "text": "var isShippingSwitcherClosing,i;if(GlobalE.ShippingSwitcher={Base:GlobalE},GlobalE.ShippingSwitcher.Base.MerchantID=885,GlobalE.ShippingSwitcher.Base.MobileDetectionEnabled=!0,GlobalE.ShippingSwitcher.PopupContent='<div class=\"gePopupsContainer ltr en-GB\"><div class=\"CustomSwitcherPopup\"><div id=\"theContainer\" class=\"glDefaultPopupContainer\"><div class=\"closeBtnContainer\"><span class=\"glClose\" data-action=\"Close\" onclick=\"GlobalE.ShippingSwitcher.Close(event);\"><\\/span><div class=\"img-container\"><div class=\"img-popup\"><\\/div><\\/div><\\/div><div class=\"PopupContainer\"><!--in this place was the glTitle--><div class=\"texts\"><div class=\"glLogo\"><\\/div><div class=\"HeaderOfInfo Switcher\" data-key=\"Header\">Choose your country<\\/div><div class=\"SubheaderOfInfo Switcher\" data-key=\"customResource\" data-key-data=\"HobbycraftSFCC.ShippingSwitcher.Subheader\">Share your location to shop in your own currency as you explore our amazing craft range.<\\/div><div id=\"HeaderJS\" class=\"isModal\" data-key=\"customResource\" data-key-data=\"ME+EM.isModal.V2\" style=\"display: none\">Sorry, we\\'re unable to ship to the chosen country from the UK site, please select your shipping country below.<\\/div><div class=\"glMainContent Switcher\"><div class=\"dropDownRow\" id=\"ge_countryRow\"><div class=\"caption\" data-key=\"customResource\" data-key-data=\"HobbycraftSFCC.ccac.CountryHeader\">Select shipping country<\\/div><div class=\"dropdown\" data-control=\"SelectedCountries\"><select aria-label=\"Change your shipping country\" id=\"gle_selectedCountry\" onchange=\"GlobalE.ShippingSwitcher.OnCountryChanged(this)\"><option data-culturecode=\"\" data-currency=\"80\" data-currency-fixed=\"false\" data-geoperated=\"true\" data-isredirect=\"false\" data-redirecturl=\"\" value=\"AL\">Albania<option data-culturecode=\"\" data-currency=\"6\" data-currency-fixed=\"false\" data-geoperated=\"true\" data-isredirect=\"false\" data-redirectur