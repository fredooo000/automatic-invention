ion initSliderWithProgressBar() {\n  $('.js-slider-with-progress').not('.slick-initialized').slick({\n    slidesToShow: 2.33,\n    slidesToScroll: 1,\n    arrows: true,\n    infinite: false,\n    responsive: [{\n      breakpoint: 768,\n      settings: {\n        arrows: false,\n        slidesToShow: 1.2\n      }\n    }]\n  }).on('afterChange', function (event, slick, currentSlide) {\n    var maxIndex = Math.ceil(slick.slideCount - slick.options.slidesToShow);\n    maxIndex = maxIndex > 0 ? maxIndex : 1;\n    var additionalProgress = currentSlide / maxIndex * 67;\n    var progressVal = Math.min(100, 33 + additionalProgress);\n    var progressBar = $(this).siblings('.slider-progress-bar-container').find('.slider-progress-bar');\n    progressBar.css('width', \"\".concat(progressVal, \"%\"));\n  });\n}\n\n/**\n * Truncates text > 200 characters on mobile, hides the rest,\n * adds a \"Read more\" functionality that displays full text on click.\n * For desktop the text remains full\n */\nfunction manageMobileExpandableText() {\n  $('.expandable-text').each(function () {\n    var $textElement = $(this);\n    var $existingShowFullText = $textElement.find('.show-full-text');\n    if (util.viewport.isMobile()) {\n      var fullText = $textElement.text();\n      if ($existingShowFullText.length || fullText.length < 200) {\n        return;\n      }\n      $textElement.text(fullText.slice(0, 200));\n      var $showFullTextTemplate = $('.show-full-text').first().clone();\n      if (!$showFullTextTemplate.length) {\n        return;\n      }\n      $showFullTextTemplate.find('.more-text').text(fullText.slice(200)).hide();\n      $textElement.append($showFullTextTemplate);\n      $showFullTextTemplate.show();\n      $textElement.on('click', '.show-full-text', function () {\n        $(this).replaceWith($(this).find('.more-text').text());\n      });\n    } else if ($existingShowFullText.length) {\n      var moreText = $existingShowFullText.find('.more-text').text();\n      $existingShowFullText.replaceWith(moreText);\n    }\n  });\n}\n\n/**\n * @private\n * @function\n * @description Adds class ('js') to html for css targeting and loads js specific styles.\n */\nfunction initializeDom() {\n  // add class to html for css targeting\n  $('html').addClass('js');\n  // load js specific styles\n  util.limitCharatersCounter();\n  util.limitCharacters();\n  util.initCharactersCount();\n  // this form subbmitted with default button, so no need to check if it's inited\n  reCaptcha.initRecaptchaOnForm('#custom-form');\n}\nvar global = {\n  init: function init() {\n    contentloader.init();\n    if (document.cookie.length === 0) {\n      $('<div/>').addClass('browser-compatibility-alert').append($('<p/>').addClass('browser-error').html(Resources.COOKIES_DISABLED)).appendTo('#browser-check');\n    }\n    initializeDom();\n    initializeEvents();\n    // init specific global components\n    countries.init();\n    tooltip.init();\n    minicart.init();\n    validator.init();\n    rating.init();\n    searchplaceholder.init();\n    multicurrency.init();\n    loqate.load();\n    cq.init();\n    emailsignup.init();\n\n    // Functions for Navigation\n    navigation.init();\n    stickup.init();\n    iscrollexample.init();\n\n    // Check TLS status if indicated by site preference\n    if (SitePreferences.CHECK_TLS === true) {\n      tls.getUserAgent();\n    }\n    // Init lazy load if switched on\n    if (SitePreferences.LAZYLOAD_ENABLED) {\n      lazyloading.init();\n    }\n    // AmazonPay init\n    amazonpay.amazonPaymentsObject.init();\n    wishlist.initCurrentCustomerWishlist();\n    global.initZmagsCreator();\n    global.initEcomBridge();\n    cjcookie.removeCJCookie();\n  },\n  initZmagsCreator: function initZmagsCreator() {\n    window.__zmags.demandware.quickview = quickview;\n    window.__zmags.demandware.analytics.creator.init = window.__zmags.demandware.analytics.creator.init || __webpack_require__(/*! int_zmagscreator/../static/default/js/zmags-creator-