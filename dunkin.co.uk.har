ot&#x20;Drinks\"\n                                                                  class=\"header-link block w-full !no-underline\">\n                                                                  Hot&#x20;Drinks                                                                </a>\n                                                              </li>\n                                                            </ul>\n                                                                                                    <ul>\n                                                              <li class=\"last-level-child\">\n                                                                <a\n                                                                  href=\"https&#x3A;&#x2F;&#x2F;dunkin.co.uk&#x2F;stores-nav&#x2F;in-store-range&#x2F;cold-drinks\"\n                                                                  title=\"Cold&#x20;Drinks\"\n                                                                  class=\"header-link block w-full !no-underline\">\n                                                                  Cold&#x20;Drinks                                                                </a>\n                                                              </li>\n                                                            </ul>\n                                                                                                    <ul>\n                                                              <li class=\"last-level-child\">\n                                                                <a\n                                                                  href=\"https&#x3A;&#x2F;&#x2F;dunkin.co.uk&#x2F;stores-nav&#x2F;in-store-range&#x2F;bakery\"\n                                                                  title=\"Bakery\"\n                                                                  class=\"header-link block w-full !no-underline\">\n               