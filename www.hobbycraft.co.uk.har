 Idea PDP (and there is a tile with craft attribute)\n\tutils.waitForElement(`.l-pdp:not(.m-idea) .b-product_tile[data-analytics*='\"craft\"']`).then(() => {\n\t\t// Wait for the \"Projects & Ideas for you\" section\n\t\tutils.waitForElement(\"#moreideas\").then((element) => {\n\t\t\tintersectionObserver.observe(element);\n\t\t});\n\t});\n}\n}, {\"id\": \"29969580075\", \"category\": \"other\", \"apiName\": \"25251511284_url_targeting_for_copy_of_bllive_hc058_idea_pdp_trig\", \"name\": \"URL Targeting for [BL-LIVE-95%] [HC-058] [Idea PDP] Trigger\", \"staticConditions\": null, \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"callback\", \"activationCode\": /**\n * Sample Activation Function\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-callback\n * @param {Function} activate - Call this function when you want to activate the page.\n * @param {Object} options - An object containing Page information.\n */\n\nfunction callbackFn(activate, options) {\n\tconst utils = window[\"optimizely\"].get(\"utils\");\n\n\tconst observerConfig = {\n\t\tthreshold: 0.5\n\t};\n\n\tconst intersectionCallback = (entries, observer) => {\n\t\tentries.forEach((entry) => {\n\t\t\tif (entry.isIntersecting) {\n\t\t\t\tobserver.disconnect();\n\t\t\t\tactivate();\n\t\t\t}\n\t\t});\n\t};\n\n\tconst intersectionObserver = new IntersectionObserver(intersectionCallback, observerConfig);\n\n\t// Wait to confirm we are in an Idea PDP (and there is a tile with craft attribute)\n\tutils.waitForElement(`.l-pdp.m-idea .b-product_tile[data-analytics*='\"craft\"']`).then(() => {\n\t\t// Wait for the \"Projects & Ideas for you\" section\n\t\tutils.waitForElement(\"#moreideas\").then((element) => {\n\t\t\tintersectionObserver.observe(element);\n\t\t});\n\t});\n}\n}, {\"id\": \"29987120026\", \"category\": \"other\", \"apiName\": \"25251511284_url_targeting_for_copy_of_bllive_hc058_idea_pdp_all_\", 