            "mimeType": "text/html",
            "compression": 330974,
            "text": "    \n\n\n\n\n\n\n\n\n\n    <div class=\"l-section b-slot_bg m-carousel e64970de77b77f79df482994c7 \"\n        id=\"product-carousel\"\n        data-ref=\"productCarousel\"\n        \n        \n            style=\"background-color:#F5EEE4;\"\n        \n    >\n        <section\n            class=\"b-carousel m-products m-carousel-product b-slot_bg-container\"\n            style=\"\"\n            \n                aria-labelledby=\"section-label-e64970de77b77f79df482994c7\"\n            \n        >\n            \n            \n\n            <div class=\"b-banner_group\">\n\n                \n                    <div id=\"section-label-e64970de77b77f79df482994c7\">\n                        <h3 class=\"b-carousel-title g-squiggle-wrap\">\n    <span class=\"g-squiggle-phrase m-graphic\">Our best offers</span>\n    <span class=\"g-squiggle-phrase m-plain\">Our best offers</span>\n</h3>\n                    </div>\n                \n\n                <div\n                    data-widget=\"carousel\"\n                    class=\"b-carousel-content\"\n                    data-is-products-carousel=\"true\"\n                    data-autoplay-enabled=\"false\"\n                    data-autoplay-stopped=\"true\"\n                    data-autoplay-infinite=\"true\"\n                    data-autoplay-duration=\"5000\"\n                    data-autoplay-label-start=\"Start automatic slide show.\"\n                    data-autoplay-label-stop=\"Stop automatic slide show.\"\n                >\n                    <button\n                        class=\"b-carousel-ctrl m-prev\"\n                        tabindex=\"-1\"\n                        aria-hidden=\"true\"\n                        title=\"Previous\"\n                        data-ref=\"elemPrevButton\"\n                        data-event-click=\"scrollToPrevSlide\"\n                        data-tau=\"carousel_prev\"\n                    >\n                        <svg width=\"24\" height=\"24\" viewBox=\"0