();\n\nif (localStorageAvailable && (forceToShow || !hasAlreadySeenPopup())) {\n    const sendOptimizelyEvent = (eventName) => {\n        window[\"optimizely\"].push({\n            type: \"event\",\n            eventName: eventName\n        });\n\n        if (debugMode) console.log(logInfo, \"Optimizely event sent:\", eventName);\n    };\n\n    let originalScrollPosition = 0;\n    let successfullySubmitted = 0;\n    let emailValue = \"\";\n\n    // A function to force the window back to the original scroll position\n    const lockScrollPosition = () => window.scrollTo(0, originalScrollPosition);\n\n    // Store the last focused element\n    let lastFocusedElement = null;\n\n    // Handle escape key\n    const handleEscapeKey = (e) => {\n        if (e.key === \"Escape\") {\n            closePopup();\n        }\n    };\n\n    // Focus trap: keep focus within the popup\n    const trapFocus = (e) => {\n        const popup = document.querySelector(`.${mainContainerSelectorPrefix}`);\n        if (!popup) return;\n\n        const focusableElements = Array.from(popup.querySelectorAll(\"a[href], button:not([disabled]), input:not([disabled])\")).filter(\n            (el) =>\n                el.offsetParent !== null && // not display:none or detached\n                !el.hasAttribute(\"aria-hidden\") && // not aria-hidden\n                window.getComputedStyle(el).visibility !== \"hidden\"\n        );\n\n        if (!focusableElements.length) return;\n\n        const first = focusableElements[0];\n        const last = focusableElements[focusableElements.length - 1];\n\n        if (e.key === \"Tab\") {\n            if (focusableElements.length === 1) {\n                e.preventDefault();\n                first.focus();\n                return;\n            }\n            if (e.shiftKey) {\n                if (document.activeElement === first || !popup.contains(document.activeElement)) {\n                    e.preventDefault();\n                    last.focus();\n                }\n            } else {\n                if (document.activeElement === last || !popup.contains(document.activeElement)) {\n                    e.preventDefault();\n                    first.focus();\n                }\n            }\n        }\n    };\n\n    // Robust focus trap: ensure focus never leaves the popup\n    let enforceFocusTrap = null;\n    enforceFocusTrap = (e) => {\n        const popup = document.querySelector(`.${mainContainerSelectorPrefix}`);\n        if (!popup) return;\n        if (!popup.contains(e.target)) {\n            const focusableElements = Array.from(popup.querySelectorAll(\"a[href], button:not([disabled]), input:not([disabled])\")).filter(\n                (el) =>\n                    el.offsetParent !== null && // not display:none or detached\n                    !el.hasAttribute(\"aria-hidden\") && // not aria-hidden\n                    window.getComputedStyle(el).visibility !== \"hidden\"\n            );\n\n            if (focusableElements.length) {\n                focusableElements[0].focus();\n            } else {\n                popup.focus();\n            }\n        }\n    };\n\n    // Focus the first focusable element in the popup\n    const focusFirstFocusableElement = () => {\n        const popup = document.querySelector(`.${mainContainerSelectorPrefix}`);\n        if (!popup) return;\n\n        const focusableElements = Array.from(popup.querySelectorAll(\"span, a[href], button:not([disabled]), input:not([disabled])\")).filter(\n            (el) =>\n                el.offsetParent !== null && // not display:none or detached\n                !el.hasAttribute(\"aria-hidden\") && // not aria-hidden\n                window.getComputedStyle(el).visibility !== \"hidden\"\n        );\n\n        if (focusableElements.length) {\n            focusableElements[0].focus();\n        } else {\n            popup.focus();\n        }\n    };\n\n    // Close popup and restore focus\n    const closePopup = () => {\n        document.body.classList.remove(`${mainContainerSelectorPrefix}-show`);\n        // Update ARIA attributes\n        const popup = document.querySelector(`.${mainContainerSelectorPrefix}`);\n        const overlay = document.querySelector(`.${mainContainerSelectorPrefix}-overlay`);\n        if (popup) popup.setAttribute(\"aria-hidden\", \"true\");\n        if (overlay) overlay.setAttribute(\"aria-hidden\", \"true\");\n\n        // Restore focus\n        if (lastFocusedElement) {\n            lastFocusedElement.focus();\n        }\n\n        document.removeEventListener(\"keydown\", handleEscapeKey);\n        document.removeEventListener(\"keydown\", trapFocus);\n        document.removeEventListener(\"focusin\", enforceFocusTrap);\n    };\n\n    // Observe DOM changes on the newsletter footer container\n    const observeFooterNewsletterDOMChanges = (newPopup, originalForm) => {\n        const observer = new MutationObserver((mutationsList, observer) => {\n            // Check for the success message\n            const successMessage = originalForm.querySelector(\".b-newsletters-message_success\");\n\n            if (successMessage && !successMessage.hidden) {\n                // Stop observing\n                observer.disconnect();\n                document.body.classList.add(`${mainContainerSelectorPrefix}-submitted`);\n                newPopup.classList.add(`${mainContainerSelectorPrefix}-submitted`);\n                successfullySubmitted = 1;\n                // Allow page to be scrollable again\n                window.removeEventListener(\"scroll\", lockScrollPosition);\n\n                // Autofocus the close button in the success state\n                setTimeout(() => {\n                    const closeBtn = newPopup.querySelector(\".opt_ext_email_subscribe-popup-button-close\");\n\n                    if (closeBtn) {\n                        closeBtn.focus();\n                    }\n                }, 10);\n            }\n        });\n\n        // Start observing for mutations\n        observer.observe(originalForm, { childList: true, subtree: true });\n    };\n\n    // Handle form submission\n    const handleFormSubmission = (popup, event) => {\n        // Prevent the default form submission\n        event.preventDefault();\n\n        let valid = true;\n\n        // New popup email and checkbox values\n        const email = popup.querySelector(`#${mainContainerSelectorPrefix}_email`);\n        const agreeToPrivacy = popup.querySelector(`#${mainContainerSelectorPrefix}_agreeToPrivacy`);\n\n        // Validation errors container\n        const emailError = document.querySelector(`#${mainContainerSelectorPrefix}_email-error`);\n        const agreeToPrivacyError = document.querySelector(`#${mainContainerSelectorPrefix}_agreeToPrivacy-error`);\n\n        // Check validations before submitting\n        const emailToValidate = (emailValue || email.value || \"\").trim();\n        // Valid email address\n        if (emailToValidate.match(/^([a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+\\.)*[a-zA-Z0-9!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/) == null) {\n            emailError.hidden = false;\n            valid = false;\n        } else {\n            emailError.hidden = true;\n        }\n\n        // Agreed to privacy policy\n        if (!agreeToPrivacy.checked) {\n            agreeToPrivacyError.hidden = false;\n            valid = false;\n        } else {\n            agreeToPrivacyError.hidden = true;\n        }\n\n        // If all validations pass, submit the original form\n        if (valid) {\n            // Find the original form on the page\n            const originalForm = document.querySelector(\"footer .b-footer-content .b-newsletters\");\n\n            // Original form email and checkbox fields\n            const originalEmail = originalForm.querySelector('[name=\"dwfrm_emailsubscribe_email\"]');\n            const originalAgreeToPrivacy = originalForm.querySelector('[name=\"dwfrm_emailsubscribe_agreeToPrivacy\"]');\n            const originalSubmitButton = originalForm.querySelector('button[type=\"submit\"]');\n\n            // Set the original form values based on the popup inputs\n            originalEmail.value = emailToValidate;\n            originalAgreeToPrivacy.checked = agreeToPrivacy.checked;\n\n            // Capture the current scroll position before initiating form submission\n            originalScrollPosition = window.scrollY;\n\n            // Submit the original form programmatically\n            originalSubmitButton.click();\n\n            // Disallow page to scroll until form is fully submitted\n            window.addEventListener(\"scroll\", lockScrollPosition);\n        }\n    };\n\n    // Handle close actions\n    const handleCloseActions = () => {\n        const closeIcon = document.querySelector(`.${mainContainerSelectorPrefix}-close`);\n        const overlay = document.querySelector(`.${mainContainerSelectorPrefix}-overlay`);\n        const closeButton = document.querySelector(`.${mainContainerSelectorPrefix}-button-close`);\n\n        closeIcon.addEventListener(\"click\", () => {\n            closePopup();\n            sendOptimizelyEvent(\"newsletter-popup-ctr-on-close-icon\");\n            sendOptimizelyEvent(successfullySubmitted ? \"newsletter-popup-ctr-on-close-icon-success-state\" : \"newsletter-popup-ctr-on-close-icon-signup-state\");\n        });\n\n        overlay.addEventListener(\"click\", () => {\n            closePopup();\n            sendOptimizelyEvent(\"newsletter-popup-ctr-on-overlay\");\n            sendOptimizelyEvent(successfullySubmitted ? \"newsletter-popup-ctr-on-overlay-success-state\" : \"newsletter-popup-ctr-on-overlay-signup-state\");\n        });\n\n        closeButton.addEventListener(\"click\", () => {\n            closePopup();\n            sendOptimizelyEvent(\"newsletter-popup-ctr-on-close-this-pop-up-cta\");\n        });\n    };\n\n    utils.waitForElement(\"body\").then((bodyElement) => {\n        try {\n            bodyElement.insertAdjacentHTML(\"beforeend\", widget.$html);\n\n            const newPopup = document.querySelector(`.${mainContainerSelectorPrefix}`);\n\n            // Wait for the original form to be loaded on the page\n            utils.waitForElement(\".b-footer-newsletters\").then((originalForm) => {\n                // Popup\n                const newPopupForm = newPopup.querySelector(`.${mainContainerSelectorPrefix}-form`);\n                const emailInput = newPopupForm.querySelector(`#${mainContainerSelectorPrefix}_email`);\n                if (emailInput) {\n                    emailInput.addEventListener(\"input\", (e) => {\n                        emailValue = (e.target.value || \"\").trim();\n                    });\n                }\n\n                // Store the element that had focus before the popup opened\n                lastFocusedElement = document.activeElement;\n\n                // Show the popup after a certain amount of time, but only if Osano dialog is not present\n                const showPopupWhenReady = () => {\n                    let osanoDialogGoneTime = null;\n\n                    const checkInterval = setInterval(() => {\n                        // Check if Osano dialog is still present\n                        if (!isOsanoDialogPresent()) {\n                            // Osano dialog is gone, start timing\n                            if (osanoDialogGoneTime === null) {\n                                osanoDialogGoneTime = Date.now();\n                            }\n\n                            // Check if it's been gone for at least 5 seconds\n                            if (Date.now() - osanoDialogGoneTime >= 5000) {\n                                // Osano dialog has been gone for 5+ seconds, show the newsletter popup\n                                clearInterval(checkInterval);\n\n                                let storageWriteSucceeded = false;\n                                try {\n                                    window.localStorage.setItem(widget.uniqueLocalStorageId, \"true\");\n                                    storageWriteSucceeded = window.localStorage.getItem(widget.uniqueLocalStorageId) === \"true\";\n                                } catch (e) {\n                                    if (debugMode) console.warn(logInfo, \"Unable to write localStorage:\", e.message);\n                                }\n\n                                if (!storageWriteSucceeded) {\n                                    return;\n                                }\n\n                                document.body.classList.add(`${mainContainerSelectorPrefix}-show`);\n                                // Update ARIA attributes when popup opens\n                                const popup = document.querySelector(`.${mainContainerSelectorPrefix}`);\n                                const overlay = document.querySelector(`.${mainContainerSelectorPrefix}-overlay`);\n                                if (popup) popup.setAttribute(\"aria-hidden\", \"false\");\n                                if (overlay) overlay.setAttribute(\"aria-hidden\", \"false\");\n\n                                // Focus the first focusable element in the popup\n                                focusFirstFocusableElement();\n\n                                // Fallback: if nothing is focused, focus the popup itself\n                                setTimeout(() => {\n                                    const popup = document.querySelector(`.${mainContainerSelectorPrefix}`);\n                                    if (popup && (!document.activeElement || !popup.contains(document.activeElement))) {\n                                        popup.focus();\n                                    }\n                                }, 10);\n\n                                // Add keyboard event listeners\n                                document.addEventListener(\"keydown\", handleEscapeKey);\n                                document.addEventListener(\"keydown\", trapFocus);\n                                document.addEventListener(\"focusin\", enforceFocusTrap);\n\n                                sendOptimizelyEvent(\"newsletter-popup-popup-shown\");\n                            }\n                        } else {\n                            // Osano dialog is back, reset the timer\n                            osanoDialogGoneTime = null;\n                        }\n                    }, 1000); // Check every 1s\n                };\n\n                // Start checking after the timer delay\n                setTimeout(showPopupWhenReady, widget.timer);\n\n                // Handle close actions\n                handleCloseActions();\n\n                // Listen for the submit event on the popup form\n                newPopupForm.addEventListener(\"submit\", (event) => {\n                    handleFormSubmission(newPopup, event);\n                });\n\n                // Call the function to start observing for DOM changes\n                observeFooterNewsletterDOMChanges(newPopup, originalForm);\n            });\n        } catch (e) {\n            if (debugMode) console.error(logInfo, e.message);\n        }\n    });\n}\n\n      },\n      hideFn: function(event) {\n        var $ = window.optimizely.get('jquery');\n        var widget = event.data.config;\n        widget.$id = \"5121827425484800\";\n        widget.$instance = event.data.id;\n        widget.$fieldDefaults = [{\"name\":\"timer\",\"default_value\":1000},{\"name\":\"headline\",\"default_value\":\"Lorem ipsum dolor sit ame\"},{\"name\":\"headlineSuccess\",\"default_value\":\"Lorem ipsum dolor sit ame\"},{\"name\":\"description\",\"default_value\":\"Lorem ipsum dolor sit ame consectetur adip iscing elit sed\"},{\"name\":\"descriptionSuccess\",\"default_value\":\"Lorem ipsum dolor sit ame consectetur adip iscing elit sed\"},{\"name\":\"emailPlaceholder\",\"default_value\":\"Emai