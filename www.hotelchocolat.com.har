toggle value\n        inStockOnly = !inStockOnly;\n      }\n      if (resetlink) {\n        inStockOnly = false;\n      }\n      // Add 'In Stock Only' search parameter\n      stringUrl = util.appendParamToURL(stringUrl, 'inStockOnly', inStockOnly);\n      var $filterElement = $(this);\n      // Identify if the filter items and trigger linchpin actions\n      var isFilterElement = !$filterElement.hasClass('display-all');\n      var uri = util.getUri(stringUrl);\n      if (uri.query.length > 1) {\n        if (typeof window.history.pushState === 'function') {\n          updateProductListing(uri.query.substring(1), false, function () {\n            // Callback function to call after applying filters\n            if (SitePreferences.GTM_ENABLED && isFilterElement) {\n              if ($('input[name=searchPhrase]').length > 0) {\n                if (window.location.search.indexOf('&') === -1) {\n                  linchpin.triggerSearchClearFilters();\n                } else {\n                  linchpin.triggerSearchFilterEvent($filterElement);\n                }\n              } else {\n                linchpin.triggerCategoryFilterEvent($filterElement);\n              }\n            }\n          });\n        } else {\n          window.location.hash = uri.query.substring(1);\n        }\n      } else {\n        if (typeof window.history.pushState === 'function') {\n          updateProductListing('', true);\n        } else {\n          window.location.href = this.href;\n        }\n      }\n      return false;\n    }\n  });\n\n  // handle events for updating grid from search\n  $main.on('click', '#hamper-refinement-search button', function (e) {\n    e.preventDefault();\n    var $form = $(this).closest('form');\n    var $query = $form.find('input[name=\"q\"]');\n    var uri = util.getUri($form.attr('action'));\n    var url = uri.query.substring(1) + '&q=' + $query.val();\n    // GTM linchpin analytics\n    if (SitePreferences.GTM_ENABLED) {\n      hampers.hamperSearchEvent