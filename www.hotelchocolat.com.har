exOf(productID) > 0 || productName && impressionKeys.indexOf(productName) > 0) {\n        return listName;\n      }\n    }\n    return impressions.lastImpressionList || impressions.getPageName();\n  },\n  /*\n  \tShared method to get page name for tracking\n  */\n  getPageName: function getPageName() {\n    if (this.pageName) {\n      return this.pageName;\n    }\n    this.pageName = window.pageContext && window.pageContext.title ? window.pageContext.title : 'OTHER';\n    this.pageName = this.pageName.trim().replace(/[^0-9a-z \\-\\|]/gi, '');\n    try {\n      var pageDataInput = $(document).find('input[name=\"pageLoadData\"]');\n      if (!pageDataInput.length) {\n        return impressions.pageName;\n      }\n      var pageLoadData = JSON.parse(pageDataInput.val());\n      this.pageName = pageLoadData.page_name || this.pageName;\n      this.pageName = this.pageName.trim().replace(/[^0-9a-z \\-\\|]/gi, '');\n    } catch (e) {\n      console.warn(e);\n    }\n    return this.pageName;\n  },\n  /*\n  \tMethod to get product impression data fron content tile\n  \tsome carousel are not related to products and should be filtered here\n  \tno object returned in such case\n  */\n  getProductImpressionFromContent: function getProductImpressionFromContent($contentTile) {\n    var productImpression = {};\n    try {\n      var $productLink = $contentTile.find('a');\n      var $headingContent = $contentTile.find('.heading');\n      // it's a lot to check, so we rely on try/catch mostly in this section\n      if (!$productLink.length || !$headingContent.length) {\n        return;\n      }\n      var productSKU = $productLink.attr('href').split('pid=')[1];\n      var listType = $contentTile.closest('[impression-list-type]').attr('impression-list-type');\n      var itemIndex = $contentTile.attr('impression-position');\n      if (!productSKU || !listType || !itemIndex) {\n        window.console.debug('tile without product', productSKU, listType, itemIndex);\n        return;\n      }\n      var headingContentParts = $headingContent.text().split(window.Resources.CURRENCY_SYMBOL);\n      var productName = headingContentParts[0].trim();\n      var productPrice = headingContentParts[1].replace(/\\D.\\D+\\D+/g, '').trim();\n      productImpression['impression_position'] = itemIndex;\n      productImpression['impression_price'] = productPrice;\n      productImpression['impression_product_SKU'] = productSKU;\n      productImpression['impression_product_brand'] = 'Hotel Chocolat';\n      productImpression['impression_product_category'] = 'No Category Available (Carousel Impression)';\n      productImpression['impression_product_name'] = productName;\n      productImpression['impression_product_variant'] = productName;\n      productImpression['impression_list'] = listType + ' - ' + impressions.getPageName();\n    } catch (e) {\n      // do not return object in case of error, to avoid another iteration\n      window.console.warn(e);\n      return;\n    }\n    return productImpression;\n  },\n  /*\n  \tMethod to get product impression data fron product tile\n  \tif any of required markers missing it will return null\n  */\n  getProductImpressionFromTile: function getProductImpressionFromTile($productTile) {\n    var productImpression = {};\n    try {\n      var $impressionInput = $productTile.find('input[name=productImpression]');\n      var listType = $productTile.closest('[impression-list-type]').attr('impression-list-type');\n      var itemIndex = $productTile.attr('impression-position');\n      if (!$impressionInput.length || !listType || !itemIndex) {\n        return;\n      }\n      // to get listing, we need to know type of container and related item index\n      var impressionData = JSON.parse($impressionInput.val());\n      productImpression['impression_position'] = itemIndex;\n      productImpression['impression_price'] = impressionData.impression_price;\n      productImpression['impression_product_SKU'] = impressionData.impression_product_SKU;\n      productImpression['impression_product_brand'] = impressionData.impression_product_brand;\n      productImpression['impression_product_category'] = impressionData.impression_product_category;\n      productImpression['impression_product_name'] = impressionData.impression_product_name;\n      productImpression['impression_product_variant'] = impressionData.impression_product_variant;\n      productImpression['impression_list'] = listType + ' - ' + impressions.getPageName();\n    } catch (e) {\n      // do not return object in case of error, to avoid another iteration\n      window.console.warn(e);\n      return;\n    }\n    return productImpression;\n  },\n  /*\n  \tEnable method to get content from the product tile of different format\n  \treturn null if tile not related to product\n  */\n  getProductImpression: function getProductImpression($productTile) {\n    var productImpression = $productTile.data('impressionObj');\n    if (productImpression) {\n      return productImpression['impression_product_SKU'] ? productImpression : null;\n    }\n    // collect object and update storage for further use\n    productImpression = this.getProductImpressionFromTile($productTile) || this.getProductImpressionFromContent($productTile);\n    $productTile.data('impressionObj', productImpression || {});\n    return productImpression;\n  },\n  promoBannerImpression: function promoBannerImpression() {\n    if ($('.banner-content').length > 0) {\n      var obj = {\n        'event': 'promoBannerImpression',\n        'banner_creative': $('input[name=bannerCreative]').val() ? $('input[name=bannerCreative]').val() : '',\n        'banner_position': $('input[name=bannerPosition]').val() ? $('input[name=bannerPosition]').val() : ''\n      };\n      dataLayer.push(obj);\n    }\n  },\n  /*\n  \timpressions tracking consolidated here\n  \tspecific containers present on page, each of them should be reported individually\n  \tcontainer could be updated - means tile inside it would be in different position or with different content\n  \tthat means tile would hold state of being reported, likely container update would reset all insides but leave it unchaged\n  \t\n  \tcurrently we have 3 types of containers:\n  \t- carousels build via content (slick or no slick items) \n  \t- carousels build via code (einstain or basic)\n  \t- search results page - common tiles\n  \t- PDP components also\n  \t\n  \tthat means in every case we have tile\n  \tif that is code based it would include ('input[name=productImpression]')\n  \totherwise we could treat as content based and attempt parsing\n  \titem position based on tile location inside container\n  \t\n  \tin case of search results requirment to keep impressions reported limited to 24\n  \tbut actual hard limit is about 50, \n  */\n  trackImpressions: function trackImpressions() {\n    // identify all impression containers and flag their type\n    // first type is search page container\n    var $impressionContainers = $('.search-result-content, .search-result-items');\n    $impressionContainers.each(function () {\n      $(this).attr('impression-list-type', 'PLP');\n    });\n\n    // next is einstain carousels\n    $impressionContainers = $('.content-tiles-slider-container-deferred, .recommendations.recommendations-pdp');\n    $impressionContainers.each(function (carouselIndex) {\n      $(this).attr('impression-list-type', 'EIN - ' + (carouselIndex + 1));\n    });\n\n    // other carousels, content or slot based and product components on PDP\n    $impressionContainers = $('.tiles-container, .component-content, .content-tiles-slider-container').filter(':not([impression-list-type])');\n    $impressionContainers.each(function (carouselIndex) {\n      $(this).attr('impression-list-type', 'CAR - ' + (carouselIndex + 1));\n    });\n\n    // now grab all containers and triggger impressions reporting\n    $impressionContainers = $('[impression-list-type]');\n    $impressionContainers.each(function () {\n      // selector build based on site tiles, can be extended to cover more cases, but need to carefully consider tree to avoid duplicates\n      var $productTiles = $(this).find('.content-tile-wrapper, .content-tile.slick-slide, .recommendation-item .product-tile, .grid-tile, .product-component-item');\n      var productImpressions = [];\n      // include impressions that are not collected yet, updating visibility\n      $productTiles.each(function (itemIndex, productTile) {\n        var $productTile = $(productTile);\n        // filtering done here to keep positions accurate if more tiles added\n        if ($productTile.attr('impression-seen')) {\n          return;\n        }\n        $productTile.attr('impression-position', itemIndex + 1);\n        $productTile.attr('impression-seen', '0');\n        var productImpression = impressions.getProductImpression($productTile);\n        if (productImpression) {\n          $productTile.attr('impression-seen', '1');\n          productImpressions.push(productImpression);\n        }\n      });\n\n      // handle reporting limit\n      var impressionsLimit = 24;\n      for (var i = 0, reportBatch; i < productImpressions.length; i += impressionsLimit) {\n        reportBatch = productImpressions.slice(i, i + impressionsLimit);\n        if (reportBatch.length) {\n          dataLayer.push({\n            'event': 'productImpressionTracking',\n            'button_ID': '',\n            'impressions': reportBatch\n          });\n        }\n      }\n    });\n\n    // attach global event using selector targeting seen impressions, that makes sure they are valid\n    $(document).off('click.impression').on('click.impression', '[impression-seen=\"1\"]', impressions.productClickTrackingEvent);\n    $(document).off('click.noimpression').on('click.noimpression', '[impression-seen=\"0\"]', impressions.productClickResetEvent);\n  },\n  // event handler for click on carousel item\n  productClickTrackingEvent: function productClickTrackingEvent(e) {\n    var $th