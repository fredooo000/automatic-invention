n<script type=\"template/mustache\" data-ref=\"stockMessageTemplate\">\n    <div class=\"b-product_tile-stock_container\" data-ref=\"stockMessage\">\n        {{#showStockMessage}}\n        <div class=\"b-product_tile-low_stock\">\n            {{stockMessage}}\n        </div>\n        {{/showStockMessage}}\n    </div>\n</script>  \n\n    \n    \n<div class=\"b-product_tile-cc_container\" data-ref=\"ccMessage\">\n    \n</div>\n\n<!-- Include mustache template for dynamic CC message updates -->\n<script type=\"template/mustache\" data-ref=\"ccMessageTemplate\">\n    <div class=\"b-product_tile-cc_container\" data-ref=\"ccMessage\">\n        {{#showCCMessage}}\n        <div class=\"b-product_tile-badge b-promotion m-badge\">\n            <div class=\"b-promotion-message\">\n                {{ccMessage}}\n            </div>\n        </div>\n        {{/showCCMessage}}\n    </div>\n</script>  \n\n    \n    \n<div class=\"b-product_tile-max_quantity_container\" data-ref=\"maxQuantityMessage\">\n    \n</div>\n\n<!-- Include mustache template for dynamic max quantity message updates -->\n<script type=\"template/mustache\" data-ref=\"maxQuantityMessageTemplate\">\n    <div class=\"b-product_tile-max_quantity_container\" data-ref=\"maxQuantityMessage\">\n        {{#showMaxQuantity}}\n        <div class=\"b-product_tile-max_quantity b-product_tile-low_stock\" data-tau=\"max_quantity_info\">\n            {{maxQuantityMessage}}\n        </div>\n        {{/showMaxQuantity}}\n    </div>\n</script>\n\n\n\n\n    \n\n    \n\n    \n\n    \n    \n    \n\n    \n\n    \n        <button\n    type=\"button\"\n    class=\"b-wishlist_button m-tile m-add\"\n    data-id=\"addToWishlist\"\n    data-widget=\"buttonWithIcon\"\n    data-product-id=\"cricut-how-to-personalise-a-mug\"\n    data-event-click=\"handleClick\"\n    data-widget-event-click=\"wishlistButtonClickHandler\"\n    data-product-name=\"Cricut: How to Make a Personalised Letter Mug\"\n    data-is-product-set=\"true\" \n    data-clas