t} options - An object containing Page information.\n */\n\nfunction callbackFn(activate, options) {\n\tconst utils = window.optimizely.get(\"utils\");\n\tutils.waitForElement(\".l-pdp .b-product_details-rating .b-rating-average\").then(() => {\n\t\tactivate();\n\t});\n}\n}, {\"id\": \"5096347544584192\", \"category\": \"other\", \"apiName\": \"25251511284_srp_search_results_page\", \"name\": \"SRP (Search Results Page)\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/search/?q=\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5116961034600448\", \"category\": \"other\", \"apiName\": \"25251511284_home_delivery_basket_page_view__referrer_checkout\", \"name\": \"[Home Delivery] Basket Page View - Referrer Checkout\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/cart/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": function pollingFn() {\n\n  // Check if the referrer includes the specified URL\n  const isReferrerValid = document.referrer.includes(\"https://www.hobbycraft.co.uk/checkout\");\n\n  // Check if the element exists with the specific aria-label and aria-selected attributes\n  const el = document.querySelector('[aria-label=\"Home Delivery\"][aria-selected=\"true\"]')\n  const isElementSelected = el  && el.classList.contains(\"m-active\") && document.querySelector('[aria-label=\"Click & Collect\"][aria-selected=\"true\"]') === null;\n  \n\n  // Return true if all conditions are met\n  return isReferrerValid && isElementSelected;\n}\n}, {\"id\": \"5128182513270784\", \"category\": \"other\", \"apiName\": \"25251511284_hc0602_pdp\", \"name\": \"[HC-060.2] PDP\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"#hc-060-2-pdp\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": /**\n * Sample Polling Function\n * Supply an expression to return a boolean inside a function.\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-polling\n */\n\nfunction pollingFn() {\n  return document.querySelector(\".l-pdp:not(.m-idea)\") !== null;\n}\n}, {\"id\": \"5242201542754304\", \"category\": \"other\", \"apiName\": \"25251511284_home_delivery_checkout__payment_details\", \"name\": \"[Home Delivery] Checkout - Payment Details\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/checkout/?step=billing\"}], [\"or\", {\"type\": \"element_present\", \"value\": \".b-checkout_step-section [aria-label=\\\"Delivery Details\\\"]\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5268708638064640\", \"category\": \"other\", \"apiName\": \"25251511284_cc_checkout__collection_details\", \"name\": \"[C&C] Checkout - Collection Details\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/checkout/?step=shipping\"}], [\"or\", {\"type\": \"element_present\", \"value\": \".b-checkout_step-section [aria-label=\\\"Collection Details\\\"]\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5363680926236672\", \"category\": \"other\", \"apiName\": \"25251511284_pdp_with_rewards\", \"name\": \"[PDP] With rewards\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"callback\", \"activationCode\": /**\n * Sample Activation Function\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-callback\n * @param {Function} activate - Call this function when you want to activate the page.\n * @param {Object} options - An object containing Page information.\n */\n\nfunction callbackFn(activate, options) {\n\tconst utils = window[\"optimizely\"].get(\"utils\");\n\n\tlet observer;\n\tlet disconnectTimeoutId;\n\n\tconst disconnectObserver = () => {\n\t\tif (disconnectTimeoutId) {\n\t\t\tclearTimeout(disconnectTimeoutId);\n\t\t\tdisconnectTimeoutId = null;\n\t\t}\n\t\tif (observer) {\n\t\t\tobserver.disconnect();\n\t\t\tobserver = null;\n\t\t}\n\t};\n\n\tconst checkForRewards = () => {\n\t\tconst mainContainer = document.querySelector(\".l-pdp\");\n\n\t\t// Check if we are in a PDP and has the rewards section\n\t\tif (mainContainer && !mainContainer.classList.contains(\"m-idea\")) {\n\t\t\tif (mainContainer.querySelector(\"section.b-pdp_rewards.m-clickable\")) {\n\t\t\t\tdisconnectObserver();\n\t\t\t\tactivate();\n\t\t\t}\n\t\t}\n\t};\n\n\tutils.waitForElement(\"body\").then(() => {\n\t\tobserver = new MutationObserver(checkForRewards);\n\t\tobserver.observe(document.body, { childList: true, subtree: true });\n\n\t\tif (document.readyState === \"complete\") {\n\t\t\tdisconnectTimeoutId = setTimeout(disconnectObserver, 10000);\n\t\t} else {\n\t\t\twindow.addEventListener(\n\t\t\t\t\"load\",\n\t\t\t\t() => {\n\t\t\t\t\tdisconnectTimeoutId = setTimeout(disconnectObserver, 10000);\n\t\t\t\t},\n\t\t\t\t{ once: true }\n\t\t\t);\n\t\t}\n\n\t\tcheckForRewards();\n\t});\n}\n}, {\"id\": \"5376440384880640\", \"category\": \"other\", \"apiName\": \"25251511284_gifts_clp\", \"name\": \"Gifts CLP\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/gifts/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5388715237834752\", \"category\": \"other\", \"apiName\": \"25251511284_pdp_kids_category\", \"name\": \"[PDP] Kids Category\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": /**\n * Sample Polling Function\n * Supply an expression to return a boolean inside a function.\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-polling\n */\n\nfunction pollingFn() {\n  return document.querySelector('.l-pdp:not(.m-idea) ul.b-breadcrumbs-list a.b-breadcrumbs-link[href=\"https://www.hobbycraft.co.uk/kids/\"]') !== null;\n}\n}, {\"id\": \"5432620067061760\", \"category\": \"other\", \"apiName\": \"25251511284_hcp701_black_friday_landing_page\", \"name\": \"[hcp-701] Black Friday Landing Page\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/black-friday-deals/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5509570404024320\", \"category\": \"other\", \"apiName\": \"25251511284_home_delivery_checkout__complete_order\", \"name\": \"[Home Delivery] Checkout - Complete Order\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/checkout/?step=summary\"}], [\"or\", {\"type\": \"element_present\", \"value\": \".b-checkout_step-section [aria-label=\\\"Delivery Details\\\"]\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5534009405472768\", \"category\": \"other\", \"apiName\": \"25251511284_cc_checkout__complete_order\", \"name\": \"[C&C] Checkout - Complete Order\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/checkout/?step=summary\"}], [\"or\", {\"type\": \"element_present\", \"value\": \".b-checkout_step-section [aria-label=\\\"Collection Details\\\"]\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5535800994037760\", \"category\": \"other\", \"apiName\": \"25251511284_popup_pdp_wait_for_clublogin_data\", \"name\": \"[Popup] PDP (wait for club/login data)\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": /**\n * Combined Activation Function\n * Waits for BOTH audience data readiness AND the target PDP element to exist\n * before activating. Uses event-driven approach with polling fallback.\n */\nfunction callbackFn(activate, options) {\n  var activated = false;\n  var timer;\n  var maxChecks = 600;\n  var checks = 0;\n\n  function cleanup() {\n    window.removeEventListener(\"bl:optimizely-audience-data-ready\", onAudienceReady);\n    if (timer) clearInterval(timer);\n  }\n\n  function audienceReady() {\n    var state = window.BL_HC_optimizelyAudienceState;\n    return !!(state && state.ready === true);\n  }\n\n  function domReady() {\n    return document.querySelector(\".l-pdp:not(.m-idea)\") !== null;\n  }\n\n  function tryActivate() {\n    if (activated) return;\n    if (audienceReady() && domReady()) {\n      activated = true;\n      cleanup();\n      activate();\n    }\n  }\n\n  function onAudienceReady() {\n    tryActivate();\n  }\n\n  // Fast path: both conditions already met\n  tryActivate();\n  if (activated) return;\n\n  // Listen for audience-ready event\n  window.addEventListener(\"bl:optimizely-audience-data-ready\", onAudienceReady);\n\n  // Polling fallback — covers both the DOM check and audience state\n  timer = setInterval(function() {\n    tryActivate();\n    if (activated) return;\n\n    checks += 1;\n    if (checks >= maxChecks) {\n      cleanup();\n    }\n  }, 50);\n}\n}, {\"id\": \"5545227973296128\", \"category\": \"other\", \"apiName\": \"25251511284_logged_out_basket\", \"name\": \"[Logged out] Basket\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/cart/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": /**\n * Sample Polling Function\n * Supply an expression to return a boolean inside a function.\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-polling\n */\n\nfunction pollingFn() {\n  return sessionStorage.getItem(\"BL-HC-login-status\") === 'guest';\n}\n}, {\"id\": \"5562029440761856\", \"category\": \"other\", \"apiName\": \"25251511284_hc072_pages_with_search_header_opened_and_input_star\", \"name\": \"[HC-072] Pages with search header opened and input started\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"callback\", \"activationCode\": /**\n * Sample Activation Function\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-callback\n * @param {Function} activate - Call this function when you want to activate the page.\n * @param {Object} options - An object containing Page information.\n */\n\n// This is when the search bar is opened and input is started\nfunction trigger(activate, options) {\n\tvar utils = window.optimizely.get(\"utils\");\n\n\tutils.waitForElement(\"button.b-search_input-clear.m-visible\").then(function () {\n\t\tactivate();\n\t});\n}\n}, {\"id\": \"5623352119787520\", \"category\": \"other\", \"apiName\": \"25251511284_clp_kids\", \"name\": \"[CLP] Kids\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/fun-starts-here.html\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5629838275379200\", \"category\": \"other\", \"apiName\": \"25251511284_pdp__seen_reviews_section\", \"name\": \"PDP - Seen Reviews section\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"callback\", \"activationCode\": /**\n * Sample Activation Function\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-callback\n * @param {Function} activate - Call this function when you want to activate the page.\n * @param {Object} options - An object containing Page information.\n */\n\nfunction callbackFn(activate, options) {\n\tvar utils = window.optimizely.get(\"utils\");\n\tvar isMobile = window.matchMedia(\"(max-width: 767px)\").matches;\n\n\tutils.waitForElement(\".l-pdp:not(.m-idea) .l-pdp-reviews\").then(function (reviewsSection) {\n\t\tlet hasTriggered = false;\n\n\t\tconst scrollHandler = function () {\n\t\t\tconst reviewsTop = reviewsSection.getBoundingClientRect().top;\n\t\t\tconst scrolledPastReviews = reviewsTop + (isMobile ? 700 : 400) <= window.innerHeight;\n\n\t\t\tif (!hasTriggered && scrolledPastReviews) {\n\t\t\t\thasTriggered = true;\n\t\t\t\tactivate();\n\n\t\t\t\twindow.removeEventListener(\"scroll\", scrollHandler);\n\t\t\t}\n\t\t};\n\n\t\twindow.addEventListener(\"scroll\", scrollHandler);\n\t});\n}\n}, {\"id\": \"5655221267857408\", \"category\": \"other\", \"apiName\": \"25251511284_url_targeting_for_blqa_hc122_basket_dsv_move_fulfilm\", \"name\": \"URL Targeting for [BL-QA] [HC-122] [Basket] [DSV] Move fulfilment options selector\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/cart/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": /**\n * Sample Polling Function\n * Supply an expression to return a boolean inside a function.\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-polling\n */\n\nfunction pollingFn() {\n  return document.querySelector('.l-cart .b-summary_section .b-tab_list button') !== null;\n}\n}, {\"id\": \"5702399017353216\", \"category\": \"other\", \"apiName\": \"25251511284_popup_sitewide_excluding_pdp_wait_for_clublogin_data\", \"name\": \"[Popup] Sitewide excluding PDP (wait for club/login data)\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}], [\"not\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"/checkout/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"/account/\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/profile/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/profile/\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/changepassword/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/changepassword/\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/orders/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/orders/\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/address-book/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/address-book/\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/payments/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/payments/\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/wishlist/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/wishlist/\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Account-ShowDownloads\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Account-Subscription\"}]]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"callback\", \"activationCode\": /**\n * Combined Activation Function\n * Waits for audience data readiness AND a non-PDP page (footer present, no\n * `.l-pdp:not(.m-idea)`) before activating. PDP pages are excluded and polling\n * stops once footer confirms the page type. Uses event-driven approach with\n * polling fallback.\n */\nfunction callbackFn(activate, options) {\n  var activated = false;\n  var excluded = false;\n  var timer;\n  var maxChecks = 600;\n  var checks = 0;\n\n  function cleanup() {\n    window.removeEventListener(\"bl:optimizely-audience-data-ready\", onAudienceReady);\n    if (timer) clearInterval(timer);\n  }\n\n  function audienceReady() {\n    var state = window.BL_HC_optimizelyAudienceState;\n    return !!(state && state.ready === true);\n  }\n\n  /**\n   * @returns {'waiting'|'excluded'|'ready'}\n   *   waiting  — footer not in DOM yet, keep polling\n   *   excluded — PDP page, stop without activating\n   *   ready    — footer present and not a PDP, eligible to activate\n   */\n  function getDomState() {\n    if (!document.querySelector(\"footer\")) {\n      return \"waiting\";\n    }\n    if (document.querySelector(\".l-pdp:not(.m-idea)\")) {\n      return \"excluded\";\n    }\n    return \"ready\";\n  }\n\n  function tryActivate() {\n    if (activated || excluded) return;\n\n    var domState = getDomState();\n\n    if (domState === \"excluded\") {\n      excluded = true;\n      cleanup();\n      return;\n    }\n\n    if (domState === \"ready\" && audienceReady()) {\n      activated = true;\n      cleanup();\n      activate();\n    }\n  }\n\n  function onAudienceReady() {\n    tryActivate();\n  }\n\n  // Fast path: already eligible or excluded\n  tryActivate();\n  if (activated || excluded) return;\n\n  window.addEventListener(\"bl:optimizely-audience-data-ready\", onAudienceReady);\n\n  timer = setInterval(function() {\n    tryActivate();\n    if (activated || excluded) return;\n\n    checks += 1;\n    if (checks >= maxChecks) {\n      cleanup();\n    }\n  }, 50);\n}\n}, {\"id\": \"5713617228660736\", \"category\": \"other\", \"apiName\": \"25251511284_hc102_overall_cvr_when_any_filter_has_been_applied_o\", \"name\": \"[HC-102] Overall CVR (when any filter has been applied on a PLP)\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/order-confirmation/\"}, {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://stg-sfcc.hobbycraft.co.uk/order-confirmation/\"}], [\"or\", {\"type\": \"custom_code\", \"value\": /**\n * Sample JavaScript Condition\n * This function is called after the page is triggered.\n * It should return true when the page is ready to activate.\n *\n * Editor now supports ES6 compliant code. Note that adding ES6\n * specific code to an experiment will break for users running\n * ES5-only browsers as code entered is not transpiled down to ES5.\n */\n\nfunction jsCondition() {\n\t// Check if filter was ever interacted with (HC-102)\n\tconst filterInteracted = localStorage.getItem(\"HC-102-filter-interacted\");\n\t\n\treturn filterInteracted === \"true\";\n}\n\n}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5737850000375808\", \"category\": \"other\", \"apiName\": \"25251511284_hc074_pdp__not_sewing_machines_with_comparison_table\", \"name\": \"[HC-074] PDP - Not sewing machines with comparison tables\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": /**\n * Sample Polling Function\n * Supply an expression to return a boolean inside a function.\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-polling\n */\n\nfunction pollingFn() {\n\treturn document.querySelector(\".l-pdp:not(.m-idea)\") !== null && document.querySelector('a.b-breadcrumbs-link[href$=\"/sewing/sewing-machines/\"]') == null && document.querySelector(\"#comparison-carousel\") == null;\n}\n}, {\"id\": \"5787064877187072\", \"category\": \"other\", \"apiName\": \"25251511284_offers_plp\", \"name\": \"[Offers PLP] Main page only (excludes filtered page)\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/offers/\"}], [\"not\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/offers/?prefn1=\"}]]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": []}, {\"id\": \"5964009745154048\", \"category\": \"other\", \"apiName\": \"25251511284_sitewide_excluding_app_web_view_pages__home_\", \"name\": \"Sitewide (excluding App Web View Pages) + home \", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}], [\"not\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"/checkout/\"}, {\"match\": \"substring\", \"