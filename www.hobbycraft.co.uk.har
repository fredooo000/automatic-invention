-debugger-optimizely {\n\t\t\t\t\tdisplay: none !important;\n\t\t\t\t}\n\n\t\t\t\t.bl-qa-rotate {\n\t\t\t\t\ttransform: rotate(90deg);\n\t\t\t\t}\n\n\t\t\t\t.bl-qa-rotate-top {\n\t\t\t\t\ttransform: rotate(270deg);\n\t\t\t\t}\n\n\t\t\t\t.bl-qa-rotate-mini {\n\t\t\t\t\ttransform:rotate(180deg)\n\t\t\t\t}\n\n\t\t\t\t.bl-qa-mini-height {\n\t\t\t\t\theight:40px;\n\t\t\t\t}\n\n\t\t\t\t.bl-qa-debugger__clear-btn {\n\t\t\t\t\tpadding: 8px 10px;\n\t\t\t\t\tcolor: #4e5963;\n\t\t\t\t\tfont-size: 12px;\n\t\t\t\t\tcursor: pointer;\n\t\t\t\t\tdisplay: flex;\n\t\t\t\t\tjustify-content: center;\n\t\t\t\t\tgap: 6px;\n\t\t\t\t\tbackground: #E5E6F0;\n\t\t\t\t\tborder-top: 2px solid #d9dde1;\n\t\t\t\t}\n\n\t\t\t\t.bl-qa-debugger__clear-btn:hover {\n\t\t\t\t\tbackground: #d2d3dd;\n\t\t\t\t}\n\n\t\t\t\t.bl-qa-debugger__filter-input {\n\t\t\t\t\twidth: 100%;\n\t\t\t\t\tpadding: 4px 10px 4px 10px;\n\t\t\t\t\tborder: 1px solid #d9dde1;\n\t\t\t\t}\n\n\t\t\t\t@media only screen and (min-width: 768px) {\n\t\t\t\t\t#bl-qa-debugger {\n\t\t\t\t\t\tmax-height: 380px;\n\t\t\t\t\t}\n\n\t\t\t\t\t#bl-qa-qr-code {\n\t\t\t\t\t\twidth: 200px;\n\t\t\t\t\t\theight: 200px;\n\t\t\t\t\t}\n\n\t\t\t\t\t#bl-qa-debugger div.bl-qa-debugger__logs{\n\t\t\t\t\t\tfont-size: 13px;\n\t\t\t\t\t\theight: 229px;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t</style>\n\t\t`;\n    } catch (e2) {\n      if (debugMode)\n        console.error(logInfo, e2.message);\n    }\n  };\n  var addDebuggerWindow = (testId, variation) => {\n    try {\n      const localStorageItem = localStorage.getItem(localStorageQALogsKey);\n      const logs = JSON.parse(localStorageItem && localStorageItem.split(\",\") || \"[]\").reverse();\n      safelyInjectHTML(getHTML(testId, variation, logs));\n      safelyInjectHTML(getCSS());\n      const blQADebugger = document.querySelector(\"#bl-qa-debugger\");\n      const closeBtn = blQADebugger.querySelector(\".bl-qa-close-btn\");\n      const clearBtn = blQADebugger.querySelector(\".bl-qa-debugger__clear-btn\");\n      const minimiseBtn = blQADebugger.querySelector(\".bl-qa-minimize-btn\");\n      const topBtn = blQADebugger.querySelector(\".bl-qa-rotate\");\n      const debuggerOptimizely = blQADebugger.querySelector(\"#bl-qa-debugger-optimizely\");\n      const qrCodeContainer = blQADebugger.querySelector(\".bl-qa-debugger__btn-group__qr-code\");\n      const qrCodeBtn = blQADebugger.querySelector(\".bl-qa-qr-code-btn\");\n      const qrCode = document.getElementById(\"bl-qa-qr-code\");\n      const filterInput = blQADebugger.querySelector(\".bl-qa-debugger__filter-input\");\n      closeBtn.addEventListener(\"click\", () => {\n        try {\n          blQADebugger.style.display = \"none\";\n          localStorage.removeItem(\"blDebugMode\");\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      clearBtn.addEventListener(\"click\", () => {\n        try {\n          blQADebugger.querySelector(\".bl-qa-debugger__logs\").innerHTML = \" \";\n          localStorage.setItem(`${localStorageQALogsKey}`, JSON.stringify([]));\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      minimiseBtn.addEventListener(\"click\", () => {\n        try {\n          const debuggerMinimise = localStorage.getItem(\"blQADebuggerMinimise\");\n          if (!debuggerMinimise || debuggerMinimise == 1) {\n            blQADebugger.querySelector(\".bl-qa-debugger__logs\").style.display = \"none\";\n            minimiseBtn.classList.toggle(\"bl-qa-rotate-mini\");\n            blQADebugger.classList.toggle(\"bl-qa-mini-height\");\n            localStorage.setItem(\"blQADebuggerMinimise\", 0);\n          } else {\n            blQADebugger.querySelector(\".bl-qa-debugger__logs\").style.display = \"block\";\n            minimiseBtn.classList.toggle(\"bl-qa-rotate-mini\");\n            blQADebugger.classList.toggle(\"bl-qa-mini-height\");\n            localStorage.setItem(\"blQADebuggerMinimise\", 1);\n          }\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      topBtn.addEventListener(\"click\", () => {\n        try {\n          const debuggerPosition = localStorage.getItem(\"blQADebuggerPosition\");\n          if (!debuggerPosition || debuggerPosition == 1) {\n            blQADebugger.style.top = \"0\";\n            blQADebugger.style.maxHeight = \"fit-content\";\n            topBtn.classList.toggle(\"bl-qa-rotate-top\");\n            localStorage.setItem(\"blQADebuggerPosition\", 0);\n          } else {\n            blQADebugger.style.top = \"auto\";\n            blQADebugger.style.maxHeight = \"none\";\n            topBtn.classList.toggle(\"bl-qa-rotate-top\");\n            localStorage.setItem(\"blQADebuggerPosition\", 1);\n          }\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      qrCodeBtn.addEventListener(\"click\", () => {\n        try {\n          const url = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${window.location.href}`;\n          qrCode.innerHTML = `<img src=\"${url}\"/>`;\n          qrCode.classList.toggle(\"bl-qa-show\");\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      window.addEventListener(\"click\", (event) => {\n        try {\n          if (event.target !== qrCodeContainer && !qrCodeContainer.contains(event.target))\n            qrCode.classList.remove(\"bl-qa-show\");\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      debuggerOptimizely.addEventListener(\"click\", () => {\n        try {\n          if (!trackOptimizelyEvents) {\n            observeOptimizelyEvents(testId);\n            trackOptimizelyEvents = \"show\";\n            debuggerOptimizely.classList.remove(\"bl-qa-debugger-optimizely-disable\");\n            localStorage.setItem(\"blQADebuggerOptimizely\", 1);\n          } else {\n            if (trackOptimizelyEvents === \"show\") {\n              trackOptimizelyEvents = \"hide\";\n              localStorage.setItem(\"blQADebuggerOptimizely\", 0);\n            } else {\n              trackOptimizelyEvents = \"show\";\n              localStorage.setItem(\"blQADebuggerOptimizely\", 1);\n            }\n            debuggerOptimizely.classList.toggle(\"bl-qa-debugger-optimizely-disable\");\n          }\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      filterInput.addEventListener(\"input\", () => {\n        try {\n          const filterText = filterInput.value.toLowerCase();\n          localStorage.setItem(\"blQADebuggerFilter\", filterText);\n          const logElements = blQADebugger.querySelectorAll(\".bl-qa-debugger__logs p\");\n          logElements.forEach((logElement) => {\n            try {\n              const logText = logElement.innerText.toLowerCase();\n              if (logText.includes(filterText)) {\n                logElement.style.display = \"block\";\n              } else {\n                logElement.style.display = \"none\";\n              }\n            } catch (e2) {\n              if (debugMode)\n                console.error(logInfo, e2.message);\n            }\n          });\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      const storedFilterText = localStorage.getItem(\"blQADebuggerFilter\");\n      if (storedFilterText) {\n        filterInput.value = storedFilterText;\n        filterInput.dispatchEvent(new Event(\"input\"));\n      }\n      const blQAMinimise = localStorage.getItem(\"blQADebuggerMinimise\");\n      if (blQAMinimise == 0) {\n        localStorage.setItem(\"blQADebuggerMinimise\", 1);\n        minimiseBtn.click();\n      }\n      const blQAPosition = localStorage.getItem(\"blQADebuggerPosition\");\n      if (blQAPosition == 0) {\n        localStorage.setItem(\"blQADebuggerPosition\", 1);\n        topBtn.click();\n      }\n      const blQAOptimizely = localStorage.getItem(\"blQADebuggerOptimizely\");\n      const isDebuggerOptIn = !blQAOptimizely || blQAOptimizely == 1;\n      if (isDebuggerOptIn)\n        debuggerOptimizely.click();\n    } catch (e2) {\n      console.error(\"Error in checkDebugMode:\", e2.message);\n    }\n  };\n  var observeMonetateEvents = (testId) => {\n    try {\n      window.monetateQ = window.monetateQ || [];\n      const originalPush = window.monetateQ.push;\n      window.monetateQ.push = (...args) => {\n        try {\n          const result = originalPush.apply(window.monetateQ, args);\n          if (args[0][1] && args[0][1] && args[0][1][0] && typeof args[0][1][0] == \"string\") {\n            const eventSent = args[0][1][0];\n            window.console.log(`bl-${testId}->`, `${eventSent}`);\n          }\n          return result;\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      };\n    } catch (e2) {\n      if (debugMode)\n        console.error(logInfo, e2.message);\n    }\n  };\n  var ensureDebuggerExists = (testId, variation) => {\n    try {\n      const debuggerElement = document.querySelector(\"#bl-qa-debugger\");\n      if (!debuggerElement) {\n        if (debugMode)\n          console.log(logInfo, \"Debugger window missing, re-adding...\");\n        addDebuggerWindow(testId, variation);\n      }\n    } catch (e2) {\n      if (debugMode)\n        console.error(logInfo, e2.message);\n    }\n  };\n  var setupSPAMonitoring = (testId, variation) => {\n    try {\n      ensureDebuggerExists(testId, variation);\n      if (window.blQADebuggerObserver)\n        return;\n      const observer = new MutationObserver(() => {\n        try {\n          ensureDebuggerExists(testId, variation);\n        } catch (e2) {\n          if (debugMode)\n            console.error(logInfo, e2.message);\n        }\n      });\n      observer.observe(document.body, {\n        childList: true,\n        subtree: true\n      });\n      window.blQADebuggerObserver = observer;\n    } catch (e2) {\n      if (debugMode)\n        console.error(logInfo, e2.message);\n    }\n  };\n  var debugWindow = () => {\n    try {\n      const urlObj = new URL(window.location.href);\n      const href = urlObj.href;\n      if (href.includes(\"blDebugMode=true\")) {\n        localStorage.setItem(\"blDebugMode\", \"true\");\n      } else if (href.includes(\"blDebugMode=dev\")) {\n        localStorage.setItem(\"blDebugMode\", \"dev\");\n      } else if (href.includes(\"blDebugMode=false\")) {\n        localStorage.removeItem(\"blDebugMode\");\n      } else if (href.includes(`blDebugMode=${latestVersion}`)) {\n        localStorage.setItem(\"blDebugMode\", `${latestVersion}`);\n      }\n      const debugMode3 = localStorage.getItem(\"blDebugMode\");\n      const testId = \"\";\n      const variation = \"\";\n      if (!debugMode3 || debugMode3 === \"dev\")\n        return false;\n      waitForElements_default(\"body\", false, () => {\n        try {\n          if (debugMode3 === latestVersion) {\n            setupSPAMonitoring(testId, variation);\n            observeTestConsoleLogs();\n            observeMonetateEvents(testId);\n          }\n        } catch (e2) {\n          if (debugMode3)\n            console.error(logInfo, e2.message);\n        }\n      });\n      return true;\n    } catch (e2) {\n      if (debugMode)\n        console.error(logInfo, e2.message);\n      return false;\n    }\n  };\n\n  window[\"optimizely\"] = window[\"optimizely\"] || [];\n  var debugMode2 = checkDebugMode_default();\n  var logInfo2 = \"Project Javascript -->\";\n  var trackedClass = \"bl-hc-PJ-tracked\";\n  var USE_FETCH_LOGIN_CHECK = true;\n  var utils;\n  var isLoggedIn = window.sessionStorage.getItem(\"BL-HC-login-status\") === \"logged in\";\n  window.userLoginStatus = null;\n  if (!window.BL_HC_loginStatusFetchCache) {\n    window.BL_HC_loginStatusFetchCache = null;\n  }\n  var previousLoginStatusFromStorage = sessionStorage.getItem(\"BL-HC-login-status\");\n  if (previousLoginStatusFromStorage) {\n    sessionStorage.setItem(\"BL-HC-previous-login-status\", previousLoginStatusFromStorage);\n  }\n  debugWindow();\n  window.BL = {\n    utils: {\n      // Read Query Parameter value (url is optional)\n      getParameterByName: (name, url) => {\n        try {\n          if (!url)\n            url = window.location.href;\n          name = name.replace(/[\\[\\]]/g, \"\\\\$&\");\n          const regex = new RegExp(\"[?&]\" + name + \"(=([^&#]*)|&|#|$)\"), results = regex.exec(url);\n          if (!results)\n            return null;\n          if (!results[2])\n            return \"\";\n          return decodeURIComponent(results[2].replace(/\\+/g, \" \"));\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      },\n      // Function to create a cookie (days is optional)\n      setCookie: (name, value, days) => {\n        try {\n          let expires = \"\";\n          if (days) {\n            var date = /* @__PURE__ */ new Date();\n            date.setTime(date.getTime() + days * 24 * 60 * 60 * 1e3);\n            expires = \"; expires=\" + date.toUTCString();\n          }\n          document.cookie = name + \"=\" + (value || \"\") + expires + \"; path=/\";\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      },\n      // Function to get/read a specific cookie\n      getCookie: (name) => {\n        try {\n          const nameEQ = name + \"=\";\n          const ca = document.cookie.split(\";\");\n          for (let i = 0; i < ca.length; i++) {\n            let c = ca[i];\n            while (c.charAt(0) == \" \")\n              c = c.substring(1, c.length);\n            if (c.indexOf(nameEQ) == 0)\n              return c.substring(nameEQ.length, c.length);\n          }\n          return null;\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      },\n      // Function to delete a specific cookie (path is optional)\n      deleteCookie: (name, path) => {\n        try {\n          document.cookie = name + \"=; Max-Age=-99999999;\" + (path ? \" path=\" + path : \"\");\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      }\n    }\n  };\n  var wasPLPFilterApplied = false;\n  (() => {\n    try {\n      const key = \"HC-102-filter-applied\";\n      const value = localStorage.getItem(key);\n      if (value) {\n        wasPLPFilterApplied = true;\n        localStorage.removeItem(key);\n        if (debugMode2)\n          console.log(logInfo2, \"HC-102: Filter applied state detected and cleared\");\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  })();\n  (() => {\n    try {\n      const qaCookieQueryString = window.BL.utils.getParameterByName(\"blQA\");\n      if (qaCookieQueryString === \"true\") {\n        window.BL.utils.setCookie(\"blQA\", \"true\");\n      } else if (qaCookieQueryString === \"false\") {\n        window.BL.utils.deleteCookie(\"blQA\");\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  })();\n  var sendOptimizelyEvent = (eventName) => {\n    try {\n      window[\"optimizely\"].push({\n        type: \"event\",\n        eventName\n      });\n      if (debugMode2)\n        console.log(logInfo2, \"Optimizely event sent\", eventName);\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var sendOptimizelyAttribute = (data) => {\n    try {\n      window[\"optimizely\"].push({\n        type: \"user\",\n        attributes: data\n      });\n      if (debugMode2)\n        console.log(logInfo2, \"Optimizely user attribute set\", data);\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var OPTIMIZELY_AUDIENCE_VALUES = {\n    member: \"member\",\n    nonMember: \"non_member\",\n    unknown: \"unknown\",\n    loggedIn: \"logged_in\",\n    loggedOut: \"logged_out\"\n  };\n  if (!window.BL_HC_optimizelyAudienceState) {\n    window.BL_HC_optimizelyAudienceState = {\n      sfccClubReady: false,\n      loginStatusReady: false,\n      ready: false\n    };\n  }\n  var updateOptimizelyAudienceReadyState = () => {\n    try {\n      const wasReady = window.BL_HC_optimizelyAudienceState.ready;\n      window.BL_HC_optimizelyAudienceState.ready = Boolean(window.BL_HC_optimizelyAudienceState.sfccClubReady && window.BL_HC_optimizelyAudienceState.loginStatusReady);\n      if (!wasReady && window.BL_HC_optimizelyAudienceState.ready) {\n        window.dispatchEvent(new CustomEvent(\"bl:optimizely-audience-data-ready\"));\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var normaliseOptimizelyClubStatus = (sfccClubValue) => {\n    try {\n      if (typeof sfccClubValue !== \"string\")\n        return OPTIMIZELY_AUDIENCE_VALUES.unknown;\n      const normalisedValue = sfccClubValue.trim();\n      if (!normalisedValue)\n        return OPTIMIZELY_AUDIENCE_VALUES.nonMember;\n      if (normalisedValue.toUpperCase() === \"YES\")\n        return OPTIMIZELY_AUDIENCE_VALUES.member;\n      if ([\"NO\", \"NONE\", \"FALSE\", \"NON_MEMBER\", \"NOT_MEMBER\"].includes(normalisedValue.toUpperCase()))\n        return OPTIMIZELY_AUDIENCE_VALUES.nonMember;\n      return OPTIMIZELY_AUDIENCE_VALUES.unknown;\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n      return OPTIMIZELY_AUDIENCE_VALUES.unknown;\n    }\n  };\n  var getOptimizelyClubStatus = () => {\n    return new Promise((resolve) => {\n      try {\n        utils.waitUntil(() => {\n          return window.exponea && window.exponea.dimensions && Object.prototype.hasOwnProperty.call(window.exponea.dimensions, \"sfcc_club\");\n        }).then(() => {\n          resolve(normaliseOptimizelyClubStatus(window.exponea.dimensions.sfcc_club));\n        }).catch(() => {\n          resolve(OPTIMIZELY_AUDIENCE_VALUES.unknown);\n        });\n      } catch (e2) {\n        if (debugMode2)\n          console.error(logInfo2, e2.message);\n        resolve(OPTIMIZELY_AUDIENCE_VALUES.unknown);\n      }\n    });\n  };\n  var normaliseOptimizelyLoginStatus = (loginStatus) => {\n    try {\n      if (typeof loginStatus !== \"string\")\n        return OPTIMIZELY_AUDIENCE_VALUES.unknown;\n      const normalisedValue = loginStatus.trim().toLowerCase();\n      if (!normalisedValue)\n        return OPTIMIZELY_AUDIENCE_VALUES.unknown;\n      if (normalisedValue === \"logged in\" || normalisedValue === \"logged_in\")\n        return OPTIMIZELY_AUDIENCE_VALUES.loggedIn;\n      if (normalisedValue === \"guest\" || normalisedValue === \"logged out\" || normalisedValue === \"logged_out\")\n        return OPTIMIZELY_AUDIENCE_VALUES.loggedOut;\n      return OPTIMIZELY_AUDIENCE_VALUES.unknown;\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n      return OPTIMIZELY_AUDIENCE_VALUES.unknown;\n    }\n  };\n  var getOptimizelyLoginStatus = () => {\n    if (window.BL_HC_optimizelyLoginStatusFetchCache) {\n      return window.BL_HC_optimizelyLoginStatusFetchCache;\n    }\n    window.BL_HC_optimizelyLoginStatusFetchCache = new Promise((resolve) => {\n      try {\n        if (USE_FETCH_LOGIN_CHECK) {\n          fetch(\"/account/\", {\n            method: \"HEAD\",\n            credentials: \"include\",\n            redirect: \"manual\"\n          }).then((response) => {\n            if (response.status === 200) {\n              resolve(OPTIMIZELY_AUDIENCE_VALUES.loggedIn);\n            } else if (response.status === 302 || response.status === 0) {\n              resolve(OPTIMIZELY_AUDIENCE_VALUES.loggedOut);\n            } else {\n              resolve(OPTIMIZELY_AUDIENCE_VALUES.unknown);\n            }\n          }).catch(() => {\n            resolve(OPTIMIZELY_AUDIENCE_VALUES.unknown);\n          });\n        } else {\n          utils.waitUntil(() => {\n            return window.dataLayer && window.dataLayer.find((x) => x.user && x.user.loginStatus);\n          }).then(() => {\n            const loginStatusEntry = window.dataLayer.find((x) => x.user && x.user.loginStatus);\n            resolve(normaliseOptimizelyLoginStatus(loginStatusEntry && loginStatusEntry.user ? loginStatusEntry.user.loginStatus : null));\n          }).catch(() => {\n            resolve(OPTIMIZELY_AUDIENCE_VALUES.unknown);\n          });\n        }\n      } catch (e2) {\n        if (debugMode2)\n          console.error(logInfo2, e2.message);\n        resolve(OPTIMIZELY_AUDIENCE_VALUES.unknown);\n      }\n    });\n    return window.BL_HC_optimizelyLoginStatusFetchCache;\n  };\n  var sendStrictOptimizelyAudienceAttributes = () => {\n    try {\n      getOptimizelyClubStatus().then((clubStatus) => {\n        sendOptimizelyAttribute({\n          sfcc_club: clubStatus\n        });\n        window.BL_HC_optimizelyAudienceState.sfccClubReady = true;\n        updateOptimizelyAudienceReadyState();\n      });\n      getOptimizelyLoginStatus().then((loginStatus) => {\n        sendOptimizelyAttribute({\n          login_status: loginStatus\n        });\n        window.BL_HC_optimizelyAudienceState.loginStatusReady = true;\n        updateOptimizelyAudienceReadyState();\n      });\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var checkLoginStatusViaFetch = () => {\n    if (window.BL_HC_loginStatusFetchCache) {\n      if (debugMode2)\n        console.log(logInfo2, \"Using cached login status fetch promise\");\n      return window.BL_HC_loginStatusFetchCache;\n    }\n    if (debugMode2)\n      console.log(logInfo2, \"Initiating new login status fetch to /account/\");\n    window.BL_HC_loginStatusFetchCache = new Promise((resolve) => {\n      try {\n        fetch(\"/account/\", {\n          method: \"HEAD\",\n          credentials: \"include\",\n          redirect: \"manual\"\n        }).then((response) => {\n          try {\n            if (response.status === 200) {\n              const status = \"logged in\";\n              window.userLoginStatus = status;\n              sessionStorage.setItem(\"BL-HC-login-status\", status);\n              if (debugMode2)\n                console.log(logInfo2, \"Login status checked via fetch: logged in\");\n              resolve(status);\n            } else if (response.status === 302 || response.status === 0) {\n              const status = \"guest\";\n              window.userLoginStatus = status;\n              sessionStorage.setItem(\"BL-HC-login-status\", status);\n              if (debugMode2)\n                console.log(logInfo2, \"Login status checked via fetch: guest\");\n              resolve(status);\n            } else {\n              const status = \"guest\";\n              window.userLoginStatus = status;\n              sessionStorage.setItem(\"BL-HC-login-status\", status);\n              if (debugMode2)\n                console.log(logInfo2, \"Login status checked via fetch: guest (fallback)\");\n              resolve(status);\n            }\n          } catch (e2) {\n            if (debugMode2)\n              console.error(logInfo2, \"Error processing fetch response:\", e2.message);\n            const status = \"guest\";\n            window.userLoginStatus = status;\n            resolve(status);\n          }\n        }).catch((error) => {\n          if (debugMode2)\n            console.error(logInfo2, \"Error fetching /account/:\", error.message);\n          const status = \"guest\";\n          window.userLoginStatus = status;\n          resolve(status);\n        });\n      } catch (e2) {\n        if (debugMode2)\n          console.error(logInfo2, \"Error in checkLoginStatusViaFetch:\", e2.message);\n        const status = \"guest\";\n        window.userLoginStatus = status;\n        resolve(status);\n      }\n    });\n    return window.BL_HC_loginStatusFetchCache;\n  };\n  var checkLoginStatusViaDataLayer = () => {\n    return new Promise((resolve) => {\n      try {\n        if (dataLayer && dataLayer.find((x) => x.user && x.user.loginStatus)) {\n          const loginStatusEntry = dataLayer.find((x) => x.user && x.user.loginStatus);\n          if (loginStatusEntry && loginStatusEntry.user.loginStatus) {\n            const status = loginStatusEntry.user.loginStatus;\n            window.userLoginStatus = status;\n            sessionStorage.setItem(\"BL-HC-login-status\", status);\n            if (debugMode2)\n              console.log(logInfo2, \"Login status checked via dataLayer:\", status);\n            resolve(status);\n          } else {\n            resolve(null);\n          }\n        } else {\n          resolve(null);\n        }\n      } catch (e2) {\n        if (debugMode2)\n          console.error(logInfo2, \"Error in checkLoginStatusViaDataLayer:\", e2.message);\n        resolve(null);\n      }\n    });\n  };\n  var getLoginStatus = () => {\n    return new Promise((resolve) => {\n      try {\n        if (USE_FETCH_LOGIN_CHECK) {\n          checkLoginStatusViaFetch().then((status) => {\n            resolve(status);\n          });\n        } else {\n          utils.waitUntil(() => {\n            return dataLayer && dataLayer.find((x) => x.user && x.user.loginStatus);\n          }).then(() => {\n            checkLoginStatusViaDataLayer().then((status) => {\n              resolve(status);\n            });\n          }).catch(() => {\n            const status = \"guest\";\n            window.userLoginStatus = status;\n            resolve(status);\n          });\n        }\n      } catch (e2) {\n        if (debugMode2)\n          console.error(logInfo2, \"Error in getLoginStatus:\", e2.message);\n        const status = \"guest\";\n        window.userLoginStatus = status;\n        resolve(status);\n      }\n    });\n  };\n  var optimizelySupportCode = () => {\n    try {\n      sendStrictOptimizelyAudienceAttributes();\n      utils.waitUntil(() => {\n        return window.exponea && window.exponea.dimensions;\n      }).then(() => {\n        try {\n          if (window.exponea.dimensions.sfcc_dominant_category) {\n            sendOptimizelyAttribute({\n              sfcc_dominant_category: window.exponea.dimensions.sfcc_dominant_category\n            });\n          }\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      });\n      getLoginStatus();\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var isHC113Active = () => document.body && document.documentElement.classList.contains(\"HC-113\") && document.querySelector('.b-header_actions-account [data-id=\"successConfirmPanelDialog\"]');\n  var wasPartialAccount = () => document.documentElement.classList.contains(\"HC-113-1_login_sidebar_step_partial_account\");\n  var isSPLP = () => {\n    try {\n      const pathnames = [\n        \"/offers/\",\n        \"/craft-essentials/\",\n        \"/hobbies/\",\n        \"/knitting-crochet/\",\n        \"/sewing/\",\n        \"/art-supplies/\",\n        \"/digital-crafting/\",\n        \"/papercraft/\",\n        \"/baking-kitchen/\",\n        \"/kids/\",\n        \"/home-storage/\",\n        \"/wedding/\",\n        \"/party-occasions/\",\n        \"/ideas/\",\n        \"/easter/\"\n      ];\n      if (pathnames.includes(window.location.pathname))\n        return true;\n      return false;\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var getPageType = (callback) => {\n    try {\n      if (document.location.pathname === \"/\")\n        callback(\"HP\");\n      else {\n        utils.waitForElement(\"footer\").then(() => {\n          if (document.querySelector(\".l-plp\"))\n            callback(\"PLP\");\n          else if (document.querySelector(\".l-pdp:not(.m-idea)\"))\n            callback(\"PDP\");\n          else\n            callback(\"OTHER\");\n        });\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var listenToFetchRequest = (pageType) => {\n    try {\n      const originalFetch = window.fetch;\n      const referrer = window.sessionStorage.getItem(\"BL-HC-previous-url\");\n      if (referrer && referrer.includes(\"#promo049source\")) {\n        const currentHref = new URL(document.location.href);\n        currentHref.hash = \"promo049\";\n        window.sessionStorage.setItem(\"BL-HC-current-url\", currentHref.href);\n      }\n      window.fetch = function() {\n        try {\n          return new Promise((resolve, reject) => {\n            try {\n              originalFetch.apply(this, arguments).then((response) => {\n                try {\n                  if (response && response.url && response.url.includes(\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Cart-AddProduct\")) {\n                    if (pageType === \"PDP\") {\n                      sendOptimizelyEvent(\"PDP - Add to basket\");\n                      const referrer2 = window.sessionStorage.getItem(\"BL-HC-previous-url\");\n                      if (referrer2 && referrer2.includes(\"#promo049\")) {\n                        sendOptimizelyEvent(\"HC-049 - PDP - Add to basket\");\n                      }\n                      const plpFilterActiveStorage = sessionStorage.getItem(\"BL-HC-056-1-filter-active\");\n                      if (plpFilterActiveStorage) {\n                        sendOptimizelyEvent(\"PDP - Add to basket from PLP with filters applied\");\n                      }\n                      const filterOpened = sessionStorage.getItem(`BL-HC-056-1-filter-opened`);\n                      if (filterOpened) {\n                        sendOptimizelyEvent(\"bl-hc-056-1-pdp-add-to-basket-filter-opened\");\n                      }\n                      if (wasPLPFilterApplied) {\n                        sendOptimizelyEvent(\"bl-hc-102-atb-pdp-filter-applied\");\n                        if (debugMode2)\n                          console.log(logInfo2, \"HC-102: PDP Add to basket with PLP filters applied event sent\");\n                      }\n                    } else if (pageType === \"PLP\") {\n                      sendOptimizelyEvent(\"PLP - Add to basket\");\n                      const localStorageCurrentUrl = window.sessionStorage.getItem(\"BL-HC-current-url\");\n                      if (localStorageCurrentUrl && localStorageCurrentUrl.includes(\"#promo049\")) {\n                        sendOptimizelyEvent(\"HC-049 - PLP - Add to basket\");\n                      }\n                    }\n                    sendOptimizelyEvent(\"Sitewide - Add to basket\");\n                  } else if (response && response.url && response.url.includes(\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Wishlist-AddProduct\")) {\n                    if (pageType === \"PDP\") {\n                      sendOptimizelyEvent(\"PDP - Add to wishlist\");\n                      const localStorageReferrer = window.sessionStorage.getItem(\"BL-HC-previous-url\");\n                      if (localStorageReferrer && localStorageReferrer.includes(\"#promo049\")) {\n                        sendOptimizelyEvent(\"HC-049 - PDP - Add to wishlist\");\n                      }\n                    } else if (pageType === \"PLP\") {\n                      sendOptimizelyEvent(\"PLP - Add to wishlist\");\n                      const localStorageCurrentUrl = window.sessionStorage.getItem(\"BL-HC-current-url\");\n                      if (localStorageCurrentUrl && localStorageCurrentUrl.includes(\"#promo049\")) {\n                        sendOptimizelyEvent(\"HC-049 - PLP - Add to wishlist\");\n                      }\n                    }\n                    sendOptimizelyEvent(\"Sitewide - Add to wishlist\");\n                  } else if (response && response.url && response.url.includes(\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Rewards-Apply\")) {\n                    const responseClone = response.clone();\n                    responseClone.json().then((result) => {\n                      if (result.success) {\n                        sendOptimizelyEvent(\"Sitewide - Reward Applied Successfully\");\n                      }\n                      if (response.url.includes(\"context=panel\")) {\n                        sendOptimizelyEvent(\"Sitewide - Rewards Panel - Reward Applied Successfully\");\n                        if (pageType === \"PDP\") {\n                          sendOptimizelyEvent(\"PDP - Rewards panel - Reward applied successfully\");\n                        }\n                      }\n                    });\n                  } else if (response && response.url && response.url.includes(\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Account-SubmitRegistration\")) {\n                    const responseClone = response.clone();\n                    responseClone.json().then((result) => {\n                      if (result.success) {\n                        sendOptimizelyEvent(\"sitewide_successful_registration\");\n                        if (document.location.pathname === \"/login/\") {\n                          sendOptimizelyEvent(\"login_page_successful_registration\");\n                        } else {\n                          sendOptimizelyEvent(\"login_sidebar_panel_successful_registration\");\n                          if (isHC113Active()) {\n                            sendOptimizelyEvent(\"hc-113-login_sidebar_panel_successful_registration\");\n                            if (wasPartialAccount()) {\n                              sendOptimizelyEvent(\"hc-113-login_sidebar_panel_successful_registration_partial_account\");\n                            }\n                          }\n                        }\n                      }\n                    });\n                  }\n                  resolve(response);\n                } catch (e2) {\n                  if (debugMode2)\n                    console.error(logInfo2, e2.message);\n                }\n              }).catch((error) => {\n                reject(error);\n              });\n            } catch (e2) {\n              if (debugMode2)\n                console.error(logInfo2, e2.message);\n            }\n          });\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      };\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var extractNumber = (currencyString) => {\n    try {\n      const numberMatch = currencyString.match(/(\\d+\\.\\d*)|(\\d+)/);\n      if (numberMatch) {\n        return parseFloat(numberMatch[0]);\n      } else {\n        return null;\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var trackOrderQty = () => {\n    try {\n      utils.waitForElement(\"h2.b-checkout_products-counter\").then((qtyElement) => {\n        try {\n          const total = extractNumber(qtyElement.innerText);\n          if (total) {\n            window[\"optimizely\"].push({\n              type: \"event\",\n              eventName: \"trackOrderQuantity\",\n              tags: {\n                value: total\n              }\n            });\n            if (debugMode2)\n              console.log(logInfo2, \"Optimizely order quantity sent\", total);\n          }\n        } catch (error) {\n          if (debugMode2)\n            console.error(logInfo2, e.message);\n        }\n      });\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var trackRevenue = () => {\n    try {\n      utils.waitForElement(\".b-order_details .b-summary_table .m-total .b-summary_table-value\").then((totalElement) => {\n        const total = extractNumber(totalElement.innerText);\n        const isCollection = document.querySelector('[aria-label=\"Collection Summary\"]');\n        if (total) {\n          window[\"optimizely\"].push({\n            type: \"event\",\n            eventName: \"trackRevenue\",\n            tags: {\n              revenue: total * 100\n              // Revenue sent in cents\n            }\n          });\n          if (isLoggedIn) {\n            window[\"optimizely\"].push({\n              type: \"event\",\n              eventName: \"logged_in_revenue\",\n              tags: {\n                revenue: total * 100\n                // Revenue sent in cents\n              }\n            });\n          }\n          if (isCollection) {\n            window[\"optimizely\"].push({\n              type: \"event\",\n              eventName: \"click_and_collect_revenue\",\n              tags: {\n                revenue: total * 100\n                // Revenue sent in cents\n              }\n            });\n          }\n          if (!isCollection) {\n            window[\"optimizely\"].push({\n              type: \"event\",\n              eventName: \"home_delivery_revenue\",\n              tags: {\n                revenue: total * 100\n                // Revenue sent in cents\n              }\n            });\n          }\n          if (debugMode2)\n            console.log(logInfo2, \"Optimizely revenue sent\", total);\n        }\n      });\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var trackLoginTransition = () => {\n    try {\n      if (USE_FETCH_LOGIN_CHECK) {\n        if (window.userLoginStatus !== null) {\n          const previousLoginStatus = sessionStorage.getItem(\"BL-HC-previous-login-status\");\n          const currentLoginStatus = window.userLoginStatus;\n          sessionStorage.setItem(\"BL-HC-login-status\", currentLoginStatus);\n          if (previousLoginStatus === \"guest\" && currentLoginStatus === \"logged in\") {\n            sendOptimizelyEvent(\"sitewide_logged_in_rate\");\n            if (document.location.pathname.includes(\"/account/\")) {\n              sendOptimizelyEvent(\"login_page_logged_in_rate\");\n            }\n            if (debugMode2)\n              console.log(logInfo2, \"User just logged in \\u2013 Optimizely event sent\");\n          }\n          sessionStorage.setItem(\"BL-HC-previous-login-status\", currentLoginStatus);\n        }\n      } else {\n        if (window.dataLayer) {\n          const latestLoginStatusEntry = window.dataLayer.find((e2) => e2.user && e2.user.loginStatus);\n          if (latestLoginStatusEntry && latestLoginStatusEntry.user.loginStatus) {\n            const previousLoginStatus = sessionStorage.getItem(\"BL-HC-login-status\");\n            sessionStorage.setItem(\"BL-HC-login-status\", latestLoginStatusEntry.user.loginStatus);\n            window.userLoginStatus = latestLoginStatusEntry.user.loginStatus;\n            if (previousLoginStatus === \"guest\" && latestLoginStatusEntry.user.loginStatus === \"logged in\") {\n              sendOptimizelyEvent(\"sitewide_logged_in_rate\");\n              if (debugMode2)\n                console.log(logInfo2, \"User just logged in \\u2013 Optimizely event sent\");\n            }\n          }\n        }\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var genericMetricsSitewide = () => {\n    try {\n      trackLoginTransition();\n      const searchBox = document.querySelector(`#search-box-dialog form.b-search_input:not(.${trackedClass})`);\n      if (searchBox) {\n        searchBox.classList.add(`${trackedClass}`);\n        searchBox.addEventListener(\"submit\", () => {\n          try {\n            sendOptimizelyEvent(\"Sitewide - Search Completion Rate\");\n            sendOptimizelyEvent(\"sitewide-submit_search-search_magnifying_glass_icon_click\");\n          } catch (e2) {\n            if (debugMode2)\n              console.error(logInfo2, e2.message);\n          }\n        });\n      }\n      const headerSearchLinks = document.querySelectorAll(`#search-box-dialog .b-suggestions-inner .b-suggestions-options a:not(.${trackedClass}), #search-box-dialog .b-suggestions-inner .b-suggestions-section a:not(.${trackedClass})`);\n      for (const headerSearchLink of headerSearchLinks) {\n        headerSearchLink.classList.add(`${trackedClass}`);\n        headerSearchLink.addEventListener(\"click\", () => {\n          try {\n            sendOptimizelyEvent(\"Sitewide - Search Completion Rate\");\n          } catch (e2) {\n            if (debugMode2)\n              console.error(logInfo2, e2.message);\n          }\n        });\n      }\n      const productsSection = document.querySelector(`#search-box-dialog .b-suggestions-section.m-products:not(.${trackedClass}-observed)`);\n      if (productsSection && !productsSection.classList.contains(`${trackedClass}-observed`)) {\n        productsSection.classList.add(`${trackedClass}-observed`);\n        const productsObserver = new IntersectionObserver(\n          (entries) => {\n            entries.forEach((entry) => {\n              try {\n                if (entry.isIntersecting) {\n                  sendOptimizelyEvent(\"sitewide-search_dialog-seen_products_section\");\n                  productsObserver.disconnect();\n                }\n              } catch (e2) {\n                if (debugMode2)\n                  console.error(logInfo2, e2.message);\n              }\n            });\n          },\n          { threshold: 0.3 }\n        );\n        productsObserver.observe(productsSection);\n      }\n      const ideasSection = document.querySelector(`#search-box-dialog .b-suggestions-section.m-ideas:not(.${trackedClass}-observed)`);\n      if (ideasSection && !ideasSection.classList.contains(`${trackedClass}-observed`)) {\n        ideasSection.classList.add(`${trackedClass}-observed`);\n        const ideasObserver = new IntersectionObserver(\n          (entries) => {\n            entries.forEach((entry) => {\n              try {\n                if (entry.isIntersecting) {\n                  sendOptimizelyEvent(\"sitewide-search_dialog-seen_ideas_section\");\n                  ideasObserver.disconnect();\n                }\n              } catch (e2) {\n                if (debugMode2)\n                  console.error(logInfo2, e2.message);\n              }\n            });\n          },\n          { threshold: 0.3 }\n        );\n        ideasObserver.observe(ideasSection);\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var genericMetricsPDP = () => {\n    try {\n      const searchBox = document.querySelector(`#search-box-dialog form.b-search_input:not(.${trackedClass}-pdp)`);\n      if (searchBox) {\n        searchBox.classList.add(`${trackedClass}-pdp`);\n        searchBox.addEventListener(\"submit\", () => {\n          try {\n            sendOptimizelyEvent(\"PDP - Search Completion Rate\");\n          } catch (e2) {\n            if (debugMode2)\n              console.error(logInfo2, e2.message);\n          }\n        });\n      }\n      const headerSearchLinks = document.querySelectorAll(`#search-box-dialog .b-suggestions-inner .b-suggestions-options a:not(.${trackedClass}-pdp), #search-box-dialog .b-suggestions-inner .b-suggestions-section a:not(.${trackedClass}-pdp)`);\n      for (const headerSearchLink of headerSearchLinks) {\n        headerSearchLink.classList.add(`${trackedClass}-pdp`);\n        headerSearchLink.addEventListener(\"click\", () => {\n          try {\n            sendOptimizelyEvent(\"PDP - Search Completion Rate\");\n          } catch (e2) {\n            if (debugMode2)\n              console.error(logInfo2, e2.message);\n          }\n        });\n      }\n      const atbCTAs = document.querySelectorAll(`.b-product_actions .b-product_actions-inner .b-button:not(.${trackedClass}), .b-product_sticky-inner .b-product_sticky-cta button.b-button:not(.${trackedClass})`);\n      atbCTAs.forEach((atbCTA) => {\n        try {\n          atbCTA.classList.add(trackedClass);\n          atbCTA.addEventListener(\"click\", () => {\n            try {\n              sendOptimizelyEvent(\"PDP - Add to basket - Primary product only\");\n              const params = new URL(location.href).searchParams;\n              const paramTestId = params.get(\"test\");\n              if (paramTestId && paramTestId.includes(\"bl-hc-069\")) {\n                sendOptimizelyEvent(`${paramTestId}-pdp-atb-rate`);\n              }\n            } catch (e2) {\n              if (debugMode2)\n                console.error(logInfo2, e2.message);\n            }\n          });\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      });\n      const viewAllIdeasButton = document.querySelector(`#moreideas .b-featured_category-footnote a:not(.${trackedClass})`);\n      if (viewAllIdeasButton) {\n        viewAllIdeasButton.classList.add(trackedClass);\n        let url = new URL(viewAllIdeasButton.getAttribute(\"href\"));\n        url.hash = \"sourceTypePDP\" + (document.querySelector(\".l-pdp.m-idea\") ? \"_idea\" : \"_pdp\");\n        viewAllIdeasButton.setAttribute(\"href\", url.href);\n      }\n      const imageGallery = document.querySelector(`.l-pdp-image .b-product_gallery-idea.m-inited:not(.${trackedClass})`);\n      if (imageGallery) {\n        imageGallery.classList.add(trackedClass);\n        let hasInteracted = false;\n        const observer = new MutationObserver((mutationsList) => {\n          try {\n            mutationsList.forEach((mutation) => {\n              try {\n                if (mutation.type === \"attributes\" && mutation.attributeName === \"tile-visible\" && !hasInteracted) {\n                  const newValue = mutation.target.getAttribute(\"tile-visible\");\n                  const oldValue = mutation.oldValue;\n                  if (oldValue === \"false\" && newValue === \"true\") {\n                    hasInteracted = true;\n                    sendOptimizelyEvent(\"25251511284__pdp_interaction_image_carousel\");\n                    observer.disconnect();\n                  }\n                }\n              } catch (e2) {\n                if (debugMode2)\n                  console.error(logInfo2, e2.message);\n              }\n            });\n          } catch (e2) {\n            if (debugMode2)\n              console.error(logInfo2, e2.message);\n          }\n        });\n        const config = {\n          attributes: true,\n          attributeOldValue: true,\n          attributeFilter: [\"tile-visible\"],\n          childList: true,\n          subtree: true\n        };\n        observer.observe(imageGallery, config);\n      }\n      if (window.location.pathname.startsWith(\"/ideas/\")) {\n        const ideasAtbCTAs = document.querySelectorAll(`button.b-button[data-id=\"addSetToCart\"]:not(.${trackedClass})`);\n        ideasAtbCTAs.forEach((ideasAtbCTA) => {\n          try {\n            ideasAtbCTA.classList.add(trackedClass);\n            ideasAtbCTA.addEventListener(\"click\", () => {\n              try {\n                sendOptimizelyEvent(\"hc-051-ideas-atb-rate-from-ideas-pdps-only\");\n              } catch (e2) {\n                if (debugMode2)\n                  console.error(logInfo2, e2.message);\n              }\n            });\n          } catch (e2) {\n            if (debugMode2)\n              console.error(logInfo2, e2.message);\n          }\n        });\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var genericMetricsPLP = () => {\n    try {\n      const sort = document.querySelector(`select#plp-sort:not(.${trackedClass})`);\n      if (sort) {\n        sort.classList.add(trackedClass);\n        sort.addEventListener(\"change\", () => {\n          try {\n            if (!isSPLP())\n              sendOptimizelyEvent(\"PLP - Sort Applied\");\n            if (window.location.pathname.startsWith(\"/ideas/\")) {\n              sendOptimizelyEvent(\"Ideas PLP - Sort Applied\");\n            }\n          } catch (e2) {\n            if (debugMode2)\n              console.error(logInfo2, e2.message);\n          }\n        });\n      }\n      const tiles = document.querySelectorAll(`.l-plp-products #product-grid section.b-product_tile:not(.${trackedClass})`);\n      for (const tile of tiles) {\n        tile.classList.add(trackedClass);\n        const links = tile.querySelectorAll(\"a\");\n        for (const link of links) {\n          link.addEventListener(\"click\", () => {\n            try {\n              const localStorageCurrentUrl = window.sessionStorage.getItem(\"BL-HC-current-url\");\n              if (localStorageCurrentUrl && localStorageCurrentUrl.includes(\"#promo049\")) {\n                sendOptimizelyEvent(\"HC-049 - PLP - CTR to PDP\");\n              }\n            } catch (e2) {\n              if (debugMode2)\n                console.error(logInfo2, e2.message);\n            }\n          });\n        }\n      }\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var trackOrderDetails = () => {\n    try {\n      utils.waitForElement(\".b-order_details .b-summary_table .m-total .b-summary_table-value\").then(() => {\n        try {\n          const orderTableDetails = document.querySelectorAll(`.b-order_details .b-summary_table .b-summary_table-name`);\n          orderTableDetails.forEach((orderTableDetail) => {\n            try {\n              if (orderTableDetail.innerText == \"Order discount\") {\n                sendOptimizelyEvent(`confirmation-order-with-discount`);\n              }\n            } catch (e2) {\n              if (debugMode2)\n                console.error(logInfo2, e2.message);\n            }\n          });\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      });\n      utils.waitForElement(`section[aria-label=\"Delivery Summary\"]`).then(() => {\n        try {\n          sendOptimizelyEvent(`confirmation-home-delivery`);\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      });\n      utils.waitForElement(`section[aria-label=\"Collection Summary\"]`).then(() => {\n        try {\n          sendOptimizelyEvent(`confirmation-click-and-collect`);\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      });\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var trackLiveChatTriggered = () => {\n    try {\n      window.addEventListener(\"blur\", () => {\n        try {\n          const closedChatWidget = document.querySelector(\"div#fc_frame:not(.fc_open)\");\n          if (closedChatWidget) {\n            if (closedChatWidget === document.activeElement || closedChatWidget.contains(document.activeElement)) {\n              sendOptimizelyEvent(\"sitewide_live_chat_launch_rate\");\n            }\n          }\n        } catch (e2) {\n          if (debugMode2)\n            console.error(logInfo2, e2.message);\n        }\n      });\n    } catch (e2) {\n      if (debugMode2)\n        console.error(logInfo2, e2.message);\n    }\n  };\n  var genericMetrics = () => {\n    try {\n      trackLiveChatTriggered();\n      genericMetricsSitewide();\n      new MutationObserver(genericMetricsSitewide).observe(document.documentElement, {\n        childList: true,\n        subtree: true\n      });\n      if (document.location.pathname === \"/order-confirmation/\") {\n        if (isLoggedIn) {\n   