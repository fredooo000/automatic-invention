obeVars(s) {\n      for (var i = 0; i < 75; i++) {\n        s['prop' + i] = '';\n        s['eVar' + i] = '';\n        if (i <= 5) {\n          s['hier' + i] = '';\n        }\n      }\n      svarArr = ['pageName', 'channel', 'products', 'events', 'campaign', 'purchaseID', 'state', 'zip', 'server', 'linkName'];\n      for (var i = 0; i < svarArr.length; i++) {\n        s[svarArr[i]] = '';\n      }\n    }\n    var label = pid ? pid + ', ' + zmagsSource : zmagsSource,\n      category = 'Zmags DW cartridge',\n      s,\n      s_code;\n    if (isGoogleAnalyticsEnabled()) {\n      // Google Analytics: \n      if (qty) {\n        ga(ZMAGSSOURCE + '.send', 'event', category, action, label, qty);\n      } else {\n        ga(ZMAGSSOURCE + '.send', 'event', category, action, label);\n      }\n    }\n    if (isAdobeAnalyticsEnabled()) {\n      // Adobe Analytics:\n      s = window.__zmags.demandware.analytics[ZMAGSSOURCE].AppMeasurementInstance;\n      clearAdobeVars(s);\n      s.channel = category;\n      s.pageName = action;\n      s.prop1 = ZMAGSSOURCE;\n      s.prop2 = action;\n      s.prop3 = label;\n      if (pid) {\n        s.products = pid;\n      }\n      if (qty) {\n        s.prop4 = qty;\n      }\n      s_code = s.t();\n      if (s_code) {\n        document.write(s_code);\n      }\n    }\n  }\n  function isQuickviewCall(url) {\n    return url.indexOf('source=quickview') > -1;\n  }\n  function isZmagsSource(url) {\n    if (url) {\n      return url.indexOf('?zmagssrc=' + ZMAGSSOURCE) > -1 || url.indexOf('&zmagssrc=' + ZMAGSSOURCE) > -1;\n    } else {\n      return false;\n    }\n  }\n  function isAddProductCall(url, options) {\n    var result = url.indexOf('Cart-AddProduct') > -1 && url.indexOf('format=ajax') > -1;\n    if (!result) {\n      result = url.indexOf('Cart-MiniAddProduct') > -1 && options.data.indexOf('pid=') > -1;\n      if (result) {\n        options.data += '&zmagssrc=' + ZMAGSSOURCE;\n      }\n    }\n    return result;\n  }\n  function isProductVariationCall(url) {\n    return url.indexOf('Product-Variation') > -1 || url.indexOf('Product-GetSetItem') > -1;\n  }\n  function isGoogleAnalyticsEnabled() {\n    return zmagsSettings.googleAnalyticsEnabled;\n  }\n  function isAdobeAnalyticsEnabled() {\n    return zmagsSettings.adobeAnalyticsEnabled;\n  }\n  function isTrackingEnabled() {\n    return isGoogleAnalyticsEnabled() || isAdobeAnalyticsEnabled();\n  }\n\n  /**\n   * Indicates whether Zmags Publicator Cartridge is used and currently also tracking events\n   */\n  function isZmagsPublicatorTrackingActive() {\n    var zmagsPublicatorData = window.__zmags.demandware.analytics.publicator && window.__zmags.demandware.analytics.publicator.data;\n    return zmagsPublicatorData && zmagsPublicatorData.zmagsSource;\n  }\n\n  /**\n   * Retrieves the parameter value for name from url.\n   * f.e. getParameterByName('abc?x=123&y456', 'x') returns '123'\n   * @returns {string} parametervalue for given name\n   */\n  function getParameterByName(url, name) {\n    var query = null;\n    var splittedUrl = url.split('?');\n    if (splittedUrl.length > 1) {\n      query = splittedUrl[1];\n    } else {\n      query = url;\n    }\n    query = query.split('&');\n    var parameterValue = null;\n    $.each(query, function (i, value) {\n      var token = value.split('=');\n      if (token.length > 1) {\n        var key = decodeURIComponent(token[0]);\n        if (key === name) {\n          parameterValue = decodeURIComponent(token[1]);\n          return false; //-> break out of $.each \n        }\n      }\n    });\n    return parameterValue;\n  }\n\n  /**\n   * Retrieves the quickview object \n   * @returns {object} quickview\n   */\n  function getQuickview() {\n    var quickview = window.__zmags && window.__zmags.demandware && window.__zmags.demandware.quickview || null;\n    return quickview;\n  }\n\n  /**\n   * Retrieves the page namespace \n   * @returns {string} pageNamespace\n   */\n  function getPageNamespace() {\n    var pageNamespac