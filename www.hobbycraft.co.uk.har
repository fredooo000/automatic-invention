-add-to-cart-url=\"/on/demandware.store/Sites-hobbycraft-uk-Site/en_GB/Cart-AddProduct?productTile=true\"\n                        >\n                            <svg class=\"b-product_tile-cta_svg b-button_multi_state-icon_bag\" width=\"16\" height=\"20\" viewBox=\"0 0 16 20\" focusable=\"false\">\n                                <use href=\"#shopping-bag\"></use>\n                            </svg>\n                            <span data-ref=\"container\">\n                                Add to Basket\n                            </span>\n                        </button>\n                    {{/isAddToBasket}}\n                {{/product.subscription}}\n            {{/product.plpAvailability.available}}\n        \n            \n            {{#isMoreInfo}}\n                <a href=\"{{product.link}}\" class=\"b-product_tile-cta m-info\" data-ref=\"moreInfoButton\">\n                    More Info\n                </a>\n            {{/isMoreInfo}}\n        {{/product.addToCartButton}}\n    </div>\n</script>\n\n\n\n        </div>\n\n        <button\n    type=\"button\"\n    class=\"b-wishlist_button m-tile m-add\"\n    data-id=\"addToWishlist\"\n    data-widget=\"buttonWithIcon\"\n    data-product-id=\"6046771000\"\n    data-event-click=\"handleClick\"\n    data-widget-event-click=\"wishlistButtonClickHandler\"\n    data-product-name=\"Essdee Lino Cutting and Printing Kit\"\n    data-is-product-set=\"null\" \n    data-classes-active=\"m-added\"\n    data-classes-disabled=\"m-add\"\n    aria-label=\"Save for Later\"\n    aria-pressed=\"false\"\n    data-tau=\"product_addToWishList\"\n>\n    <span class=\"b-wishlist_button-icon\">\n        <svg width=\"25\" height=\"23\" viewBox=\"0 0 25 23\" class=\"b-wishlist-icon\" role=\"presentation\">\n    <use href=\"#heart\"></use>\n</svg>\n\n    </span>\n</button>\n\n\n        \n\n    \n\n    \n\n    \n        <script type=\"template/mustache\" data-ref=\"addToWishlistButtonSimpleTileTemplate\">\n            <button\n    type=\"button\"\n    class=\"b-wishlist_button m-tile m-add\"\n    data-id=\"addToWishlist\"\n    data-widget=\"buttonWithIcon\"\n    data-product-id=\"{{id}}\"\n    data-event-click=\"handleClick\"\n    data-widget-event-click=\"wishlistButtonClickHandler\"\n    data-product-name=\"{{productName}}\"\n    data-is-product-set=\"{{isProductSet}}\"\n    data-classes-active=\"m-added\"\n    data-classes-disabled=\"m-add\"\n    aria-label=\"Save for Later\"\n    aria-pressed=\"false\"\n    data-tau=\"product_addToWishList\"\n>\n    <span class=\"b-wishlist_button-icon\">\n        <svg width=\"25\" height=\"23\" viewBox=\"0 0 25 23\" class=\"b-wishlist-icon\" role=\"presentation\">\n    <use href=\"#heart\"></use>\n</svg>\n\n    </span>\n</button>\n\n        </script>\n    \n\n    \n        \n\n<div class=\"b-product_tile-badges_container\" data-ref=\"badgesMessage\">\n    \n        <div class=\"b-badges\">\n            <div class=\"b-badges-wrapper\">\n                \n                    \n                        \n                            <span style=\"background-color:#A42015;color:#FFFFFF\" class=\"b-badges-item\">25% off</span>\n                        \n                    \n                \n            </div>\n\n            <div class=\"b-badges-wrapper m-right\">\n                \n                    \n                \n            </div>\n        </div>\n    \n</div>\n\n<!-- Include mustache template for dynamic badges updates -->\n<script type=\"template/mustache\" data-ref=\"badgesTemplate\">\n    <div class=\"b-product_tile-badges_container\" data-ref=\"badgesMessage\">\n        {{#showBadges}}\n        <div class=\"b-badges\">\n            <div class=\"b-badges-wrapper\">\n                {{#leftBadges}}\n                    {{#isTextBadge}}\n                    <span style=\"{{style}}\" class=\"b-badges-item\">{{displayName}}</span>\n                    {{/isTextBadge}}\n                    {{#isImageBadge}}\n                    <img src=\"{{imageUrl}}\" class=\"b-badges-item\" alt=\"{{displayName}}\" loading=\"lazy\"/>\n                    {{/isImageBadge}}\n                {{/leftBadges}}\n            </div>\n\n            <div class=\"b-badges-wrapper m-right\">\n                {{#rightBadges}}\n                    {{#isTextBadge}}\n                    <span style=\"{{style}}\" class=\"b-badges-item\">{{displayName}}</span>\n                    {{/isTextBadge}}\n                    {{#isImageBadge}}\n                    <img src=\"{{imageUrl}}\" class=\"b-badges-item\" alt=\"{{displayName}}\" loading=\"lazy\"/>\n                    {{/isImageBadge}}\n                {{/rightBadges}}\n            </div>\n        </div>\n        {{/showBadges}}\n    </div>\n</script>  \n    \n\n    \n\n</div>\n\n\n<!-- END_dwmarker -->\n\n</section>\n\n\n                                \n                            </div>\n                        \n                    </div>\n                </div>\n\n                \n                    <div class=\"b-featured_category-footnote\">\n                        <a href=\"https://www.hobbycraft.co.uk/offers/\" class=\"b-button\">Shop All Offers</a>\n                    </div>\n                \n\n            </div>\n        </section>\n    </div>\n\n    <script>\n        (function() {\n            function activateCarouselLazyImages(container) {\n                if (!('IntersectionObserver' in window)) {\n                    // Fallback: load all images immediately\n                    container.querySelectorAll('img[data-src]').forEach(img => {\n                        img.src = img.dataset.src;\n                    });\n                    container.querySelectorAll('source[data-srcset]').forEach(source => {\n                        source.srcset = source.dataset.srcset;\n                    });\n                    return;\n                }\n\n                const observer = new IntersectionObserver((entries, obs) => {\n                    entries.forEach(entry => {\n                        if (entry.isIntersecting) {\n                            const picture = entry.target;\n                            // Set srcset on sources\n                            picture.querySelectorAll('source[data-srcset]').forEach(source => {\n                                source.srcset = source.dataset.srcset;\n                            });\n                            // Set src on img\n                            const img = picture.querySelector('img[data-src]');\n                            if (img) img.src = img.dataset.src;\n                            obs.unobserve(picture);\n                        }\n                    });\n                }, { rootMargin: '200px' });\n\n                container.querySelectorAll('picture').forEach(picture => {\n                    observer.observe(picture);\n                });\n            }\n\n            var carousel = document.querySelector('[class~=\"m-carousel\"][class~=\"e64970de77b77f79df482994c7\"]');\n            if (carousel) activateCarouselLazyImages(carousel);\n        })();\n    </script>\n\n\n"
