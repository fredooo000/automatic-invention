 (featureFilter === '') {\n          featureFilter = $(this).text().trim();\n        } else {\n          featureFilter += ' | ' + $(this).text().trim();\n        }\n      }\n    });\n  }\n  return featureFilter;\n}\n\n/**\n * @description Returns concatenated string of checked filter labels from  section\n */\nfunction getProductTypeFilters() {\n  var featureFilter = '';\n  $('#secondary .productType a').each(function () {\n    if ($(this).hasClass('checked')) {\n      if (featureFilter === '') {\n        featureFilter = $(this).text().trim();\n      } else {\n        featureFilter += ' | ' + $(this).text().trim();\n      }\n    }\n  });\n  return featureFilter;\n}\n\n/**\n * @description Returns concatenated string of checked filter values from  section\n */\nfunction getDietaryFilter(e) {\n  var featureFilter = '';\n  var selectedFilter = '';\n  if (e) {\n    if ($(e.target.offsetParent).hasClass('dietary')) {\n      selectedFilter = e.target.innerText;\n    }\n    featureFilter = selectedFilter.trim();\n    $('#secondary .dietary a').each(function () {\n      if ($(this).hasClass('checked')) {\n        if (featureFilter === '') {\n          featureFilter = $(this).text().trim();\n        } else {\n          featureFilter += ' | ' + $(this).text().trim();\n        }\n      }\n    });\n  }\n  return featureFilter;\n}\n\n/**\n * @description Returns concatenated string of checked filter values from  section\n */\nfunction getDietaryFilters() {\n  var featureFilter = '';\n  $('#secondary .dietary a').each(function () {\n    if ($(this).hasClass('checked')) {\n      if (featureFilter === '') {\n        featureFilter = $(this).text().trim();\n      } else {\n        featureFilter += ' | ' + $(this).text().trim();\n      }\n    }\n  });\n  return featureFilter;\n}\n\n/**\n * @param event\n * @description Takes data which is available on a page\n */\nfunction getHamperProductData(hamperContainerObj) {\n  if ($('input[name=currentHamper]').length > 0) {\n    var currentHamper = JSON.parse($('input[name=currentHamper]').val());\n    var productArray = [];\n    var productObj = [];\n    for (var i = 0; i < currentHamper.product.length; i++) {\n      // object to be pushed\n      var obj = {};\n      obj[\"product_brand\"] = currentHamper.product[i].product_brand;\n      obj[\"product_category\"] = currentHamper.product[i].product_category;\n      obj[\"product_hierarchy\"] = currentHamper.product[i].product_hierarchy;\n      obj[\"product_name\"] = currentHamper.product[i].product_name;\n      obj[\"product_ID\"] = currentHamper.product[i].product_ID;\n      obj[\"product_SKU\"] = currentHamper.product[i].product_SKU;\n      obj[\"product_discount\"] = currentHamper.product[i].product_discount;\n      obj[\"product_price\"] = currentHamper.product[i].product_price;\n      obj[\"product_price_old\"] = currentHamper.product[i].product_price_old;\n      obj[\"product_quantity\"] = currentHamper.product[i].product_quantity;\n      obj[\"product_stock_status\"] = currentHamper.product[i].product_stock_status;\n      obj[\"product_variant\"] = currentHamper.product[i].product_variant;\n      obj[\"product_vat\"] = currentHamper.product[i].product_vat;\n      if (hamperContainerObj) {\n        fillProductSetData(obj, hamperContainerObj);\n      } else {\n        obj[\"product_set_capacity\"] = currentHamper.product[i].product_set_capacity;\n        obj[\"product_set_items_added\"] = currentHamper.product[i].product_set_items_added;\n        obj[\"product_set_name\"] = currentHamper.product[i].product_set_name;\n        obj[\"product_set_price\"] = currentHamper.product[i].product_set_price;\n        obj[\"product_set_size\"] = currentHamper.product[i].product_set_size;\n        obj[\"product_set_SKU\"] = currentHamper.product[i].product_set_SKU;\n        obj[\"product_set_type\"] = currentHamper.product[i].product_set_type;\n      }\n      productArray.push(obj);\n    }\n    productObj[\"product\"] = productArray;\n    return productObj;\n  