n                            </div>\n                        </div>\n                                    </div>\n                                                         <div>\n                    <span class=\"flex items-center text-md bg-opacity-95\">\n                        <a class=\"header-link w-full py-3 px-1.5 2lg:px-2 text-sm 2lg:text-base leading-6 level-0 \"\n                           href=\"/giftcards\"\n                           title=\"Gift&#x20;cards\"\n                        >\n                            Gift cards                        </a>\n                    </span>\n                </div>\n                                 <div>\n                    <span class=\"flex items-center text-md bg-opacity-95\">\n                        <a class=\"header-link w-full py-3 px-1.5 2lg:px-2 text-sm 2lg:text-base leading-6 level-0 \"\n                           href=\"/loyalty-app\"\n                           title=\"App\"\n                        >\n                            App                        </a>\n                    </span>\n                </div>\n                                    </nav>\n    </div>\n</div>\n<script>\n    'use strict';\n\n    const initMenuDesktop_6a1ec0cbabaa2 = () => {\n        return {\n            hoverPanelActiveId: null,\n            setActiveMenu(menuNode) {\n                Array.from(menuNode.querySelectorAll('a')).filter(link => {\n                    let currentLink = window.location.href.split('?')[0];\n                    if (currentLink.charAt(currentLink.length - 1) === '/') currentLink = currentLink.slice(0, -1);\n                    return link.href === currentLink;\n                }).map(item => {\n                    item.classList.add('active');\n                    item.classList.add('pointer-events-none');\n                });\n            },\n            setHoverPanel(id) {\n                if (id) {\n                    this.$refs[`level-0-${id}`].classList.add('hover');\n                    this.hoverPanelActiveId = id;\n                } else {\n                    this.$refs[`level-0-${this.hoverPanelActiveId}`].classList.remove('hover');\n                    this.hoverPanelActiveId = 0;\n                }\n            }\n        }\n    }\n</script>\n\n        <div class=\"flex items-center order-2 lg:order-3 ml-auto lg:ml-0 mr-5 lg:mr-0 space-x-5 lg:space-x-5 xl:space-x-10 lg:justify-end lg:pr-8 2xl:pr-0\">\n            <!--Customer Icon & Dropdown-->\n            \n<div class=\"relative inline-block\">\n    <a\n        href=\"https&#x3A;&#x2F;&#x2F;dunkin.co.uk&#x2F;customer&#x2F;account&#x2F;\"\n        id=\"customer-menu\"\n        class=\"block no-underline md-max:w-[24px]\"\n        title=\"My&#x20;Account\"\n        aria-label=\"My&#x20;Account\"\n    >\n        <i class=\"icon-account icon-lg\"></i>\n    </a>\n</div>\n\n            <!--Cart Icon-->\n            <a id=\"menu-cart-icon\"\n                class=\"no-underline relative md-max:w-[24px]\"\n                aria-label=\"Basket\"\n                                href=\"https://dunkin.co.uk/checkout/cart/index/\">\n                <i class=\"icon-cart icon-lg\"></i>\n                <span class=\"label hidden lg:block\">\n                    Basket                </span>\n\n                <span x-text=\"cart.summary_count\"\n                    class=\"absolute top-0 right-0 hidden h-5 px-2 py-1 -mt-5 -mr-4 text-2xs font-semibold\n                        leading-none text-center text-white uppercase transform -translate-x-1\n                        translate-y-1/2 rounded-full bg-pink\"\n                    :class=\"{\n                        'hidden': !cart.summary_count,\n                        'block': cart.summary_count }\"></span>\n            </a>\n\n        </div>\n    </div>\n\n    </div>\n<style type=\"text/css\">\n    @media (max-width: 769px) {\n        .cms-home .services-block .pagebuilder-column-group {\n            grid-template-rows: 450px repeat(2, 452px) 360px;\n        }\n        .cms-home .services-block .pagebuilder-banner-wrapper, .cms-home .services-block .pagebuilder-column.promo-banner-3 {\n            background-size: auto 75% !important;\n        }\n    }\n    @media (max-width: 480px) {\n        .cms-home .services-block .pagebuilder-column-group {\n            grid-template-rows: 460px repeat(2, 452px) 360px;\n        }\n        .cms-home .services-block .pagebuilder-banner-wrapper, .cms-home .services-block .pagebuilder-column.promo-banner-3 {\n            background-size: auto 65% !important;\n        }\n    }\n    @media (max-width: 400px) {\n        .cms-home .services-block .pagebuilder-banner-wrapper, .cms-home .services-block .pagebuilder-column.promo-banner-3 {\n            background-size: auto 55% !important;\n        }\n    }\n</style>\n<style>\n    .product-item .price-container .price-label {\n        display : none !important;\n    }\n</style></header><main id=\"maincontent\" class=\"page-main\"><div id=\"contentarea\" tabindex=\"-1\"></div>\n<div class=\"page messages\"><script>\n        function initMessages() {\n        \"use strict\";\n        return {\n            messages: window.mageMessages || [],\n            isEmpty() {\n                return this.messages.reduce(\n                    function (isEmpty, message) {\n                        return isEmpty && message === undefined\n                    }, true\n                )\n            },\n            removeMessage(messageIndex) {\n                this.messages[messageIndex] = undefined;\n            },\n            addMessages(messages, hideAfter) {\n                messages.map((message) => {\n                    this.messages = this.messages.concat(message);\n                    if (hideAfter === undefined && message.type === 'success' && window.defaultSuccessMessageTimeout) {\n                        hideAfter = window.defaultSuccessMessageTimeout;\n                    }\n                    if (hideAfter) {\n                        this.setHideTimeOut(this.messages.length -1, hideAfter);\n                    }\n                });\n            },\n            setHideTimeOut(messageIndex, hideAfter) {\n                setTimeout((messageIndex) => {\n                    this.removeMessage(messageIndex);\n                }, hideAfter, messageIndex);\n            },\n            eventListeners: {\n                ['@messages-loaded.window'](event) {\n                    this.addMessages(event.detail.messages, event.detail.hideAfter)\n                },\n                ['@private-content-loaded.window'](event) {\n                    const data = event.detail.data;\n                    if (\n                        data.messages &&\n                        data.messages.messages &&\n                        data.messages.messages.length\n                    ) {\n                        this.addMessages(data.messages.messages);\n                    }\n                },\n                ['@clear-messages.window']() {\n                    this.messages = [];\n                }\n            }\n        }\n    }\n</script>\n<section id=\"messages\"\n         x-data=\"initMessages()\"\n         x-bind=\"eventListeners\"\n         aria-live=\"assertive\"\n         role=\"alert\"\n>\n    <template x-if=\"!isEmpty()\">\n       <div class=\"w-full\">\n            <div role=\"alert\" class=\"messages container mx-auto\">\n                <template x-for=\"(message, index) in messages\" :key=\"index\">\n                    <div>\n                        <template x-if=\"message\">\n                            <div class=\"message\" :class=\"message.type\"\n                                 :ui-id=\"'message-' + message.type\"\n                            >\n                                <span x-html=\"message.text\"></span>\n                                <a href=\"#\" class=\"close clear\" title=\"close\"\n                                   @click.prevent=\"removeMessage(index)\">\n                                    <i class=\"icon-close icon-lg\"></i>\n                                </a>\n                            </div>\n                        </template>\n                    </div>\n                </template>\n            </div>\n        </div>\n    </template>\n</section>\n</div><div class=\"columns\"><div class=\"column main\">\n    <script>\n        if (window.require) {\n            require(['jquery', 'Magefan_Blog/js/lib/mfblogunveil', 'domReady!'], function($){\n                $('.mfblogunveil').mfblogunveil();\n            });\n        } else {\n            /* e.g. hyva theme */\n            document.addEventListener(\"DOMContentLoaded\", function(){\n                var items =  document.getElementsByClassName('mfblogunveil');\n                var el, url;\n                if (items.length) {\n                    for (var i=0; i<items.length;i++) {\n                        el = items[i];\n                        url = el.getAttribute('data-original');\n                        if (!url) {\n                            continue;\n                        }\n                        if ('IMG' == el.tagName) {\n                            el.src = url;\n                        } else {\n                            el.style.backgroundImage = \"url('\" + url  + \"')\";\n                        }\n                    }\n                }\n            });\n        }\n    </script>\n\n<style>#html-body [data-pb-style=MWBE5VC]{justify-content:flex-start;display:flex;flex-direction:column;background-position:left top;background-size:cover;background-repeat:no-repeat;background-attachment:scroll;text-align:center}#html-body [data-pb-style=P381BNP]{text-align:center}#html-body [data-pb-style=ECN88BF]{background-position:left top;background-size:cover;background-repeat:no-repeat;min-height:600px}#html-body [data-pb-style=T3MYXN5]{min-height:600px;background-color:transparent}#html-body [data-pb-style=OMLLUI5]{background-position:left top;background-size:cover;background-