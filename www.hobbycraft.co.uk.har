n_panel_im\", \"name\": \"URL Targeting for [BL-QA] [HC-111] [Login slide in panel] Improved sign in error prompt\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}, {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://stg-sfcc.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"callback\", \"activationCode\": /**\n * Sample Activation Function\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-callback\n * @param {Function} activate - Call this function when you want to activate the page.\n * @param {Object} options - An object containing Page information.\n */\n\nfunction callbackFn(activate, options) {\n\tconst utils = window[\"optimizely\"].get(\"utils\");\n\n\tlet observer;\n\tlet disconnectTimeoutId;\n\n\tconst disconnectObserver = () => {\n\t\tif (disconnectTimeoutId) {\n\t\t\tclearTimeout(disconnectTimeoutId);\n\t\t\tdisconnectTimeoutId = null;\n\t\t}\n\t\tif (observer) {\n\t\t\tobserver.disconnect();\n\t\t\tobserver = null;\n\t\t}\n\t};\n\n\tconst checkForSignInErrorMessage = () => {\n\t\tconst signInErrorMessage = document.querySelector(\".b-dialog.m-panel section.l-signin_form div.b-form-message.b-message.m-error:not([hidden])\");\n\n\t\t// Check if there is a sign in error message\n\t\tif (signInErrorMessage) {\n\t\t\tdisconnectObserver();\n\t\t\tactivate();\n\t\t}\n\t};\n\n\tutils.waitForElement(\"body\").then(() => {\n\t\tobserver = new MutationObserver(checkForSignInErrorMessage);\n\t\tobserver.observe(document.body, { childList: true, subtree: true });\n\n\t\tcheckForSignInErrorMessage();\n\t});\n}\n}, {\"id\": \"6491367078100992\", \"category\": \"other\", \"apiName\": \"25251511284_cc_basket_page_view__referrer_checkout\", \"name\": \"[C&C] Basket Page View - Referrer Checkout\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/cart/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": function pollingFn() {\n\n  // Check if the referrer includes the specified URL\n  const isReferrerValid = document.referrer.includes(\"https://www.hobbycraft.co.uk/checkout\");\n\n  // Check if the element exists with the specific aria-label and aria-selected attributes\n  const isElementSelected = document.querySelector('[aria-label=\"Click & Collect\"][aria-selected=\"true\"]') !== null &&  document.querySelector('[aria-label=\"Home Delivery\"][aria-selected=\"true\"]') === null;\n\n  // Return true if all conditions are met\n  return isReferrerValid && isElementSelected;\n}\n}, {\"id\": \"6495912474705920\", \"category\": \"other\", \"apiName\": \"25251511284_logged_out_checkout\", \"name\": \"[Logged out] Checkout\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"simple\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/checkout/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"polling\", \"activationCode\": /**\n * Sample Polling Function\n * Supply an expression to return a boolean inside a function.\n * For complete documentation, see https://docs.developers.optimizely.com/web/docs/dynamic-websites#section-polling\n */\n\nfunction pollingFn() {\n  return sessionStorage.getItem(\"BL-HC-login-status\") === 'guest';\n}\n}, {\"id\": \"6542188335595520\", \"category\": \"other\", \"apiName\": \"hc113_1_logic\", \"name\": \"[HC-113.1] [Sitewide] Login/Registration slide in panel UX flow\", \"staticConditions\": [\"and\", [\"or\", {\"match\": \"substring\", \"type\": \"url\", \"value\": \"https://www.hobbycraft.co.uk/\"}]], \"deactivationEnabled\": false, \"undoOnDeactivation\": false, \"tags\": [], \"activationType\": \"manual\"}, {\"id\": \"6548551040237568\", \"catego