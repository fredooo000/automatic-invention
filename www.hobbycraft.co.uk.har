      try {\n        return func(...args);\n      } catch (error) {\n        const logInfo = `BL --> ${context || \"withErrorHandling\"}`;\n        console.error(logInfo, error.message);\n        return null;\n      }\n    };\n  }\n\n  var addAdditionalTestIdToDebugger = withErrorHandling((testId, variation) => {\n    const debuggerTitle = document.querySelector(\"div#bl-qa-debugger-title\");\n    const textFragment = `${testId} v${variation}`;\n    if (!debuggerTitle.innerText.includes(textFragment)) {\n      debuggerTitle.insertAdjacentHTML(\"beforeEnd\", `<span>${testId} v${variation}</span>`);\n    }\n  }, \"addAdditionalTestIdToDebugger error\");\n  var checkDebugMode_default = withErrorHandling((testId, variation) => {\n    const debugMode = localStorage.getItem(\"blDebugMode\");\n    if (!debugMode || debugMode === \"dev\" || !testId || typeof variation !== \"number\")\n      return;\n    waitForElement_default(\"#bl-qa-debugger\").then(() => {\n      addAdditionalTestIdToDebugger(testId, variation);\n    });\n    return debugMode ? 1 : 0;\n  }, \"checkDebugMode error\");\n\n  (() => {\n    withErrorHandling(() => {\n      const variation = 0, testId = \"HC-113-1\", debugMode = checkDebugMode_default(testId, variation), logInfo = `bl-${testId} -->`;\n      if (!document.documentElement.classList.contains(`${testId}_var_${variation}`)) {\n        document.documentElement.classList.add(`${testId}_var_${variation}`);\n        let _window = window;\n        if (typeof unsafeWindow !== \"undefined\")\n          _window = unsafeWindow;\n        let attempts = 0;\n        const interval = setInterval(withErrorHandling(() => {\n          if (_window[testId]) {\n            clearInterval(interval);\n            _window[testId].init(variation, debugMode);\n          }\n          if (++attempts > 100) {\n            clearInterval(interval);\n            if (debugMode)\n              console.error(logInfo, \"Can't find shared.js init function.\");\n          }\n        }, \"HC-113.1 error trying to find shared.js init function\"), 25);\n      }\n    }, \"HC-113.1 control error\")();\n  })();\n})();\n}, \"dependencies\": []}]}]}, {\"id\": \"6190328777015296\", \"name\": \"Variation #1\", \"actions\": [{\"viewId\": \"6542188335595520\", \"changes\": [{\"id\": \"2b1eeb8022704afa9f4e5cfe8e1b42f5\", \"type\": \"custom_code\", \"value\": function($){(() => {\n\n  var waitForElement_default = (selector) => {\n    const logInfo = \"BL --> waitForElement\";\n    try {\n      return new Promise((resolve) => {\n        try {\n          if (document.querySelector(selector)) {\n            resolve(document.querySelector(selector));\n            return;\n          }\n          const observer = new MutationObserver(() => {\n            try {\n              if (document.querySelector(selector)) {\n                observer.disconnect();\n                resolve(document.querySelector(selector));\n              }\n            } catch (err) {\n              console.error(logInfo, err.message);\n            }\n          });\n          observer.observe(document.documentElement, {\n            childList: true,\n            subtree: true\n          });\n        } catch (err) {\n          console.error(logInfo, err.message);\n        }\n      });\n    } catch (err) {\n      console.error(logInfo, err.message);\n    }\n  };\n\n  function withErrorHandling(func, context = \"\") {\n    return (...args) => {\n      try {\n        return func(...args);\n      } catch (error) {\n        const logInfo = `BL --> ${context || \"withErrorHandling\"}`;\n        console.error(logInfo, error.message);\n        return null;\n      }\n    };\n  }\n\n  var addAdditionalTestIdToDebugger = withErrorHandling((testId, variation) => {\n    const debuggerTitle = document.querySelector(\"div#bl-qa-debugger-title\");\n    const textFragment = `${testId} v${variation}`;\n    if (!debuggerTitle.innerText.includes(textFragment)) {\n      debuggerTitle.insertAdjacentHTML(\"beforeEnd\", `<span>${testId} v${variation}</span>`);\n    }\n  }, \"addAdditionalTestIdToDebugger error\");\n  var checkDebugMode_default = withErrorHandling((testId, variation) => {\n    const debugMode = localStorage.getItem(\"blDebugMode\");\n    if (!debugMode || debugMode === \"dev\" || !testId || typeof variation !== \"number\")\n      return;\n    waitForElement_default(\"#bl-qa-debugger\").then(() => {\n      addAdditionalTestIdToDebugger(testId, variation);\n    });\n    return debugMode ? 1 : 0;\n  }, \"checkDebugMode error\");\n\n  (() => {\n    withErrorHandling(() => {\n      const variation = 1, testId = \"HC-113-1\", debugMode = checkDebugMode_default(testId, variation), logInfo = `bl-${testId} -->`;\n      if (!document.documentElement.classList.contains(`${testId}_var_${variation}`)) {\n        document.documentElement.classList.add(`${testId}_var_${variation}`);\n        document.documentElement.classList.add(`${testId}_var`);\n        let _window = window;\n        if (typeof unsafeWindow !== \"undefined\")\n          _window = unsafeWindow;\n        let attempts = 0;\n        const interval = setInterval(withErrorHandling(() => {\n          if (_window[testId]) {\n            clearInterval(interval);\n            _window[testId].init(variation, debugMode);\n          }\n          if (++attempts > 100) {\n            clearInterval(interval);\n            if (debugMode)\n              console.error(logInfo, \"Can't find shared.js init function.\");\n          }\n        }, `${logInfo} error trying to find shared.js init function`), 25);\n        const LOGIN_PANEL_ENDPOINT = \"Login-ShowLoginPanel\", ACCOUNT_HEADER_SELECTOR = '.b-header_actions-account[data-widget=\"accountHeaderLink\"]';\n        const patchLoginPanelUrl = withErrorHandling((url) => {\n          if (!url || typeof url !== \"string\" || !url.includes(LOGIN_PANEL_ENDPOINT)) {\n            return url;\n          }\n          if (url.includes(\"variant=legacy\")) {\n            return url;\n          }\n          return `${url}${url.includes(\"?\") ? \"&\" : \"?\"}variant=legacy`;\n        }, `${logInfo} patchLoginPanelUrl error`);\n        const patchAccountHeaderLoginUrl = withErrorHandling((accountHeader) => {\n          const currentUrl = accountHeader.getAttribute(\"data-login-panel-url\");\n          if (!currentUrl) {\n            return;\n          }\n          const legacyUrl = patchLoginPanelUrl(currentUrl);\n          if (legacyUrl !== currentUrl) {\n            accountHeader.setAttribute(\"data-login-panel-url\", legacyUrl);\n            if (debugMode) {\n              console.log(logInfo, \"Updated data-login-panel-url to legacy variant\");\n            }\n          }\n        }, `${logInfo} patchAccountHeaderLoginUrl error`);\n        const interceptLoginPanelRequests = withErrorHandling(() => {\n          if (_window[`${testId}_legacyLoginIntercept`]) {\n            return;\n          }\n          _window[`${testId}_legacyLoginIntercept`] = true;\n          const originalFetch = _window.fetch.bind(_window);\n          _window.fetch = (input, init) => {\n            if (typeof input === \"string\") {\n              return originalFetch(patchLoginPanelUrl(input), init);\n            }\n            if (input instanceof _window.Request && input.url.includes(LOGIN_PANEL_ENDPOINT)) {\n              const legacyUrl = patchLoginPanelUrl(input.url);\n              if (legacyUrl !== input.url) {\n                return originalFetch(new _window.Request(legacyUrl, input), init);\n              }\n            }\n            return originalFetch(input, init);\n          };\n          const originalOpen = _window.XMLHttpRequest.prototype.open;\n          _window.XMLHttpRequest.prototype.open = function(method, url, ...args) {\n            return originalOpen.call(this, method, patchLoginPanelUrl(url), ...args);\n          };\n        }, `${logInfo} interceptLoginPanelRequests error`);\n        const observeAccountHeader = withErrorHandling(() => {\n    