ned by zmags\n    if (isQuickviewCall(url) && isZmagsSource(url)) {\n      handleQuickviewOpened(url);\n    } else if (isAddProductCall(url, options)) {\n      if (isZmagsSource(options.data)) {\n        handleProductAdded(options.data);\n      } else if (isZmagsSource(url)) {\n        handleProductAdded(url);\n      }\n    } else if (isProductVariationCall(url)) {\n      // on swatch click the whole form gets overwritten, with the response of the Product-Variation call.\n      // so we need to append the zmagssrc hidden field again\n      appendZmagsHiddenField();\n    }\n  }\n\n  /**\n   * Append a hidden zmagssrc input field to each form on the quickview page.\n   * This parameter will be sent to the server on add to cart clicks\n   */\n  function appendZmagsHiddenField() {\n    var $contentWrapper = $('#pdpMain'),\n      $form = $contentWrapper.find('form'),\n      zmagsSource = $contentWrapper.data('zmagssrc');\n    if (zmagsSource != null) {\n      $form.each(function () {\n        if ($(this).find('input[name=zmagssrc]').length == 0) {\n          $('<input type=\"hidden\" name=\"zmagssrc\" value=\"' + zmagsSource + '\">').appendTo($(this));\n        }\n      });\n    }\n  }\n\n  /**\n   * Public initialization function\n   */\n  function init() {\n    if (isTrackingEnabled()) {\n      initializeAnalytics();\n    }\n  }\n\n  /**\n   * Private initialization function, registering callbacks, firing events\n   */\n  function initializeAnalytics() {\n    var quickview = getQuickview();\n    if (quickview != null) {\n      // register callback which fires after an ajax requested has completed\n      $(document).ajaxComplete(ajaxCompleteCallback);\n    } else {\n      console.log('Zmags Creator Analytics Error: quickview == null');\n    }\n    var pageNamespace = getPageNamespace();\n    if (pageNamespace && zmagsData.zmagsSource === ZMAGSSOURCE) {\n      var $wrapper = $('#wrapper');\n      if (pageNamespace === 'cart' && $wrapper.find('#cart-items-form').length > 