Quotient.getCQUserId();\n\t\tcq_params.emailId = CQuotient.getCQHashedEmail();\n\t\tcq_params.loginId = CQuotient.getCQHashedLogin();\n\t\tcq_params.accumulate = true;\n\t\tcq_params.products = [{\n\t\t\tid: '',\n\t\t\tsku: '',\n\t\t\ttype: 'set',\n\t\t\talt_id: 'pride-craft-ideas'\n\t\t}];\n\t\tcq_params.recommenderName = '__UNDEFINED__';\n\t\tcq_params.realm = \"BHCG\";\n\t\tcq_params.siteId = \"hobbycraft-uk\";\n\t\tcq_params.instanceType = \"prd\";\n\t\tcq_params.locale = window.CQuotient.locale;\n\t\tcq_params.slotId = '';\n\t\tcq_params.slotConfigId = '';\n\t\tcq_params.slotConfigTemplate = '';\n\t\tif(window.CQuotient.sendActivity)\n\t\t\twindow.CQuotient.sendActivity( CQuotient.clientId, 'viewReco', cq_params );\n\t\telse\n\t\t\twindow.CQuotient.activities.push( {activityType: 'viewReco', parameters: cq_params} );\n\t}\n} catch(err) {}\n})();\n/* ]]> */\n// -->\n</script>\n<script type=\"text/javascript\">//<!--\n/* <![CDATA[ (viewProduct-active_data.js) */\ndw.ac._capture({id: \"pride-craft-ideas\", type: \"recommendation\"});\n/* ]]> */\n// -->\n</script>\n                                        \n\n<section\n    class=\"b-product_tile\"\n    aria-label=\"13 Pride Craft Ideas\"\n    data-id=\"productTile-pride-craft-ideas\"\n    data-pid=\"pride-craft-ideas\"\n    data-ready-to-order=\"1\"\n    data-product-name=\"13 Pride Craft Ideas\"\n    data-product-options=\"null\"\n    data-product-id=\"pride-craft-ideas\"\n    data-widget=\"productTile\"\n    data-analytics=\"{&quot;id&quot;:&quot;pride-craft-ideas&quot;,&quot;name&quot;:&quot;13 Pride Craft Ideas&quot;,&quot;category&quot;:&quot;Pride Craft Ideas&quot;,&quot;topLevelCategory&quot;:&quot;Ideas&quot;,&quot;craft&quot;:&quot;Decor &amp; Hobbies&quot;,&quot;url&quot;:&quot;www.hobbycraft.co.uk/ideas/pride-craft-ideas.html&quot;,&quot;imageUrl&quot;:&quot;www.hobbycraft.co.uk/dw/image/v2/BHCG_PRD/on/demandware.static/-/Sites-hobbycraft-uk-master/default/dw36df4324/images/Ideas/article/main/Idea_main_13