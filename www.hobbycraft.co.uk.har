em(\"blDebugMode\");\n      if (!debugMode || debugMode === \"dev\" || !testId || typeof variation !== \"number\")\n        return;\n      waitForElements_default(\n        \"#bl-qa-debugger\",\n        // QA Debugger\n        false,\n        () => {\n          try {\n            addAdditionalTestIdToDebugger(testId, variation);\n          } catch (e) {\n            if (debugMode)\n              console.error(e.message);\n          }\n        }\n      );\n      return debugMode ? 1 : 0;\n    } catch (e) {\n      console.log(e.message);\n    }\n  };\n  (() => {\n    const variation = 1, testId = \"HC-111\", prefixClass = `bl-${testId.toLowerCase()}`, debugMode = checkDebugMode_default(testId, variation), logInfo = testId + \" -->\";\n    try {\n      if (!document.documentElement.classList.contains(`${testId}_var_${variation}`)) {\n        document.documentElement.classList.add(`${testId}_var_${variation}`);\n        document.documentElement.classList.add(`${testId}_var`);\n        let _window = window;\n        if (typeof unsafeWindow !== \"undefined\")\n          _window = unsafeWindow;\n        let attempts = 0;\n        const interval = setInterval(() => {\n          try {\n            if (_window[testId]) {\n              clearInterval(interval);\n              _window[testId].init(variation, debugMode);\n            }\n            if (++attempts > 100) {\n              clearInterval(interval);\n              if (debugMode)\n                console.error(logInfo, \"Can't find shared.js init function.\");\n            }\n          } catch (e) {\n            if (debugMode)\n              console.error(logInfo, e.message);\n          }\n        }, 25);\n        const sendOptimizelyEvent = (eventName, value) => {\n          try {\n            const info = {\n              type: \"event\",\n              eventName\n            };\n            if (value !== void 0 && value !== null) {\n              info[\"tags\"] = {\n                value\n              };\n            }\n            _window[\"optimizely\"].push(info);\n            if (debugMode) {\n              if (value !== void 0 && value !== null) {\n                console.log(logInfo, \"Optimizely event sent:\", eventName, \"value:\", value);\n              } else {\n                console.log(logInfo, \"Optimizely event sent:\", eventName);\n              }\n            }\n          } catch (e) {\n            if (debugMode)\n              console.error(logInfo, \"Error in sendOptimizelyEvent:\", e.message);\n          }\n        };\n        const checkForSignInErrorMessage = () => {\n          const signInErrorMessage = document.querySelector(`.b-dialog.m-panel section.l-signin_form div.b-form-message.b-message.m-error:not([hidden]):not(:has(.${prefixClass}-error-button))`);\n          if (signInErrorMessage) {\n            signInErrorMessage.innerHTML = `\n\t\t\t\t\t\t<h2 class=\"${prefixClass}-error-heading\">We didn't recognise your details</h2>\n\t\t\t\t\t\t<p class=\"${prefixClass}-error-message\">Please check that you have entered your email or password correctly</p>\n\t\t\t\t\t\t<button class=\"${prefixClass}-error-button\" type=\"button\">Reset Your Password</button>\n\t\t\t\t\t`;\n            const resetButton = signInErrorMessage.querySelector(`.${prefixClass}-error-button`);\n            resetButton.addEventListener(\"click\", () => {\n              const passwordResetButton = document.querySelector(\".b-dialog.m-panel section.l-signin_form button#password-reset\");\n              if (passwordResetButton) {\n                sendOptimizelyEvent(`${prefixClass}_login_sidebar_panel_password_reset_cta_click`);\n                passwordResetButton.click();\n              } else if (debugMode) {\n                console.warn(logInfo, \"Password reset button not found\");\n              }\n            });\n          }\n        };\n        waitForElements_default(\"body\", false, (body) => {\n          try {\n            new MutationObserver(checkForSignInErrorMessage).observe(body, { childList: true, subtree: true });\n            checkForSignInErrorMessage();\n          } catch (e) {\n            if (debugMode)\n              console.error(logInfo, e.message);\n          }\n        });\n      }\n    } catch (e) {\n      if (debugMode)\n        console.error(logInfo, e.message);\n    }\n  })();\n})();\n}, \"dependencies\": []}, {\"id\": \"1506C5E5-CF82-451A-ADC2-578B28F009D4\", \"type\": \"append\", \"selector\": \"head\", \"value\": \"<style>/*\\n** Author: Nuno\\n** Company: Biglight\\n** Date: 12/2025\\n** Test: HC-111\\n** Variation: Variation-1\\n*/\\n.HC-111_var_1 .b-dialog.m-panel section.l-signin_form div.b-form-message.b-message.m-error {\\n  padding: 16px;\\n  width: 100%;\\n  background: #eaf7f6;\\n  border: 1px solid #a42015;\\n  border-radius: 4px;\\n  display: flex;\\n  flex-direction: column;\\n  justify-content: center;\\n  gap: 8px;\\n}\\n.HC-111_var_1 .bl-hc-111-error-heading, .HC-111_var_1 .bl-hc-111-error-message {\\n  font-style: normal;\\n  font-weight: 500;\\n  line-height: 1.25;\\n  text-align: center;\\n  color: #45132c;\\n}\\n.HC-111_var_1 .bl-hc-111-error-heading {\\n  font-size: 17px;\\n  font-weight: 700;\\n}\\n.HC-111_var_1 .bl-hc-111-error-message {\\n  font-size: 14px;\\n}\\n.HC-111_var_1 .bl-hc-111-error-button {\\n  display: flex;\\n  flex-direction: row;\\n  justify-content: center;\\n  align-items: center;\\n  padding: 13px 26px;\\n  gap: 10px;\\n  background: #ffffff;\\n  border: 1px solid #f2f2f2;\\n  border-radius: 40px;\\n  font-style: normal;\\n  font-weight: 500;\\n  font-size: 15px;\\n  line-height: 1;\\n  text-transform: capitalize;\\n  color: #45132c;\\n  cursor: pointer;\\n  transition: all 0.3s ease;\\n}\\n.HC-111_var_1 .bl-hc-111-error-button:hover {\\n  background: #45132c;\\n  color: #fff;\\n  border-color: #45132c;\\n}</style>\", \"dependencies\": []}]}]}], \"weightDistributions\": [{\"entityId\": \"5801556952481792\", \"endOfRange\": 5000}, {\"entityId\": \"5704879319023616