 component object\n  if (util.viewport.isTablet() === true) {\n    component.init(3);\n  } else if (util.viewport.isLarge() === true) {\n    component.init(4);\n  } else {\n    component.init(5);\n  }\n\n  //relocate pdp tabs\n  if (util.viewport.isMobile() && $('.menu-mobile').find('.component-content').length === 0 || !util.viewport.isMobile() && $('.component-wrapper').find('.component-content').length === 0) {\n    lcgResponsive.move(util.viewport.isMobile(), '.component-content', '.menu-mobile', '.component-wrapper');\n  }\n  lcgResponsive.move(util.viewport.isMobile(), '.product-setlist-wrapper', '.product-setlist-mobile', '.product-setlist-desktop');\n};\n\n/**\n * @description Initialize product detail page with reviews, recommendation and product navigation.\n */\nfunction initializeDom() {\n  productTabs.init();\n  productNav();\n  recommendations();\n  fireReadyResize();\n  $(window).smartresize(fireReadyResize);\n  // Activate Quantity Selector\n  quantity.init();\n  alterUpsell.init();\n  ordergroove.setProduct();\n  pdpRecommendations.init();\n}\n\n/**\n * @description open reviews tab before click is fired on BV ratings stars\n */\nvar PDPBVInlineRatings = function PDPBVInlineRatings() {\n  var PDPInlineRatings = $('#inlineRatings');\n  if (PDPInlineRatings.length) {\n    $('#BVRRSummaryContainer').on('click', '.bv-rating-stars', scrollToReviews);\n  } else if ($('.review-link').length > 0) {\n    // BV link anchors & triggers product review tabs\n    $('.review-link').on('click', scrollToReviews);\n  }\n};\nfunction scrollToReviews() {\n  var $reviewsTab = util.viewport.isMobile() ? $('.reviews.tab-mobile-title') : $('.reviews.ui-tabs-anchor');\n  var scrollTopToReviews = util.viewport.isMobile() ? $reviewsTab.offset().top - 75 : $reviewsTab.offset().top;\n  $('html').animate({\n    scrollTop: scrollTopToReviews\n  }, 500, function () {\n    if (!$reviewsTab.hasClass('active')) {\n      $reviewsTab.trigger('click');\n      $(this).removeAttr('href');