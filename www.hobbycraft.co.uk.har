6980972544\", \"endOfRange\": 7500}, {\"entityId\": \"5790646905077760\", \"endOfRange\": 10000}], \"name\": \"[QA] [HC-125] [PDP] Pop up PDP only \", \"bucketingStrategy\": null, \"experimentMetadata\": {\"allocationPolicy\": \"manual\", \"layerId\": \"6314872393170944\"}, \"deployed\": false}], \"policy\": \"single_experiment\", \"viewIds\": [\"5535800994037760\"], \"weightDistributions\": null, \"decisionMetadata\": null, \"concluded\": false}, {\"changes\": [{\"id\": \"EA55D240-A813-41BE-85C8-13EE80A61168\", \"type\": \"custom_code\", \"value\": function($){(() => {\n\n  var waitForElement_default = (selector) => {\n    const logInfo = \"BL --> waitForElement\";\n    try {\n      return new Promise((resolve) => {\n        try {\n          if (document.querySelector(selector)) {\n            resolve(document.querySelector(selector));\n            return;\n          }\n          const observer = new MutationObserver(() => {\n            try {\n              if (document.querySelector(selector)) {\n                observer.disconnect();\n                resolve(document.querySelector(selector));\n              }\n            } catch (err) {\n              console.error(logInfo, err.message);\n            }\n          });\n          observer.observe(document.documentElement, {\n            childList: true,\n            subtree: true\n          });\n        } catch (err) {\n          console.error(logInfo, err.message);\n        }\n      });\n    } catch (err) {\n      console.error(logInfo, err.message);\n    }\n  };\n\n  function withErrorHandling(func, context = \"\") {\n    return (...args) => {\n      try {\n        return func(...args);\n      } catch (error) {\n        const logInfo = `BL --> ${context || \"withErrorHandling\"}`;\n        console.error(logInfo, error.message);\n        return null;\n      }\n    };\n  }\n\n  (() => {\n    withErrorHandling(() => {\n      const testId = \"HC-113-1-TRIGGER\", logInfo = `bl-${testId} -->`;\n      let variation, debugMode = 1;\n      let _window = window;\n      if (typeof unsafeWindow !== \"undefined\")\n        _window = unsafeWindow;\n      window[\"optimizely\"] = window[\"optimizely\"] || [];\n      if (document.documentElement.classList.contains(`${testId}`))\n        return;\n      document.documentElement.classList.add(`${testId}`);\n      waitForElement_default(\"header a.b-header_login-link\").then(withErrorHandling((headerLoginLink) => {\n        const fakeHeaderLoginLink = `\n\t\t\t\t<a class=\"b-header_login-link HC-113-1-TRIGGER_fake_header_login_link\" href=\"#\" rel=\"nofollow\" title=\"Sign in\" aria-label=\"Sign in\" >\n                    <span class=\"b-header_login-icon b-header_login-icon_guest\" data-ref=\"loginIcon\">\n                        <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" role=\"presentation\">\n\t\t\t\t\t\t\t<use href=\"#user\"></use>\n\t\t\t\t\t\t</svg>\n                    </span>\n                    <span class=\"b-header_login-caption\">Sign in</span>\n                </a>\n\t\t\t`;\n        headerLoginLink.insertAdjacentHTML(\"afterend\", fakeHeaderLoginLink);\n        const fakeHeaderLoginLinkElement = document.querySelector(\"a.HC-113-1-TRIGGER_fake_header_login_link\");\n        fakeHeaderLoginLinkElement.addEventListener(\"click\", withErrorHandling((e) => {\n          e.preventDefault();\n          e.stopPropagation();\n          window[\"optimizely\"].push({\n            type: \"page\",\n            pageName: \"hc113_1_logic\"\n          });\n        }, `${logInfo} fakeHeaderLoginLink click error`));\n      }, `${logInfo} waitForElement headerLoginLink error`));\n    }, `HC-113.1-TRIGGER trigger error`)();\n  })();\n})();\n}, \"dependencies\": []}, {\"id\": \"AC5D345C-23AA-4379-9BB8-9FCBE1EE7EDE\", \"type\": \"append\", \"selector\": \"head\", \"value\": \"<style>.HC-113-1-TRIGGER header a.b-header_login-link {\\n  display: none;\\n}\\n.HC-113-1-TRIGGER header a.b-header_login-link.HC-113-1-TRIGGER_fake_header_logi