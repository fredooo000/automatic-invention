count\";\n        }\n        if (isLoginSidebarNewAccountStep()) {\n          return \"new_account\";\n        }\n        if (isLoginSidebarPartialAccountStep()) {\n          return \"partial_account\";\n        }\n        return null;\n      }, `${logInfo} getCurrentLoginSidebarStepType error`);\n      const getLatestLoginSidebarStepClass = withErrorHandling(() => {\n        if (latestLoginSidebarStepType === \"email\") {\n          return LOGIN_SIDEBAR_STEP_CLASS_EMAIL;\n        }\n        if (latestLoginSidebarStepType === \"existing_account\") {\n          return LOGIN_SIDEBAR_STEP_CLASS_EXISTING_ACCOUNT;\n        }\n        if (latestLoginSidebarStepType === \"new_account\") {\n          return LOGIN_SIDEBAR_STEP_CLASS_NEW_ACCOUNT;\n        }\n        if (latestLoginSidebarStepType === \"partial_account\") {\n          return LOGIN_SIDEBAR_STEP_CLASS_PARTIAL_ACCOUNT;\n        }\n        return null;\n      }, `${logInfo} getLatestLoginSidebarStepClass error`);\n      const applyLatestLoginSidebarStepClass = withErrorHandling(() => {\n        const nextClass = getLatestLoginSidebarStepClass();\n        const html = document.documentElement;\n        let classChanged = false;\n        LOGIN_SIDEBAR_STEP_TYPE_CLASSES.forEach((className) => {\n          if (html.classList.contains(className) && className !== nextClass) {\n            html.classList.remove(className);\n            classChanged = true;\n          }\n        });\n        if (nextClass && !html.classList.contains(nextClass)) {\n          html.classList.add(nextClass);\n          classChanged = true;\n        }\n        return classChanged;\n      }, `${logInfo} applyLatestLoginSidebarStepClass error`);\n      const syncLoginSidebarStepType = withErrorHandling(() => {\n        if (isSyncingLoginSidebarStepClass) {\n          return;\n        }\n        const currentStepType = getCurrentLoginSidebarStepType();\n        const stepTypeChanged = !!currentStepType && currentStepType !== latestLoginSidebarStepType;\n        if (currentStepType) {\n          latestLoginSidebarStepType = currentStepType;\n        }\n        isSyncingLoginSidebarStepClass = true;\n        const classChanged = applyLatestLoginSidebarStepClass();\n        isSyncingLoginSidebarStepClass = false;\n        if (debugMode && (stepTypeChanged || classChanged)) {\n          console.log(logInfo, \"Login sidebar step:\", latestLoginSidebarStepType);\n        }\n      }, `${logInfo} syncLoginSidebarStepType error`);\n      const observeLoginSidebarStepTarget = withErrorHandling((target) => {\n        if (loginSidebarStepObserver) {\n          loginSidebarStepObserver.disconnect();\n        }\n        loginSidebarStepObserver = new MutationObserver(syncLoginSidebarStepType);\n        loginSidebarStepObserver.observe(target, {\n          childList: true,\n          subtree: true,\n          attributes: true,\n          attributeFilter: [\"class\"]\n        });\n      }, `${logInfo} observeLoginSidebarStepTarget error`);\n      const installLoginSidebarStepObserver = withErrorHandling(() => {\n        syncLoginSidebarStepType();\n        const popup = document.querySelector(LOGIN_DRAWER_SELECTOR);\n        if (popup) {\n          observeLoginSidebarStepTarget(popup);\n          return;\n        }\n        if (loginSidebarStepObserver) {\n          loginSidebarStepObserver.disconnect();\n        }\n        loginSidebarStepObserver = new MutationObserver(withErrorHandling(() => {\n          const popupRoot = document.querySelector(LOGIN_DRAWER_SELECTOR);\n          if (popupRoot) {\n            syncLoginSidebarStepType();\n            observeLoginSidebarStepTarget(popupRoot);\n          }\n        }, `${logInfo} loginSidebarStepObserver bootstrap error`));\n        loginSidebarStepObserver.observe(document.body, {\n          childList: true,\n          subtree: true\n        });\n      }, `${logInfo} installLoginSidebarStepObserver error`);\n      const wasPartialAccount = withErrorHandling(() => {\n        return document.documentElement.classList.contains(LOGIN_SIDEBAR_STEP_CLASS_PARTIAL_ACCOUNT);\n      }, `${logInfo} wasPartialAccount error`);\n      const emitLoginSidebarCloseMetrics = withErrorHandling(() => {\n        sendOptimizelyEvent(LOGIN_SIDEBAR_PANEL_CLOSE_EVENT);\n        if (isLoginSidebarStep1()) {\n          sendOptimizelyEvent(LOGIN_SIDEBAR_PANEL_STEP_1_CLOSE_EVENT);\n        } else if (isLoginSidebarExistingAccountStep()) {\n          sendOptimizelyEvent(LOGIN_SIDEBAR_PANEL_STEP_2_CLOSE_EXISTING_ACCOUNT_EVENT);\n        } else if (isLoginSidebarNewAccountStep()) {\n          sendOptimizelyEvent(LOGIN_SIDEBAR_PANEL_STEP_2_CLOSE_NEW_ACCOUNT_EVENT);\n        } else if (isLoginSidebarPartialAccountStep()) {\n          sendOptimizelyEvent(LOGIN_SIDEBAR_PANEL_STEP_2_CLOSE_PARTIAL_ACCOUNT_EVENT);\n        }\n      }, `${logInfo} emitLoginSidebarCloseMetrics error`);\n      const buildLoginSidebarCloseResolve = withErrorHandling((excludeDialogWindow) => {\n        return withErrorHandling((e) => {\n          if (!isLoginDrawerOpen()) {\n            return null;\n          }\n          if (excludeDialogWindow) {\n            const target = e.target;\n            if (target && target.closest && target.closest(LOGIN_DRAWER_WINDOW_SELECTOR)) {\n              return null;\n            }\n          }\n          return {\n            eventName: LOGIN_SIDEBAR_PANEL_CLOSE_EVENT,\n            sendMetric: emitLoginSidebarCloseMetrics\n          };\n        }, `${logInfo} loginSidebarCloseResolve error`);\n      }, `${logInfo} buildLoginSidebarCloseResolve error`);\n      const teardownMetrics = withErrorHandling(() => {\n        if (metrics) {\n          metrics.cleanup();\n          metrics = null;\n        }\n      }, `${logInfo} teardownMetrics error`);\n      const setupMetrics = withErrorHandling(() => {\n        teardownMetrics();\n        sendOptimizelyEvent = createSendOptimizelyEvent_default(debugMode);\n        metrics = createWebMetricsHandler_default(\n          [\n            {\n              type: \"click\",\n              selector: LOGIN_DRAWER_CLOSE_BUTTON_SELECTOR,\n              resolve: buildLoginSidebarCloseResolve(false)\n            },\n            {\n              type: \"click\",\n              selector: LOGIN_DRAWER_PANEL_SELECTOR,\n              resolve: buildLoginSidebarCloseResolve(true)\n            }\n          ],\n          { debugMode, logInfo }\n        );\n        metrics.init();\n      }, `${logInfo} setupMetrics error`);\n      const openLoginDrawer = withErrorHandling(() => {\n        if (_window[`${testId}_loginDrawerAutoOpenStarted`]) {\n          return;\n        }\n        _window[`${testId}_loginDrawerAutoOpenStarted`] = true;\n        if (isLoginDrawerOpen()) {\n          return;\n        }\n        let clickAttempts = 0;\n        let lastClickAt = 0;\n        let clickInterval = null;\n        let drawerObserver = null;\n        const stopOpeningDrawer = withErrorHandling(() => {\n          if (clickInterval) {\n            clearInterval(clickInterval);\n            clickInterval = null;\n          }\n          if (drawerObserver) {\n            drawerObserver.disconnect();\n            drawerObserver = null;\n          }\n        }, `${logInfo} stopOpeningDrawer error`);\n        const clickLoginLink = withErrorHandling(() => {\n          const loginLink = document.querySelector(LOGIN_LINK_SELECTOR);\n          if (loginLink) {\n            loginLink.click();\n          }\n        }, `${logInfo} clickLoginLink error`);\n        const onDrawerMutation = withErrorHandling(() => {\n          if (isLoginDrawerOpen()) {\n            stopOpeningDrawer();\n            if (debugMode) {\n              console.log(logInfo, \"Login drawer opened\");\n            }\n          }\n        }, `${logInfo} onDrawerMutation error`);\n        const tryOpenLoginDrawer = withErrorHandling(() => {\n          if (isLoginDrawerOpen()) {\n            stopOpeningDrawer();\n            if (debugMode) {\n              console.log(logInfo, \"Login drawer opened\");\n            }\n            return;\n          }\n          const now = Date.now();\n          if (now - lastClickAt < LOGIN_DRAWER_CLICK_COOLDOWN_MS) {\n            return;\n          }\n          if (++clickAttempts > LOGIN_DRAWER_OPEN_MAX_ATTEMPTS) {\n            stopOpeningDrawer();\n            if (debugMode) {\n              console.warn(logInfo, \"Stopped trying to open login drawer after max attempts\");\n            }\n            return;\n          }\n          lastClickAt = now;\n          clickLoginLink();\n        }, `${logInfo} tryOpenLoginDrawer error`);\n        setTimeout(() => {\n          tryOpenLoginDrawer();\n          clickInterval = setInterval(tryOpenLoginDrawer, LOGIN_DRAWER_CLICK_COOLDOWN_MS);\n        }, LOGIN_DRAWER_INITIAL_DELAY_MS);\n        drawerObserver = new MutationObserver(onDrawerMutation);\n        drawerObserver.observe(document.documentElement, {\n          childList: true,\n          subtree: true,\n          attributes: true,\n          attributeFilter: [\"class\"]\n        });\n      }, `${logInfo} openLoginDrawer error`);\n      _window[testId] = {\n        openLoginDrawer,\n        init: withErrorHandling((_variation, _debugMode) => {\n          teardownMetrics();\n          variation = _variation;\n          debugMode = _debugMode;\n          waitForElement_default(\"body\").then(\n            withErrorHandling(() => {\n              setupMetrics();\n              installLoginSidebarStepObserver();\n              if (variation === 0) {\n                openLoginDrawer();\n              }\n            }, `${logInfo} waitForElement body error`)\n          );\n        }, \"HC-113.1 shared init error\"),\n        wasPartialAccount\n      };\n    }, \"HC-113.1 shared error\")();\n  })();\n})();\n}, \"dependencies\": []}, {\"id\": \"28D5D903-10A3-4409-AFBA-F8DB55EED97B\", \"type\": \"append\", \"selector\": \"head\", \"value\": \"<style>.HC-113-1_shared header a.b-header_