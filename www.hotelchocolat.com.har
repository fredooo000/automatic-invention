nt').show();\n    } else {\n      $('.toggle').removeClass('expanded');\n      $('.toggle').next('ul, .toggle-content').hide();\n    }\n    // Global tabs/accordions\n    lcgResponsive.move(util.viewport.isMobile(), '.global-tabs-move', '.tab-target-mobile', '.tab-target-desktop');\n    //do not apply this for pdp\n    if (window.pageContext && window.pageContext.ns !== 'product') {\n      lcgResponsive.tabAccordMobile(util.viewport.isMobile());\n    }\n  }\n  fireReadyResize();\n  $(window).smartresize(fireReadyResize);\n\n  // Fix uk postcode validation errors after PCA auto-complete\n  // Convert postcode field value to upper case\n  $(document).on('input', 'input.postcode', function () {\n    var val = $(this).val();\n    if (val) {\n      $(this).val(val.toUpperCase());\n    }\n  });\n  manageMobileOnlyCarousel();\n  $(window).on('resize', manageMobileOnlyCarousel);\n  $('.js-accordion').accordion({\n    heightStyle: 'content',\n    active: false,\n    collapsible: true,\n    icons: {\n      header: 'iconClosed',\n      activeHeader: 'iconOpen'\n    },\n    animate: 300\n  });\n  openPromotionDialog();\n  $('.password-show-button').on('click', function () {\n    $(this).toggleClass('password-shown');\n    var password = $('input[name*=_password');\n    password.attr('type', password.attr('type') === 'password' ? 'text' : 'password');\n  });\n  $('body').on('click', '.summary-title .expand-btn, .summary-title .collapse-btn', function () {\n    $(this).addClass('hidden');\n    $(this).siblings('.expand-btn, .collapse-btn').removeClass('hidden');\n    $(this).closest('.summary-title').next().toggle();\n  });\n  initSliderWithProgressBar();\n  manageMobileExpandableText();\n  $(window).on('resize', manageMobileExpandableText);\n}\n\n/**\n * Main handler for toggles where heading changes its color and background color\n */\nfunction handleToggleElements() {\n  $('.toggle-title').on('click', function (e) {\n    $(this).toggleClass('on').next('.toggleContent').toggleClass('show');\n    e.preventDefault();\n  });\n  $('.toggle.expanded').closest('li').addClass('active');\n  $('.toggle').click(function () {\n    $(this).toggleClass('expanded').next('ul, .toggle-content').toggle();\n    $(this).closest('li').toggleClass('active', $(this).hasClass('expanded'));\n  });\n}\n\n/**\n * Handler for footer menu on mobile devices\n */\nfunction manageFooterMenu() {\n  $('footer .line2 ul.footerMenu li > a').on('click', function (e) {\n    if (util.viewport.isMobile()) {\n      if ($(this).siblings('ul').length && !$(this).parent().hasClass('active')) {\n        e.preventDefault();\n        $(this).parent().addClass('active');\n      }\n    }\n  });\n  $('footer .line2 ul.footerMenu li > span').on('click', function () {\n    if (util.viewport.isMobile()) {\n      $(this).parent().toggleClass('active');\n    }\n  });\n}\n\n/**\n * Focus event handler for footer signup form\n */\nfunction handleFooterSignupFocus() {\n  $('.input-text.email').focus(function () {\n    $(this).parents('.footer-signup').addClass('focus');\n  }).blur(function () {\n    $(this).parents('.footer-signup').removeClass('focus');\n  });\n}\n\n/*\n * @descr show/hide search form on hover or touchstart.\n * Any opened dropdowns with .hover class get closed, once search form get activated.\n *\n * If either opened search form or search icon looses the focus, search form get closed on desktop devices.\n * If search form is opened and search icon is touched again or any area outside the form is touched,\n * search for is closed @see dropDownUILayer.\n */\nfunction initSearchDisplayBehavior() {\n  var $searchIcon = $('.mobile-search-icon'),\n    $searchIconContainer = $('.search-toggler'),\n    $headerSearch = $('#header-search'),\n    isSearchFormInFocus = false;\n  $searchIcon.on('touchstart mouseenter', function (e) {\n    e.preventDefault();\n    if ($searchIconContainer.hasClass('hover') && e.type === 'touchstart') {\n      $('body').find('.hover').removeClass('hover');\n      $('.uiLayerIndicator').remove();\n      return;\n    }\n    $headerSearch.addClass('hover');\n    $searchIconContainer.addClass('hover');\n    util.renderClosePadForTouch();\n  }).on('mouseleave', function () {\n    setTimeout(function () {\n      if (!isSearchFormInFocus) {\n        $('body').find('.hover').removeClass('hover');\n        $('.uiLayerIndicator').remove();\n      }\n    }, 1000);\n  });\n  $headerSearch.on('touchstart mouseenter', function () {\n    isSearchFormInFocus = true;\n  }).on('mouseleave', function () {\n    isSearchFormInFocus = false;\n    $('body').find('.hover').removeClass('hover');\n    $('.uiLayerIndicator').remove();\n  });\n}\n\n/*\n * Define properties and use slick to initialise content carousels\n * handle number of items in carousel based on container width\n */\nfunction initContentCarousels() {\n  $('.content-tiles-slider-container').each(function () {\n    var itemMinWidth = 210,\n      itemsToShowLength = util.getNumberOfItemsInCarousel($(this), itemMinWidth);\n    $(this).find('.content-tiles-slider').slick(util.contentSliderConfig(itemsToShowLength));\n  });\n\n  // this event specific to some pages and carousels\n  einstein.onEinstainContentAdded('.content-tiles-slider-container-deferred', function () {\n    $('.content-tiles-slider-container-deferred:not(.carousel-inited)').each(function () {\n      $(this).parents('einstain-inited').addClass('einstain-clear');\n      $(this).addClass('carousel-inited');\n      var itemMinWidth = $(this).hasClass('content-tiles-small') ? 109 : 210,\n        itemsToShowLength = util.getNumberOfItemsInCarousel($(this), itemMinWidth);\n      $(this).find('.content-tiles-slider:not(.slick-initialized)').slick(util.contentSliderConfig(itemsToShowLength));\n    });\n  });\n  $(window).smartresize(function () {\n    $('.content-tiles-slider-container, .content-tiles-slider-container-deferred').each(function () {\n      var carousel = $(this).find('.content-tiles-slider'),\n        itemMinWidth = carousel.parent().hasClass('content-tiles-small') ? 109 : 210,\n        itemsToShowLength = util.getNumberOfItemsInCarousel($(this), itemMinWidth),\n        prevItemsToShowLength;\n      if (prevItemsToShowLength !== itemsToShowLength) {\n        carousel.slick('slickSetOption', 'slidesToShow', itemsToShowLength, true);\n        prevItemsToShowLength = itemsToShowLength;\n      }\n    });\n  });\n}\n\n/*\n * Start quick view from content assets / slots\n * Avoid multiple event listeners on quickview buttons\n */\nfunction initQuickViewFromContent() {\n  $(document).off('click.globalquickview');\n  $(document).on('click.globalquickview', '[data-quick-view-url]', function (e) {\n    if (!util.viewport.isMobile()) {\n      quickview.show({\n        dialogClass: 'quickview-dialog',\n        source: 'quickview',\n        url: $(this).data('quickViewUrl')\n      });\n      e.preventDefault();\n    }\n  });\n}\n\n/*\n * Handle showing/hiding account navigation in header\n */\nfunction handleAccountNavDisplay() {\n  $('.myaccount-toggle').on('click touchstart', function (e) {\n    e.preventDefault();\n    $(this).toggleClass('active');\n    $(this).next('.ac-nav-ul').toggleClass('active');\n  });\n  if (util.viewport.isMobile()) {\n    $('.myaccount-toggle').filter('.my-account').removeClass('active').next('.ac-nav-ul').removeClass('active');\n  }\n}\n\n/*\n* @descr show/hide dropdowns on hover or touchstart event, that is based on\n* window interface capacity.\n*\n* Handler applies to all dropdowns that implements the basic markup structure with\n* main container having class attribute set to 'hover-drop-down'.\n*\n* All opened dropdowns get closed once another drop down get activated.\n* If dropdown's show/hide link is touched while dropdown itself remains active,\n* given dropdown get closed (applies to touch devices).\n*\n* On desktop devices, if dropdown looses the focus, it get closed. That\n* eliminates possibility of having more than one dropdown opened.\n*