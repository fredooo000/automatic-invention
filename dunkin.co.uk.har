ATTRIBUTE_RULES[attrName] = ruleName || attrName;\n        hyva.formValidation.setInputTypeRuleName = (typeName, ruleName) => INPUT_TYPE_RULES[typeName] = ruleName || typeName;\n        hyva.formValidation.addRule = (name, validator) => formValidationRules[name] = validator;\n    }(window.hyva = window.hyva || {}));\n</script>\n\n\n<script defer>\n    'use strict';\n    window.onload = function WindowLoad(event) {\n        hyva.formValidation.addRule('password', function(value, options, field, context) {\n            let counter = 0;\n            const passwordMinLength = '8';\n            const passwordMinCharacterSets = '3';\n            const result = value.length >= passwordMinLength;\n\n            if (result === false) {\n                const errorMessage = 'Minimum\\u0020length\\u0020of\\u0020this\\u0020field\\u0020must\\u0020be\\u0020equal\\u0020or\\u0020greater\\u0020than\\u0020\\u00251\\u0020symbols.\\u0020Leading\\u0020and\\u0020trailing\\u0020spaces\\u0020will\\u0020be\\u0020ignored.';\n                return errorMessage.replace('%1', passwordMinLength)\n            }\n\n            if (value.match(/\\d+/)) {\n                counter++;\n            }\n\n            if (value.match(/[a-z]+/)) {\n                counter++;\n            }\n\n            if (value.match(/[A-Z]+/)) {\n                counter++;\n            }\n\n            if (value.match(/[^a-zA-Z0-9]+/)) {\n                counter++;\n            }\n\n            if (counter < passwordMinCharacterSets) {\n                const errorMessage = 'Minimum\\u0020of\\u0020different\\u0020classes\\u0020of\\u0020characters\\u0020in\\u0020password\\u0020is\\u0020\\u00251.\\u0020Classes\\u0020of\\u0020characters\\u003A\\u0020Lower\\u0020Case,\\u0020Upper\\u0020Case,\\u0020Digits,\\u0020Special\\u0020Characters.';\n                return errorMessage.replace('%1', passwordMinCharacterSets)\n            }\n\n            return true;\n        });\n        hyva.formValidation.addRule('number', function(value, options, field, context) {\n            return value === '' || /^\\d+$/.test(value) ? true : 'Only\\u0020numbers\\u0020allowed.';\n        });\n        hyva.formValidation.addRule('phone-number', function(value, options, field, context) {\n            return value === '' || /^(\\+\\d{1,3}[- ]?)?\\d+$/.test(value) ? true : 'Please\\u0020specify\\u0020a\\u0020valid\\u0020phone\\u0020number.';\n        });\n        hyva.formValidation.addRule('password-match', function(value, options, field, context) {\n            const passwordField = context.fields['password'].element;\n            if (value !== passwordField.value) {\n                return 'Your\\u0020password\\u0020confirmation\\u0020must\\u0020match\\u0020your\\u0020password.';\n            }\n            return true;\n        });\n        hyva.formValidation.addRule('approve-tos', function(value, options, field, context) {\n            const checkbox = context.fields['tos'].element;\n            if (!checkbox.checked) {\n                return 'You\\u0020must\\u0020agree\\u0020to\\u0020Terms\\u0020and\\u0020Conditions';\n            }\n            return true;\n        });\n    }\n</script>\n<div class=\"page-wrapper\"><header class=\"page-header\"><a class=\"action skip sr-only focus:not-sr-only focus:absolute focus:z-40 focus:bg-white\n   contentarea\"\n   href=\"#contentarea\">\n    <span>\n        Skip to Content    </span>\n</a>\n<script>\n    function initHeader() {\n        return {\n            searchOpen: false,\n            cart: {},\n            getData(data) {\n                if (data.cart) {\n                    this.cart = data.cart\n                }\n            }\n        }\n    }\n</script>\n<div id=\"header\"\n    class=\"relative z-30 w-full bg-white border-b-4 border-split\"\n    x-data=\"initHeader()\"\n    @keydown.window.escape=\"searchOpen = false;\"\n    @private-content-loaded.window=\"getData(event.detail.data)\">\n    <div class=\"header-container 2xl:container flex flex-wrap items-center w-full leading-none pb-5.5 2xl:py-8 mx-auto mt-0\">\n        <!--Logo-->\n        <div class=\"order-1 pl-5.5 lg:pl-8 2xl:pl-0\">\n    <a\n       href=\"https://dunkin.co.uk/\"\n       class=\"flex items-start justify-start text-xl font-medium tracking-wide no-underline hover:no-underline h-5 lg:h-8\n        pointer-events-none\"\n       title=\"\"\n       aria-label=\"store logo\">\n        <img class=\"w-auto h-full min-w-fit object-contain object-left\"\n             src=\"https://dunkin.co.uk/media/logo/default/logo_dunkin-donuts.svg\"\n             title=\"\"\n             alt=\"\"\n             loading=\"lazy\"\n            width=\"165\"            height=\"32\"        />\n            </a>\n</div>\n\n        <!--Assigned Address-->\n        <script>\n    function headerAddressInit() {\n        return {\n            ...hyva.modal(),\n            ...hyva.postcodeLookup('header_postcode'),\n            hasAddress: false,\n            county: null,\n            onLoaded(data) {\n                if (data.cart && data.cart.county) {\n                    this.hasAddress = true;\n                    this.county = data.cart.county;\n                }\n            }\n        }\n    }\n</script>\n<script src=\"https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js\"></script>\n<div class=\"header-address\" x-data=\"headerAddressInit()\"\n     @postcode-lookup-js-loaded.window=\"initPostCode()\"\n     @private-content-loaded.window=\"onLoaded($event.detail.data)\">\n    <template x-if=\"hasAddress\">\n        <div class=\"content-container\">\n            <i class=\"icon-location icon-lg text-orange hidden lg:block\"></i>\n            <div class=\"content\">\n                <div class=\"location\">\n                    <i class=\"icon-location text-orange block lg:hidden\"></i>\n                    <span>Delivery to <span x-text=\"county\"></span></span>\n                </div>\n                <button class=\"link\"\n                        onclick=\"jQuery('#popup_post').click();\" \n                >Change location</button>\n            </div>\n        </div>\n    </template>\n    <style type=\"text/css\">\n     [x-cloak],.hide {\n    display: none !important;\n   }\n\n</style>\n\n<div class=\"popup-address-search relative pointer-events-none\" x-data=\"{ 'showModal': false, timeout: null}\" @keydown.escape=\"showModal = false\"\n    x-on:mouseenter=\"\n    width = (window.innerWidth > 0) ? window.innerWidth : screen.width;\n    if (width > 640) {\n      open = true; clearTimeout(timeout)\n    }\n    \"\n    x-on:mouseleave=\"\n    width = (window.innerWidth > 0) ? window.innerWidth : screen.width;\n    if (width > 640) {\n     timeout = setTimeout(() => { open = false }, 100)\n    }\n    \"\n    @resize.window=\"\n    width = (window.innerWidth > 0) ? window.innerWidth : screen.width;\n    if (width > 640) {\n     open = false\n    }\n    \"\n                          @keydown.escape=\"showModal = false\"\n                        x-cloak>\n                        <button class=\"hide\" id=\"popup_post\" type=\"button\" @click=\"showModal = true\">Open Modal</button>\n                        <div\n                                class=\"fixed inset-0 bg-opacity-50 z-50 backdrop\"\n                                x-show=\"showModal\"\n                            >\n                                <!-- Modal inner -->\n                                <div\n                                    class=\"fixed flex justify-center text-left z-10 pop-up flex-col inset-x-0 bottom-0 pb-1\"\n                                    @click.away=\"showModal = false\"\n                                    x-transition:enter=\"motion-safe:ease-out duration-300\"\n                                    x-transition:enter-start=\"opacity-0 scale-90\"\n                                    x-transition:enter-end=\"opacity-100 scale-100\"\n                                >\n                                <div class=\"relative inline-block bg-white overflow-auto pop-up-dialog\">\n                                    <div class=\"flex items-start justify-between\">\n                                        <button type=\"button\" class=\"absolute text-orange icon-close icon-lg top-0 right-0 p-5 lg:p-6 hover:cursor-pointer lg:hover:text-blue-darker\" @click=\"showModal = false\">\n                                            <!-- <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\">\n                                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\" />\n                                            </svg> -->\n                                        </button>\n                                    </div>\n                                    <div class=\"pop-up-header text-sm border-b-2 pb-7 mb-7\">\n                                        <h4>Delivery Details</h4>\n                                        <div class=\"flex items-center\">\n                                            <i class=\"icon-delivery text-orange mr-4 font-bold lg:font-normal lg:text-lg lg:leading-6\"></i>\n                                            <span>Current Delivery Address <span class=\"text-pink font-medium\" x-text=\"county\"></span></span>\n                                        </div>\n                                    </div>\n                                    <div class=\"address-form pointer-events-auto\">\n                                        <form class=\"controls\" @submit.prevent=\"submit\">\n                                            <div class=\"primary-actions\">\n                                                <div class=\"input-container\">\n                                                    <input class=\"search-input form-input bg-cream border-cream\"\n                                                           name=\"header_postcode_search_input\"\n                                                           placeholder=\"Enter&#x20;Postcode\"\n                                                    />\n                                                    <div class=\"hidden\">\n                                                        <input name=\"header_postcode_street\" x-model=\"formData.street\"/>\n                                                        <input name=\"header_postcode_city\" x-model=\"formData.city\"/>\n                                                        <input name=\"header_postcode_postcode\" x-model=\"formData.postcode\"/>\n                                                        <input name=\"header_postcode_county\" x-model=\"formData.county\"/>\n                                                        <input name=\"header_postcode_country_id\" x-model=\"formData.country_id\"/>\n                                                    </div>\n                                                    <i class=\"icon-location icon-lg text-orange\"></i>\n                                                </div>\n                                                <button class=\"btn btn-primary\" id=\"header_postcode-address-search-btn\">\n                                                    Search                                                </button>\n                                            </div>\n                                            <div id=\"header_postcode_search_context\"></div>\n                                            <div id=\"header_postcode_select_container\" class=\"search-select-container\" style=\"display: none\">\n                                            </div>\n                                            <button class=\"btn btn-primary w-full mt-4 lg:mt-7\" :disabled=\"!formData.county\" type=\"submit\">\n                                                Change Location                                            </button>\n                                        </form>\n                                    </div>\n                                    <div class=\"msg-container bottom-[-10px] lg:bottom-[-20px]\"\n                                         x-show=\"!!msg\"\n                                         x-transition:enter=\"ease-out duration-300 transition-all\"\n                                         x-transition:enter-start=\"opacity-0 bottom-[-30px] lg:bottom-[-50px]\"\n                                         x-transition:enter-end=\"opacity-100 bottom-[-10px] lg:bottom-[-20px]\"\n                                         x-transition:leave=\"ease-out duration-300 transition-all\"\n                                         x-transition:leave-start=\"opacity-100 bottom-[-10px] lg:bottom-[-20px]\"\n                                         x-transition:leave-end=\"opacity-0 bottom-[-30px] lg:bottom-[-50px]\"\n                                    >\n                                        <div class=\"msg-icon\" :class=\"{\n                                            'success': isSuccess\n                                        }\">\n                                            <i :class=\"{\n                                                'icon-checkmark-ellipse': isSuccess,\n                                                'icon-info': !isSuccess\n                                                }\"></i>\n                                        </div>\n                                        <span x-text=\"msg\"></span>\n                                    </div>\n                                    <div class=\"loader\">\n                                        <template x-if=\"isLoading\">\n    <div class=\"absolute bg-white bg-opacity-60 z-10 h-full w-full flex items-center justify-center\">\n        <div class=\"flex items-center\">\n            <!-- loading icon -->\n            <svg class=\"animate-spin h-5 w-5 text-gray-600\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\"\n                 viewBox=\"0 0 24 24\">\n                <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                <path class=\"opacity-75\" fill=\"currentColor\"\n                      d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\">\n                </path>\n            </svg>\n            <!-- end loading icon -->\n        </div>\n    </div>\n</template>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n   \n</div>\n\n        <!--Main Navigation-->\n        <div x-data=\"initMenuMobile_6a1ec0cba7e27()\"\n     class=\"z-20 order-3 lg:order-2 navigation lg:hidden pr-5.5 lg:pr-0\"\n>\n    <!-- mobile -->\n    <div :class=\"{'h-full overflow-x-hidden overflow-y-auto fixed top-0 left-0 w-full bg-cream' : open}\"\n         @toggle-mobile-menu.window=\"toggleMobileMenu()\"\n         @keydown.window.escape=\"open=false\"\n         @load.window=\"setActiveMenu($el)\"\n    >\n        <div class=\"flex items-baseline justify-between menu-icon\" :class=\"{'container py-5': open}\">\n            <template x-if=\"open && !mobilePanelActiveName\">\n                <div class=\"py-1\">\n                    <div class=\"order-1 pl-5.5 lg:pl-8 2xl:pl-0\">\n    <a\n       href=\"https://dunkin.co.uk/\"\n       class=\"flex items-start justify-start text-xl font-medium tracking-wide no-underline hover:no-underline h-5 lg:h-8\n        pointer-events-none\"\n       title=\"\"\n       aria-label=\"store logo\">\n        <img class=\"w-auto h-full min-w-fit object-contain object-left\"\n             src=\"https://dunkin.co.uk/media/logo/default/logo_dunkin-donuts.svg\"\n             title=\"\"\n             alt=\"\"\n             loading=\"lazy\"\n            width=\"165\"            height=\"32\"        />\n            </a>\n</div>\n                </div>\n    