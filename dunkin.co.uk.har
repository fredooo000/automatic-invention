                                                            </div>\n                    </div>\n                            </div>\n                                        <div class=\"level-0\">\n                <span\n                    class=\"flex items-center transition-transform duration-150 ease-in-out transform leading-6\"\n                    :class=\"{\n                        '-translate-x-full' : mobilePanelActiveId,\n                        'translate-x-0' : !mobilePanelActiveId\n                    }\"\n                >\n                    <a class=\"header-link flex items-center w-full container py-4.75 border-b-2 cursor-pointer\n                        bg-cream border-brown-light level-0 \"\n                       href=\"/giftcards\"\n                       title=\"Gift&#x20;cards\">\n                        Gift cards                    </a>\n                </span>\n            </div> \n                        <div class=\"level-0\">\n                <span\n                    class=\"flex items-center transition-transform duration-150 ease-in-out transform leading-6\"\n                    :class=\"{\n                        '-translate-x-full' : mobilePanelActiveId,\n                        'translate-x-0' : !mobilePanelActiveId\n                    }\"\n                >\n                    <a class=\"header-link flex items-center w-full container py-4.75 border-b-2 cursor-pointer\n                        bg-cream border-brown-light level-0 \"\n                       href=\"/loyalty-app\"\n                       title=\"App\">\n                        App                    </a>\n                </span>\n            </div> \n                            </nav>\n    </div>\n</div>\n<script>\n    'use strict';\n\n    const initMenuMobile_6a1ec0cba7e27 = () => {\n        return {\n            mobilePanelActiveId: null,\n            mobilePanelActiveName: null,\n            mobilePanelActiveHidden: true,\n            open: false,\n            setActiveMenu(menuNode) {\n                Array.from(menuNode.querySelectorAll('a')).filter(link => {\n                    let currentLink = window.location.href.split('?')[0];\n                    if (currentLink.charAt(currentLink.length - 1) === '/') currentLink = currentLink.slice(0, -1);\n                    return link.href === currentLink;\n                }).map(item => {\n                    item.classList.add('active');\n                    item.classList.add('pointer-events-none');\n                });\n            },\n            toggleSubMenu (id = 0, name = null) {\n                this.mobilePanelActiveId = this.mobilePanelActiveId === id ? 0 : id;\n                this.mobilePanelActiveName = this.mobilePanelActiveName === name ? null : name;\n                this.mobilePanelActiveHidden = this.mobilePanelActiveId === !id;\n            },\n            toggleMobileMenu () {\n                this.open = !this.open\n                this.open ? document.body.classList.add('overflow-hidden') : document.body.classList.remove('overflow-hidden');\n            }\n        }\n    }\n</script>\n<div x-data=\"initMenuDesktop_6a1ec0cbabaa2()\"\n     class=\"z-20 order-2 sm:order-1 lg:order-2 navigation hidden lg:flex\"\n>\n    <!-- desktop -->\n    <div x-ref=\"nav-desktop\"\n         @load.window=\"setActiveMenu($el)\"\n         class=\"hidden lg:block lg:min-h-0 lg:px-4 2xl:px-8 lg:w-auto lg:pt-0\">\n        <nav\n            class=\"duration-150 ease-in-out flex justify-start\n            w-auto min-h-0 transition-display space-x-1 xl:space-x-6\"\n        >\n                            <div class=\"level-0\"\n                     @mouseenter=\"setHoverPanel('category-node-42')\"\n                     @mouseleave=\"setHoverPanel(0)\"\n                >\n                    <span class=\"flex items-center\">\n                        <span class=\"link header-link w-full py-3 px-1.5 2lg:px-2 text-sm 2lg:text-base leading-6 level-0\"\n                           x-ref=